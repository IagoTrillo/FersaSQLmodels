WITH 
SUBSIDIARY AS
(
    SELECT DISTINCT HASH(UPPER(DATAAREAID)) AS SUBSIDIARYID 
    FROM fersads.ds_InventTrans_FER 
    
    UNION ALL 
    
    SELECT DISTINCT HASH(UPPER(DATAAREAID)) AS SUBSIDIARYID 
    FROM fersads.ds_InventTrans_CHN_HIST
),

PARAMS AS 
(
    SELECT
        DATE '2026-04-30' AS CLOSINGDATE,
        'FINANCIAL_CLOSING' AS STOCK_SOURCE, -- valores posibles: 'FINANCIAL_CLOSING', 'INVENTSUM', 'INVENTSUM DAILY'
        'FINANCIAL' AS DATE_MODE -- valores: 'PHYSICAL' o 'FINANCIAL'
),

Currencies AS
(
    SELECT DISTINCT CURRENCY AS CURRENCY
    FROM fersaSS.ds_StockFinancialMonthClosing

    UNION

    SELECT DISTINCT CURRENCYCODE AS CURRENCY
    FROM fersaSSTest.InventSum_FACT_HIST

    UNION

    SELECT DISTINCT CURRENCYCODE AS CURRENCY
    FROM fersadv.InventSum_ALL
),

ExchangeRatesLatest AS 
(
    SELECT
        erda.FROMCURRENCYCODE,
        erda.TOCURRENCYCODE,
        erda.EXCHANGERATE,
        ROW_NUMBER() OVER (
            PARTITION BY erda.FROMCURRENCYCODE, erda.TOCURRENCYCODE
            ORDER BY erda.VALIDFROM DESC
        ) AS RN
    FROM fersadv.ExchangeRateDaily_ALL erda
    CROSS JOIN PARAMS P
    WHERE erda.VALIDFROM <= P.CLOSINGDATE
),

ExchangeRatesPairs AS 
(
    SELECT
        FROMCURRENCYCODE,
        TOCURRENCYCODE,
        EXCHANGERATE
    FROM ExchangeRatesLatest
    WHERE RN = 1

    UNION ALL

    SELECT
        TOCURRENCYCODE AS FROMCURRENCYCODE,
        FROMCURRENCYCODE AS TOCURRENCYCODE,
        1 / NULLIF(EXCHANGERATE, 0) AS EXCHANGERATE
    FROM ExchangeRatesLatest
    WHERE RN = 1
),

ExchangeRates AS 
(
    SELECT
        C.CURRENCY,

        COALESCE(
            MAX(CASE WHEN D_EUR.TOCURRENCYCODE = 'EUR' THEN D_EUR.EXCHANGERATE END),
            MAX(D_USD.EXCHANGERATE * USD_EUR.EXCHANGERATE)
        ) AS EXCHANGERATE_EUR,

        COALESCE(
            MAX(CASE WHEN D_USD.TOCURRENCYCODE = 'USD' THEN D_USD.EXCHANGERATE END),
            MAX(D_EUR.EXCHANGERATE * EUR_USD.EXCHANGERATE)
        ) AS EXCHANGERATE_USD

    FROM Currencies C

    LEFT JOIN ExchangeRatesPairs D_EUR
        ON D_EUR.FROMCURRENCYCODE = C.CURRENCY
        AND D_EUR.TOCURRENCYCODE = 'EUR'

    LEFT JOIN ExchangeRatesPairs D_USD
        ON D_USD.FROMCURRENCYCODE = C.CURRENCY
        AND D_USD.TOCURRENCYCODE = 'USD'

    LEFT JOIN ExchangeRatesPairs EUR_USD
        ON EUR_USD.FROMCURRENCYCODE = 'EUR'
        AND EUR_USD.TOCURRENCYCODE = 'USD'

    LEFT JOIN ExchangeRatesPairs USD_EUR
        ON USD_EUR.FROMCURRENCYCODE = 'USD'
        AND USD_EUR.TOCURRENCYCODE = 'EUR'

    GROUP BY
        C.CURRENCY
),

FinanceExRates AS
(
    SELECT 
        FROMCURRENCYCODE, 
        TOCURRENCYCODE, 
        AVG(EXCHANGERATE) AS FINEXCHANGERATE
    FROM fersaSS.ds_ExchangeRateFinancialMonthClosing erfmc
    CROSS JOIN PARAMS P
    WHERE erfmc.VALIDFROM <= P.CLOSINGDATE
      AND erfmc.VALIDTO >= P.CLOSINGDATE
      AND erfmc.TOCURRENCYCODE = 'EUR'
      AND erfmc.EXCHANGERATE IS NOT NULL
    GROUP BY 
        FROMCURRENCYCODE, 
        TOCURRENCYCODE
),

FinancialMonthClosingRef AS
(
    SELECT
        X.SUBSIDIARYID,
        X.ITEMID,
        X.CLOSINGDATE AS FMC_REF_CLOSINGDATE,
        X.CURRENCY AS FMC_REF_CURRENCY,

        X.UNITCOST_LOCAL AS UNITCOST_LOCAL_FMC_REF,
        X.UNITCOST_EUR_EXRATEVERT AS UNITCOST_EUR_EXRATEVERT_FMC_REF,
        X.UNITCOST_EUR_FINEXRATE AS UNITCOST_EUR_FINEXRATE_FMC_REF,
        X.UNITCOST_USD_EXRATEVERT AS UNITCOST_USD_EXRATEVERT_FMC_REF,

        ROW_NUMBER() OVER (
            PARTITION BY 
                X.SUBSIDIARYID,
                UPPER(TRIM(X.ITEMID))
            ORDER BY 
                X.CLOSINGDATE DESC
        ) AS RN

    FROM
    (
        SELECT
            S.SUBSIDIARYID,
            S.ITEMID,
            S.CLOSINGDATE,
            S.CURRENCY,

            SUM(S.QUANTITY) AS FMC_STOCKQTY,
            SUM(S.AMOUNT) AS FMC_AMOUNT_LOCAL,

            SUM(S.AMOUNT) / NULLIF(SUM(S.QUANTITY), 0) AS UNITCOST_LOCAL,

            CASE
                WHEN S.CURRENCY = 'EUR' 
                    THEN SUM(S.AMOUNT) / NULLIF(SUM(S.QUANTITY), 0)
                ELSE 
                    (SUM(S.AMOUNT) / NULLIF(SUM(S.QUANTITY), 0)) * MAX(ER.EXCHANGERATE_EUR)
            END AS UNITCOST_EUR_EXRATEVERT,

            CASE
                WHEN S.CURRENCY = 'EUR' 
                    THEN SUM(S.AMOUNT) / NULLIF(SUM(S.QUANTITY), 0)
                ELSE 
                    (SUM(S.AMOUNT) / NULLIF(SUM(S.QUANTITY), 0)) / NULLIF(MAX(FER.FINEXCHANGERATE), 0)
            END AS UNITCOST_EUR_FINEXRATE,

            CASE
                WHEN S.CURRENCY = 'USD' 
                    THEN SUM(S.AMOUNT) / NULLIF(SUM(S.QUANTITY), 0)
                ELSE 
                    (SUM(S.AMOUNT) / NULLIF(SUM(S.QUANTITY), 0)) * MAX(ER.EXCHANGERATE_USD)
            END AS UNITCOST_USD_EXRATEVERT

        FROM fersaSS.ds_StockFinancialMonthClosing S

        CROSS JOIN PARAMS P

        LEFT JOIN ExchangeRates ER
            ON ER.CURRENCY = S.CURRENCY

        LEFT JOIN FinanceExRates FER
            ON FER.FROMCURRENCYCODE = S.CURRENCY
            AND FER.TOCURRENCYCODE = 'EUR'

        WHERE S.QUANTITY > 0
          AND S.CLOSINGDATE <= P.CLOSINGDATE

        GROUP BY
            S.SUBSIDIARYID,
            S.ITEMID,
            S.CLOSINGDATE,
            S.CURRENCY
    ) X
),

StockBase AS 
(
    SELECT
        S.SUBSIDIARYID,
        S.INVENTLOCATIONID,
        S.ITEMID,
        S.QUANTITY AS STOCKQTY,

        S.CURRENCY AS CURRENCYCODE,

        NULL AS UNITCOST_LOCAL_INVSUM,
        NULL AS UNITCOST_EUR_INVSUMEXRATE_INVSUM,
        NULL AS UNITCOST_EUR_EXRATEVERT_INVSUM,
        NULL AS UNITCOST_EUR_FINEXRATE_INVSUM,
        NULL AS UNITCOST_USD_INVSUMEXRATE_INVSUM,
        NULL AS UNITCOST_USD_EXRATEVERT_INVSUM,

        S.CLOSINGDATE AS FMC_REF_CLOSINGDATE,
        S.CURRENCY AS FMC_REF_CURRENCY,

        S.AMOUNT / NULLIF(S.QUANTITY, 0) AS UNITCOST_LOCAL_FMC_REF,

        CASE
            WHEN S.CURRENCY = 'EUR' 
                THEN S.AMOUNT / NULLIF(S.QUANTITY, 0)
            ELSE 
                (S.AMOUNT / NULLIF(S.QUANTITY, 0)) * ER.EXCHANGERATE_EUR
        END AS UNITCOST_EUR_EXRATEVERT_FMC_REF,

        CASE
            WHEN S.CURRENCY = 'EUR' 
                THEN S.AMOUNT / NULLIF(S.QUANTITY, 0)
            ELSE 
                (S.AMOUNT / NULLIF(S.QUANTITY, 0)) / NULLIF(FER.FINEXCHANGERATE, 0)
        END AS UNITCOST_EUR_FINEXRATE_FMC_REF,

        CASE
            WHEN S.CURRENCY = 'USD' 
                THEN S.AMOUNT / NULLIF(S.QUANTITY, 0)
            ELSE 
                (S.AMOUNT / NULLIF(S.QUANTITY, 0)) * ER.EXCHANGERATE_USD
        END AS UNITCOST_USD_EXRATEVERT_FMC_REF

    FROM fersaSS.ds_StockFinancialMonthClosing S

    CROSS JOIN PARAMS P

    LEFT JOIN ExchangeRates ER
        ON ER.CURRENCY = S.CURRENCY

    LEFT JOIN FinanceExRates FER
        ON FER.FROMCURRENCYCODE = S.CURRENCY
        AND FER.TOCURRENCYCODE = 'EUR'

    WHERE P.STOCK_SOURCE = 'FINANCIAL_CLOSING'
      AND S.QUANTITY > 0
      AND S.CLOSINGDATE = P.CLOSINGDATE

    UNION ALL

    SELECT
        S.SUBSIDIARYID,
        S.INVENTLOCATIONID,
        S.ITEMID,
        COALESCE(S.PHYSICALINVENT, 0) + COALESCE(S.PICKED, 0) AS STOCKQTY

        S.CURRENCYCODE AS CURRENCYCODE,

        S.UNITCOST AS UNITCOST_LOCAL_INVSUM,

        S.UNITCOST * S.EXCHANGERATE_EUR AS UNITCOST_EUR_INVSUMEXRATE_INVSUM,

        CASE
            WHEN S.CURRENCYCODE = 'EUR' 
                THEN S.UNITCOST
            ELSE 
                S.UNITCOST * ER.EXCHANGERATE_EUR
        END AS UNITCOST_EUR_EXRATEVERT_INVSUM,

        CASE
            WHEN S.CURRENCYCODE = 'EUR' 
                THEN S.UNITCOST
            ELSE 
                S.UNITCOST / NULLIF(FER.FINEXCHANGERATE, 0)
        END AS UNITCOST_EUR_FINEXRATE_INVSUM,

        S.UNITCOST * S.EXCHANGERATE_USD AS UNITCOST_USD_INVSUMEXRATE_INVSUM,

        CASE
            WHEN S.CURRENCYCODE = 'USD' 
                THEN S.UNITCOST
            ELSE 
                S.UNITCOST * ER.EXCHANGERATE_USD
        END AS UNITCOST_USD_EXRATEVERT_INVSUM,

        FMC.FMC_REF_CLOSINGDATE,
        FMC.FMC_REF_CURRENCY,

        FMC.UNITCOST_LOCAL_FMC_REF,
        FMC.UNITCOST_EUR_EXRATEVERT_FMC_REF,
        FMC.UNITCOST_EUR_FINEXRATE_FMC_REF,
        FMC.UNITCOST_USD_EXRATEVERT_FMC_REF

    FROM fersaSSTest.InventSum_FACT_HIST S

    LEFT JOIN ExchangeRates ER
        ON ER.CURRENCY = S.CURRENCYCODE

    LEFT JOIN FinanceExRates FER
        ON FER.FROMCURRENCYCODE = S.CURRENCYCODE
        AND FER.TOCURRENCYCODE = 'EUR'

    LEFT JOIN FinancialMonthClosingRef FMC
        ON FMC.SUBSIDIARYID = S.SUBSIDIARYID
        AND UPPER(TRIM(FMC.ITEMID)) = UPPER(TRIM(S.ITEMID))
        AND FMC.RN = 1

    CROSS JOIN PARAMS P

    WHERE P.STOCK_SOURCE = 'INVENTSUM'
      AND S.UPDATEDATE = P.CLOSINGDATE
      AND S.PHYSICALINVENT > 0

    UNION ALL

    SELECT
        S.SUBSIDIARYID,
        S.INVENTLOCATIONID,
        S.ITEMID,
        COALESCE(S.PHYSICALINVENT, 0) + COALESCE(S.PICKED, 0) AS STOCKQTY

        S.CURRENCYCODE AS CURRENCYCODE,

        S.UNITCOST AS UNITCOST_LOCAL_INVSUM,

        S.UNITCOST * S.EXCHANGERATE_EUR AS UNITCOST_EUR_INVSUMEXRATE_INVSUM,

        CASE
            WHEN S.CURRENCYCODE = 'EUR' 
                THEN S.UNITCOST
            ELSE 
                S.UNITCOST * ER.EXCHANGERATE_EUR
        END AS UNITCOST_EUR_EXRATEVERT_INVSUM,

        CASE
            WHEN S.CURRENCYCODE = 'EUR' 
                THEN S.UNITCOST
            ELSE 
                S.UNITCOST / NULLIF(FER.FINEXCHANGERATE, 0)
        END AS UNITCOST_EUR_FINEXRATE_INVSUM,

        S.UNITCOST * S.EXCHANGERATE_USD AS UNITCOST_USD_INVSUMEXRATE_INVSUM,

        CASE
            WHEN S.CURRENCYCODE = 'USD' 
                THEN S.UNITCOST
            ELSE 
                S.UNITCOST * ER.EXCHANGERATE_USD
        END AS UNITCOST_USD_EXRATEVERT_INVSUM,

        FMC.FMC_REF_CLOSINGDATE,
        FMC.FMC_REF_CURRENCY,

        FMC.UNITCOST_LOCAL_FMC_REF,
        FMC.UNITCOST_EUR_EXRATEVERT_FMC_REF,
        FMC.UNITCOST_EUR_FINEXRATE_FMC_REF,
        FMC.UNITCOST_USD_EXRATEVERT_FMC_REF

    FROM fersadv.InventSum_ALL S

    LEFT JOIN ExchangeRates ER
        ON ER.CURRENCY = S.CURRENCYCODE

    LEFT JOIN FinanceExRates FER
        ON FER.FROMCURRENCYCODE = S.CURRENCYCODE
        AND FER.TOCURRENCYCODE = 'EUR'

    LEFT JOIN FinancialMonthClosingRef FMC
        ON FMC.SUBSIDIARYID = S.SUBSIDIARYID
        AND UPPER(TRIM(FMC.ITEMID)) = UPPER(TRIM(S.ITEMID))
        AND FMC.RN = 1

    CROSS JOIN PARAMS P

    WHERE P.STOCK_SOURCE = 'INVENTSUM DAILY'
      AND S.PHYSICALINVENT > 0
),

StockFinal AS
(
    SELECT
        SB.*,

        SB.STOCKQTY * SB.UNITCOST_LOCAL_INVSUM AS AMOUNT_LOCAL_INVSUM,
        SB.STOCKQTY * SB.UNITCOST_EUR_INVSUMEXRATE_INVSUM AS AMOUNT_EUR_INVSUMEXRATE_INVSUM,
        SB.STOCKQTY * SB.UNITCOST_EUR_EXRATEVERT_INVSUM AS AMOUNT_EUR_EXRATEVERT_INVSUM,
        SB.STOCKQTY * SB.UNITCOST_EUR_FINEXRATE_INVSUM AS AMOUNT_EUR_FINEXRATE_INVSUM,
        SB.STOCKQTY * SB.UNITCOST_USD_INVSUMEXRATE_INVSUM AS AMOUNT_USD_INVSUMEXRATE_INVSUM,
        SB.STOCKQTY * SB.UNITCOST_USD_EXRATEVERT_INVSUM AS AMOUNT_USD_EXRATEVERT_INVSUM,

        SB.STOCKQTY * SB.UNITCOST_LOCAL_FMC_REF AS AMOUNT_LOCAL_FMC_REF,
        SB.STOCKQTY * SB.UNITCOST_EUR_EXRATEVERT_FMC_REF AS AMOUNT_EUR_EXRATEVERT_FMC_REF,
        SB.STOCKQTY * SB.UNITCOST_EUR_FINEXRATE_FMC_REF AS AMOUNT_EUR_FINEXRATE_FMC_REF,
        SB.STOCKQTY * SB.UNITCOST_USD_EXRATEVERT_FMC_REF AS AMOUNT_USD_EXRATEVERT_FMC_REF,

        COALESCE(SB.UNITCOST_LOCAL_INVSUM, SB.UNITCOST_LOCAL_FMC_REF) AS UNITCOST_LOCAL_INVSUM_FINAL,
        COALESCE(SB.UNITCOST_EUR_INVSUMEXRATE_INVSUM, SB.UNITCOST_EUR_EXRATEVERT_FMC_REF) AS UNITCOST_EUR_INVSUMEXRATE_INVSUM_FINAL,
        COALESCE(SB.UNITCOST_EUR_EXRATEVERT_INVSUM, SB.UNITCOST_EUR_EXRATEVERT_FMC_REF) AS UNITCOST_EUR_EXRATEVERT_INVSUM_FINAL,
        COALESCE(SB.UNITCOST_EUR_FINEXRATE_INVSUM, SB.UNITCOST_EUR_FINEXRATE_FMC_REF) AS UNITCOST_EUR_FINEXRATE_INVSUM_FINAL,
        COALESCE(SB.UNITCOST_USD_INVSUMEXRATE_INVSUM, SB.UNITCOST_USD_EXRATEVERT_FMC_REF) AS UNITCOST_USD_INVSUMEXRATE_INVSUM_FINAL,
        COALESCE(SB.UNITCOST_USD_EXRATEVERT_INVSUM, SB.UNITCOST_USD_EXRATEVERT_FMC_REF) AS UNITCOST_USD_EXRATEVERT_INVSUM_FINAL,

        COALESCE(SB.UNITCOST_LOCAL_FMC_REF, SB.UNITCOST_LOCAL_INVSUM) AS UNITCOST_LOCAL_FMC_FINAL,
        COALESCE(SB.UNITCOST_EUR_EXRATEVERT_FMC_REF, SB.UNITCOST_EUR_EXRATEVERT_INVSUM) AS UNITCOST_EUR_EXRATEVERT_FMC_FINAL,
        COALESCE(SB.UNITCOST_EUR_FINEXRATE_FMC_REF, SB.UNITCOST_EUR_FINEXRATE_INVSUM) AS UNITCOST_EUR_FINEXRATE_FMC_FINAL,
        COALESCE(SB.UNITCOST_USD_EXRATEVERT_FMC_REF, SB.UNITCOST_USD_EXRATEVERT_INVSUM) AS UNITCOST_USD_EXRATEVERT_FMC_FINAL,

        SB.STOCKQTY * COALESCE(SB.UNITCOST_LOCAL_INVSUM, SB.UNITCOST_LOCAL_FMC_REF) AS AMOUNT_LOCAL_INVSUM_FINAL,
        SB.STOCKQTY * COALESCE(SB.UNITCOST_EUR_INVSUMEXRATE_INVSUM, SB.UNITCOST_EUR_EXRATEVERT_FMC_REF) AS AMOUNT_EUR_INVSUMEXRATE_INVSUM_FINAL,
        SB.STOCKQTY * COALESCE(SB.UNITCOST_EUR_EXRATEVERT_INVSUM, SB.UNITCOST_EUR_EXRATEVERT_FMC_REF) AS AMOUNT_EUR_EXRATEVERT_INVSUM_FINAL,
        SB.STOCKQTY * COALESCE(SB.UNITCOST_EUR_FINEXRATE_INVSUM, SB.UNITCOST_EUR_FINEXRATE_FMC_REF) AS AMOUNT_EUR_FINEXRATE_INVSUM_FINAL,
        SB.STOCKQTY * COALESCE(SB.UNITCOST_USD_INVSUMEXRATE_INVSUM, SB.UNITCOST_USD_EXRATEVERT_FMC_REF) AS AMOUNT_USD_INVSUMEXRATE_INVSUM_FINAL,
        SB.STOCKQTY * COALESCE(SB.UNITCOST_USD_EXRATEVERT_INVSUM, SB.UNITCOST_USD_EXRATEVERT_FMC_REF) AS AMOUNT_USD_EXRATEVERT_INVSUM_FINAL,

        SB.STOCKQTY * COALESCE(SB.UNITCOST_LOCAL_FMC_REF, SB.UNITCOST_LOCAL_INVSUM) AS AMOUNT_LOCAL_FMC_FINAL,
        SB.STOCKQTY * COALESCE(SB.UNITCOST_EUR_EXRATEVERT_FMC_REF, SB.UNITCOST_EUR_EXRATEVERT_INVSUM) AS AMOUNT_EUR_EXRATEVERT_FMC_FINAL,
        SB.STOCKQTY * COALESCE(SB.UNITCOST_EUR_FINEXRATE_FMC_REF, SB.UNITCOST_EUR_FINEXRATE_INVSUM) AS AMOUNT_EUR_FINEXRATE_FMC_FINAL,
        SB.STOCKQTY * COALESCE(SB.UNITCOST_USD_EXRATEVERT_FMC_REF, SB.UNITCOST_USD_EXRATEVERT_INVSUM) AS AMOUNT_USD_EXRATEVERT_FMC_FINAL,

        CASE
            WHEN SB.UNITCOST_LOCAL_INVSUM IS NOT NULL THEN 'INVENTSUM'
            WHEN SB.UNITCOST_LOCAL_FMC_REF IS NOT NULL THEN 'FMC'
            ELSE 'NO_COST'
        END AS COST_SOURCE_INVSUM_FINAL,

        CASE
            WHEN SB.UNITCOST_LOCAL_FMC_REF IS NOT NULL THEN 'FMC'
            WHEN SB.UNITCOST_LOCAL_INVSUM IS NOT NULL THEN 'INVENTSUM'
            ELSE 'NO_COST'
        END AS COST_SOURCE_FMC_FINAL

    FROM StockBase SB
)

SELECT *
FROM StockFinal;