SELECT object_schema,
       object_name,
       object_type,
       grantee,
       privileges_description,
       owner,
       grantor
FROM v_catalog.grants
where (object_schema='fersaSS' or object_schema='fersaSSTest')
and not
	(grantee='usr_iago_trillo' and privileges_description = 'INSERT*, SELECT*, UPDATE*, DELETE*, ALTER*, REFERENCES*, DROP*, TRUNCATE*')
and not
	(grantee='usr_alejandro_villen' and privileges_description = 'INSERT, SELECT, UPDATE, DELETE, ALTER, TRUNCATE')
and not
	(grantee='usr_paula_carmona'and privileges_description = 'SELECT')
and not
	(grantee='usr_juan_lanero'and privileges_description = 'SELECT');




-- Para edicion
DO LANGUAGE PLvSQL $$
DECLARE
    v_schema VARCHAR;
    v_table  VARCHAR;
BEGIN
    FOR v_schema, v_table IN QUERY
        SELECT table_schema, table_name
        FROM v_catalog.tables
        WHERE table_schema = 'fersaSS'
          AND is_system_table = false
    LOOP
        PERFORM EXECUTE
            'GRANT SELECT, INSERT, UPDATE, DELETE, ALTER, TRUNCATE ' ||
            'ON TABLE ' ||
            QUOTE_IDENT(v_schema) || '.' || QUOTE_IDENT(v_table) ||
            ' TO usr_iago_trillo, usr_alejandro_villen, usr_paula_carmona ' ||
            'WITH GRANT OPTION';
    END LOOP;
END;
$$;

