WITH fr_agg AS (
    SELECT
        INVENTTRANSID,
        SUBSIDIARYID,

        SUM(ABS(QTY)) AS FR_QTY_ABS,

        MIN(DATEPHYSICAL) AS FIRST_DELIVERY_DATE,
        MAX(DATEPHYSICAL) AS LAST_DELIVERY_DATE,

        MIN(REQUESTEDDATE) AS REQUESTEDDATE,
        MIN(CONFIRMEDDATEEXTENDED) AS CONFIRMEDDATEEXTENDED,

        COUNT(*) AS FR_LINES

    FROM fersadv.SalesFillRateDays_ALL
    WHERE INVENTTRANSID IS NOT NULL
    GROUP BY
        INVENTTRANSID,
        SUBSIDIARYID
),

item_agg AS (
    SELECT
        SUBSIDIARYID,
        ITEMID,
        MAX(BRAND) AS BRAND
    FROM fersadv.Item_ALL
    GROUP BY
        SUBSIDIARYID,
        ITEMID
),

sales_base AS (
    SELECT
        inv.RECID,
        inv.INVOICEDATE,
        DATE_TRUNC('month', inv.INVOICEDATE) AS INVOICE_MONTH,

        inv.SUBSIDIARYID AS SALES_SUBSIDIARYID,
        inv.INVENTLOCATIONID,

        CASE
            WHEN inv.SUBSIDIARYID = 'PUSA' THEN 'NINGBO'
            WHEN inv.SUBSIDIARYID = 'FBEA' AND inv.INVENTLOCATIONID = 'NINGBO' THEN 'NINGBO'
            ELSE inv.SUBSIDIARYID
        END AS SUBSIDIARY_CORREG,

        inv.COMPANYID,
        inv.ITEMID,

        COALESCE(item.BRAND, 'NO BRAND') AS BRAND,

        inv.INVOICEQTY,
        inv.AMOUNT,
        inv.INVENTTRANSID,

        fr.FIRST_DELIVERY_DATE,
        fr.LAST_DELIVERY_DATE,
        fr.REQUESTEDDATE,
        fr.CONFIRMEDDATEEXTENDED,
        fr.FR_LINES,

        CASE
            WHEN inv.INVENTTRANSID IS NULL THEN 'NO_INVENTTRANSID'
            WHEN fr.INVENTTRANSID IS NULL THEN 'NO_FILLRATE_DATES'
            ELSE 'HAS_FILLRATE_DATES'
        END AS FILLRATE_DATE_STATUS,

        CASE
            WHEN fr.LAST_DELIVERY_DATE IS NOT NULL
             AND fr.CONFIRMEDDATEEXTENDED IS NOT NULL
             AND DATE_TRUNC('month', fr.LAST_DELIVERY_DATE) <= DATE_TRUNC('month', fr.CONFIRMEDDATEEXTENDED)
            THEN 1 ELSE 0
        END AS OK_CONFIRMED,

        CASE
            WHEN fr.LAST_DELIVERY_DATE IS NOT NULL
             AND fr.REQUESTEDDATE IS NOT NULL
             AND DATE_TRUNC('month', fr.LAST_DELIVERY_DATE) <= DATE_TRUNC('month', fr.REQUESTEDDATE)
            THEN 1 ELSE 0
        END AS OK_REQUESTED

    FROM fersadv.SalesInvoices_ALL inv

    LEFT JOIN fersadv.Customer_ALL cust
        ON inv.INVOICEACCOUNT = cust.CUSTOMERID
       AND inv.SUBSIDIARYID = cust.SUBSIDIARYID

    LEFT JOIN fr_agg fr
        ON inv.INVENTTRANSID = fr.INVENTTRANSID
       AND inv.SUBSIDIARYID = fr.SUBSIDIARYID

    LEFT JOIN item_agg item
        ON inv.ITEMID = item.ITEMID
       AND inv.SUBSIDIARYID = item.SUBSIDIARYID

    WHERE inv.INVOICEDATE >= '2024-12-31'
      AND (
            cust.NAME ILIKE '%PFI%MX%'
         OR cust.NAME ILIKE '%PFI%MEX%'
         OR cust.NAME ILIKE '%pfi%m%x%'
      )
)

SELECT
    INVOICE_MONTH,
    SUBSIDIARY_CORREG,
    BRAND,

    COUNT(*) AS INVOICE_LINES,

    SUM(INVOICEQTY) AS SOLD_QTY,
    SUM(AMOUNT) AS SOLD_AMOUNT,

    SUM(CASE WHEN FILLRATE_DATE_STATUS = 'HAS_FILLRATE_DATES' THEN INVOICEQTY ELSE 0 END) AS QTY_WITH_FILLRATE_DATES,
    SUM(CASE WHEN FILLRATE_DATE_STATUS = 'HAS_FILLRATE_DATES' THEN AMOUNT ELSE 0 END) AS AMOUNT_WITH_FILLRATE_DATES,

    SUM(CASE WHEN OK_CONFIRMED = 1 THEN INVOICEQTY ELSE 0 END) AS QTY_OK_CONFIRMED,
    SUM(CASE WHEN OK_CONFIRMED = 1 THEN AMOUNT ELSE 0 END) AS AMOUNT_OK_CONFIRMED,

    SUM(CASE WHEN OK_REQUESTED = 1 THEN INVOICEQTY ELSE 0 END) AS QTY_OK_REQUESTED,
    SUM(CASE WHEN OK_REQUESTED = 1 THEN AMOUNT ELSE 0 END) AS AMOUNT_OK_REQUESTED,

    SUM(CASE WHEN FILLRATE_DATE_STATUS = 'NO_FILLRATE_DATES' THEN INVOICEQTY ELSE 0 END) AS QTY_WITHOUT_FILLRATE_DATES,
    SUM(CASE WHEN FILLRATE_DATE_STATUS = 'NO_FILLRATE_DATES' THEN AMOUNT ELSE 0 END) AS AMOUNT_WITHOUT_FILLRATE_DATES,

    SUM(CASE WHEN FILLRATE_DATE_STATUS = 'NO_INVENTTRANSID' THEN INVOICEQTY ELSE 0 END) AS QTY_WITHOUT_INVENTTRANSID,
    SUM(CASE WHEN FILLRATE_DATE_STATUS = 'NO_INVENTTRANSID' THEN AMOUNT ELSE 0 END) AS AMOUNT_WITHOUT_INVENTTRANSID

FROM sales_base
GROUP BY
    INVOICE_MONTH,
    SUBSIDIARY_CORREG,
    BRAND
ORDER BY
    INVOICE_MONTH,
    SUBSIDIARY_CORREG,
    BRAND;