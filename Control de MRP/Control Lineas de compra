WITH MAXIBO_OR AS 
(SELECT
	GROUPID,
	GROUPLEVEL,
	GROUPSUBSIDIARYID,
	--GROUPPARENT,
	PARENTITEMID,
	GROUPPARENTREQDATE,
    GROUPPARENTFUTURESDATE,
    --GROUPPARENTREFTYPE,
    GROUPREFTYPENAME,
    GROUPPARENTREFID,
    --GROUPPARENTCUSTOMERID,
    GROUPCUSTOMERID,
    GROUPPARENTQTY,
    (GROUPPARENTSALESUNITPRICE*GROUPPARENTSALESEXCHANGERATE_EUR) AS GROUPSALESPRICE_EUR,
    (GROUPPARENTINFERREDSALESUNITPRICE*GROUPPARENTINFERREDPRICEEXCHANGERATE_EUR) AS GROUPINFERREDSALESPRICE_EUR,
    (GROUPPARENTSTDUNITCOST*GROUPPARENTCOSTEXCHANGERATE_EUR) AS GROUPCOST_EUR,
    SUBSIDIARYID,
    INVENTLOCATIONID,
    INVENTSTYLEID,
    ITEMID,
    --REFTYPE,
    REFTYPENAME,
    REFID,
    SUPPLIERID,
    QTY,
    FUTURESDATE,
    REQDATE,
 	SUM(REALQTY) AS REALQTY,
	(STDUNITCOST*COSTEXCHANGERATE_EUR) AS COST_EUR
    --GROUPPURCHORDERFORMNUM varchar(80),
    --GROUPSLRECID int,
    --GROUPINVENTTRANSID varchar(80),
    --INVENTDIMID varchar(80),
    --INVENTTRANSORIGIN int,
    --INVENTTRANSID varchar(80),
    --RECID int,
    --FERSALESREFRECID int,
    --INTERCOMPANYINVENTTRANSID varchar(100),
    --PATH varchar(4058),
FROM FERSADW.MaxiBOTree_ALL_GLOBAL mbag 
GROUP BY
	GROUPID,
	GROUPLEVEL,	
	GROUPSUBSIDIARYID,
	PARENTITEMID,
	GROUPPARENTREQDATE,
    GROUPPARENTFUTURESDATE,
    GROUPREFTYPENAME,
    GROUPPARENTREFID,
    GROUPCUSTOMERID,
    GROUPPARENTQTY,
    (GROUPPARENTSALESUNITPRICE*GROUPPARENTSALESEXCHANGERATE_EUR),
    (GROUPPARENTINFERREDSALESUNITPRICE*GROUPPARENTINFERREDPRICEEXCHANGERATE_EUR),
    (GROUPPARENTSTDUNITCOST*GROUPPARENTCOSTEXCHANGERATE_EUR),
    SUBSIDIARYID,
    INVENTLOCATIONID,
    INVENTSTYLEID,
    ITEMID,
    REFTYPENAME,
    REFID,
    SUPPLIERID,
    QTY,
    FUTURESDATE,
    REQDATE,
 	(STDUNITCOST*COSTEXCHANGERATE_EUR)
),

PURCHLINES AS(
SELECT
SUBSIDIARYID,
INVENTLOCATIONID,
PURCHASEID,
ITEMID,
SUPPLIERID,
CREATEDBY,
MODIFIEDBY,
(UNITPRICE*EXCHANGERATE_EUR) AS PRICE_EUR,
SUM(PURCHASEQTY) AS PURCHASEQTY,
SUM(PENDINGQTY) AS PENDINGQTY,
CASE
       WHEN PA.DELIVERYDATE < DATE '1990-01-01' AND PA.CONFIRMEDDATE > DATE '1990-01-01' THEN PA.CONFIRMEDDATE
       WHEN PA.DELIVERYDATE IS NULL OR PA.DELIVERYDATE < DATE '1990-01-01' THEN PA.CREATEDDATETIME
       ELSE PA.DELIVERYDATE
END AS DELIVERYDATE,
CASE
       WHEN PA.REQUESTEDDATE < DATE '1990-01-01' AND PA.CONFIRMEDDATE > DATE '1990-01-01' THEN PA.CONFIRMEDDATE
       WHEN PA.REQUESTEDDATE < DATE '1990-01-01' AND PA.DELIVERYDATE > DATE '1990-01-01' THEN  PA.DELIVERYDATE
       WHEN PA.REQUESTEDDATE IS NULL OR PA.REQUESTEDDATE < DATE '1990-01-01' THEN PA.CREATEDDATETIME
       ELSE PA.REQUESTEDDATE
END AS REQUESTEDDATE,
CASE
       WHEN PA.CONFIRMEDDATE IS NULL THEN PA.CREATEDDATETIME
       WHEN PA.CONFIRMEDDATE < DATE '1990-01-01' THEN DATE '2050-01-01'
       ELSE PA.CONFIRMEDDATE
END AS CONFIRMEDDATE,
PA.CREATEDDATETIME AS CREATEDDATETIME
from fersadv.purchaselines_all pa
GROUP BY
       SUBSIDIARYID,
       INVENTLOCATIONID,
       PURCHASEID,
       ITEMID,
       SUPPLIERID,
       CREATEDBY,
       MODIFIEDBY,
	   (UNITPRICE*EXCHANGERATE_EUR),
       PA.DELIVERYDATE,
       PA.REQUESTEDDATE,
       PA.CONFIRMEDDATE,
       PA.CREATEDDATETIME
),


PL_KEYS AS (
    SELECT
        SUBSIDIARYID,
        INVENTLOCATIONID,
        PURCHASEID,
        ITEMID,
        SUM(PENDINGQTY) AS QTY,
        SUM(PRICE_EUR*PENDINGQTY) AS AMOUNT
    FROM PURCHLINES
    WHERE
    		PENDINGQTY>0
    		AND
    		(SUBSIDIARYID='FBEA'
    		OR SUBSIDIARYID='FUSA'
    		OR SUBSIDIARYID='FBRA'
    		OR SUBSIDIARYID='FJXN'
    		OR SUBSIDIARYID='PUSA')
    	GROUP BY
    		SUBSIDIARYID,
        INVENTLOCATIONID,
        PURCHASEID,
        ITEMID
),

MBO_KEYS AS (
    SELECT
        SUBSIDIARYID,
        INVENTLOCATIONID,
        REFID AS PURCHASEID,
        ITEMID,
        SUM(REALQTY) AS QTY,
        SUM(REALQTY*COST_EUR) AS AMOUNT
    FROM MAXIBO_OR
    WHERE REFTYPENAME = 'Purch'
    GROUP BY
    	    SUBSIDIARYID,
        INVENTLOCATIONID,
        REFID,
        ITEMID
),

RT_KEYS AS (
    SELECT
        SUBSIDIARYID,
        INVENTLOCATIONID,
        REFID AS PURCHASEID,
        ITEMID,
        SUM(QTY) AS QTY
    FROM fersadv.reqtrans_ALL RT
    WHERE REFTYPENAME = 'Purch'
    --AND PLANVERSION='5638414331'
    GROUP BY
    	    SUBSIDIARYID,
        INVENTLOCATIONID,
        REFID,
        ITEMID
),

BASE_COMPARE AS (
    SELECT
        CASE
            WHEN PL.PURCHASEID IS NULL THEN 'SOLO_EN_MAXIBO'
            WHEN MBO.PURCHASEID IS NULL AND RT.PURCHASEID IS NOT NULL THEN 'SOLO_EN_PURCHLINES_Y_EN_RT'
            WHEN MBO.PURCHASEID IS NULL AND RT.PURCHASEID IS NULL THEN 'SOLO_EN_PURCHLINES_Y_NO_EN_RT'
            ELSE 'EN_AMBAS'
        END AS ESTADO,
        COALESCE(PL.SUBSIDIARYID, MBO.SUBSIDIARYID) AS SUBSIDIARYID,
        COALESCE(PL.INVENTLOCATIONID, MBO.INVENTLOCATIONID) AS INVENTLOCATIONID,
        COALESCE(PL.PURCHASEID, MBO.PURCHASEID) AS PURCHASEID,
        COALESCE(PL.ITEMID, MBO.ITEMID) AS ITEMID,
        PL.QTY AS QTY_PL,
        PL.AMOUNT AS AMOUNT_PL,
        MBO.QTY AS QTY_MBO,
        MBO.AMOUNT AS AMOUNT_MBO,
        RT.QTY AS QTY_RT
    FROM PL_KEYS PL
    FULL OUTER JOIN MBO_KEYS MBO
        ON PL.SUBSIDIARYID = MBO.SUBSIDIARYID
       AND PL.INVENTLOCATIONID = MBO.INVENTLOCATIONID
       AND PL.PURCHASEID = MBO.PURCHASEID
       AND PL.ITEMID = MBO.ITEMID
    LEFT JOIN RT_KEYS RT
        ON PL.SUBSIDIARYID = RT.SUBSIDIARYID
       AND PL.INVENTLOCATIONID = RT.INVENTLOCATIONID
       AND PL.PURCHASEID = RT.PURCHASEID
       AND PL.ITEMID = RT.ITEMID
)

SELECT *
FROM BASE_COMPARE
WHERE ESTADO <> 'EN_AMBAS'
ORDER BY ESTADO, SUBSIDIARYID, INVENTLOCATIONID, PURCHASEID, ITEMID;