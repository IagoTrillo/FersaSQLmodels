CREATE  VIEW fersadw.RF_ROLLINGFORECAST_V2 EXCLUDE SCHEMA PRIVILEGES AS
WITH  RollingForecast AS (SELECT CRF.RollingLocationId, CRF.CustomerId, CRF.ItemId, CRF.Quantity, to_date((concat((CRF.Year)::varchar, to_char(CRF.Month, '09'::varchar(2))) || '01'::varchar(2)), 'YYYYMMDD'::varchar(8)) AS REQDATE, CRF.Year, CRF.Month, IA.CATALOG AS REFCATALOG, CA.LINEOFBUSINESS AS CUSTOMERGROUP, CF.FERECORESSTYLENAME AS STYLENAME FROM (((fersads.ds_CustomerRollingForecast_EDC CRF JOIN fersadv.Customer_ALL CA ON ((hash(upper(CRF.RollingLocationId), CRF.CustomerId) = hash(upper(CA.SUBSIDIARYID), CA.CUSTOMERID)))) JOIN fersads.ds_Customer_BYOD CF ON ((hash(CRF.CustomerId, upper(CRF.RollingLocationId)) = hash(CF.ACCOUNTNUM, upper(CF.DATAAREAID))))) JOIN fersadv.Item_ALL IA ON ((hash(CRF.ItemId, upper(CRF.RollingLocationId)) = hash(IA.ITEMID, upper(IA.SUBSIDIARYID))))) WHERE ((date_trunc('MONTH'::varchar(5), (now())::timestamptz(6)) <= to_date((concat((CRF.Year)::varchar, to_char(CRF.Month, '09'::varchar(2))) || '01'::varchar(2)), 'YYYYMMDD'::varchar(8))) AND (to_date((concat((CRF.Year)::varchar, to_char(CRF.Month, '09'::varchar(2))) || '01'::varchar(2)), 'YYYYMMDD'::varchar(8)) < date_trunc('MONTH'::varchar(5), add_months((now())::timestamptz(6), 12))))),  RollingWithBudget AS (SELECT RF.RollingLocationId, RF.CustomerId, RF.ItemId, RF.Quantity, RF.REQDATE, RF.REFCATALOG, RF.CUSTOMERGROUP, RF.STYLENAME, coalesce((CFY.CurrencyFactor * BG.UnitPrice), 0::numeric(18,0)) AS BUDGET_PRICE_EUR FROM ((fersads.ds_SalesBudgetDetails_EDC BG RIGHT  JOIN  RollingForecast RF ON ((hash(upper(RF.RollingLocationId), RF.CustomerId, RF.ItemId, RF.Year, RF.Month) = hash(upper(BG.LocationId), BG.CustomerId, BG.ItemId, BG.Year, BG.Month)))) LEFT  JOIN fersads.ds_CurrencyFactorYearly_EDC CFY ON ((hash(BG.Year, 'EUR'::varchar(3), BG.CurrencyCode) = hash(CFY.Year, CFY.CurrencyTo, CFY.CurrencyFrom))))),  RollingWithTariff AS (SELECT RF.RollingLocationId, RF.CustomerId, RF.ItemId, RF.Quantity, RF.REQDATE, RF.REFCATALOG, RF.CUSTOMERGROUP, RF.STYLENAME, RF.BUDGET_PRICE_EUR, CASE WHEN (SP.EXCHANGERATE_EUR IS NOT NULL) THEN coalesce((SP.EXCHANGERATE_EUR * SP.UNITPRICE), 0::numeric(18,0)) WHEN (ERD.EXCHANGERATE IS NOT NULL) THEN coalesce((ERD.EXCHANGERATE * SP.UNITPRICE), 0::numeric(18,0)) ELSE 0::numeric(18,0) END AS TARIFF_PRICE_EUR FROM ((fersadv.SalesPrices_ALL SP RIGHT  JOIN  RollingWithBudget RF ON ((hash(upper(RF.RollingLocationId), RF.CustomerId, RF.ItemId) = hash(upper(SP.SUBSIDIARYID), SP.CUSTOMERID, SP.ITEMID)))) LEFT  JOIN fersadv.ExchangeRateDaily_ALL ERD ON ((hash(date_trunc('DAY'::varchar(3), RF.REQDATE), date_trunc('DAY'::varchar(3), RF.REQDATE), SP.CURRENCYCODE, 'EUR'::varchar(3), 'FER'::varchar(3)) = hash(ERD.VALIDFROM, ERD.VALIDTO, ERD.FROMCURRENCYCODE, ERD.TOCURRENCYCODE, upper(ERD.ORIGIN))))) WHERE ((SP.FROMDATE <= RF.REQDATE) AND (RF.REQDATE <= SP.TODATE))),  SalesInvoices AS (SELECT SIA.SUBSIDIARYID, RF.CUSTOMERGROUP, RF.REFCATALOG, CASE WHEN (sum(SIA.INVOICEQTY) > 0::numeric(18,0)) THEN (sum((SIA.EXCHANGERATE_EUR * SIA.AMOUNT)) / sum(SIA.INVOICEQTY)) ELSE 0::numeric(18,0) END AS INVOICE_PRICE_EUR FROM (fersadv.SalesInvoices_ALL SIA JOIN  RollingWithTariff RF ON ((hash(upper(RF.RollingLocationId), RF.ItemId) = hash(upper(SIA.SUBSIDIARYID), SIA.ITEMID)))) GROUP BY SIA.SUBSIDIARYID, RF.CUSTOMERGROUP, RF.REFCATALOG),  RollingWithInvoice AS (SELECT RF.RollingLocationId, RF.CustomerId, RF.ItemId, RF.Quantity, RF.REQDATE, RF.REFCATALOG, RF.CUSTOMERGROUP, RF.STYLENAME, RF.BUDGET_PRICE_EUR, RF.TARIFF_PRICE_EUR, SI.INVOICE_PRICE_EUR FROM ( RollingWithTariff RF LEFT  JOIN  SalesInvoices SI ON ((hash(upper(RF.RollingLocationId), RF.CUSTOMERGROUP, RF.REFCATALOG) = hash(upper(SI.SUBSIDIARYID), SI.CUSTOMERGROUP, SI.REFCATALOG))))),  Final AS (SELECT RF.RollingLocationId, RF.CustomerId, RF.ItemId, RF.Quantity, RF.REQDATE, RF.REFCATALOG, RF.CUSTOMERGROUP, RF.STYLENAME, CASE WHEN (RF.BUDGET_PRICE_EUR <> 0::numeric(18,0)) THEN RF.BUDGET_PRICE_EUR WHEN ((RF.BUDGET_PRICE_EUR = 0::numeric(18,0)) AND (RF.TARIFF_PRICE_EUR <> 0::numeric(18,0))) THEN RF.TARIFF_PRICE_EUR WHEN ((RF.BUDGET_PRICE_EUR = 0::numeric(18,0)) AND (RF.TARIFF_PRICE_EUR = 0::numeric(18,0)) AND (RF.INVOICE_PRICE_EUR <> 0::numeric(18,0))) THEN RF.INVOICE_PRICE_EUR ELSE 0::numeric(18,0) END AS UNIT_PRICE_EUR FROM  RollingWithInvoice RF) SELECT Final.RollingLocationId, Final.CustomerId, Final.ItemId, Final.Quantity, Final.REQDATE, Final.REFCATALOG, Final.CUSTOMERGROUP, Final.STYLENAME, Final.UNIT_PRICE_EUR FROM  Final;

CREATE  VIEW fersadw.RF_SALESLINES EXCLUDE SCHEMA PRIVILEGES AS
WITH  Items AS ( SELECT "substring"(Item_ALL.CATALOG, 1, 3) AS FAM,
        Item_ALL.ITEMID,
        Item_ALL.SUBSIDIARYID
 FROM fersadv.Item_ALL),  Customers AS ( SELECT Customer_ALL.CUSTOMERID,
        Customer_ALL.NAME,
        Customer_ALL.SUBSIDIARYID,
        CASE WHEN (upper(Customer_ALL.CUSTOMERTYPE) = 'EXTERNAL'::varchar(8)) THEN 'THIRDS'::varchar(6) WHEN (upper(Customer_ALL.CUSTOMERTYPE) = 'INTERNAL'::varchar(8)) THEN 'INTERCO'::varchar(7) ELSE NULL END AS INTERCO
 FROM fersadv.Customer_ALL),  SalesLines AS ( SELECT SL.SUBSIDIARYID,
        SL.CUSTOMERID,
        CF.NAME,
        CF.INTERCO,
        SL.SALESID,
        SL.ITEMID,
        IA.FAM,
        CASE WHEN ((date_part('year'::varchar(4), SL.REQUESTEDDATE))::int > 2000) THEN SL.REQUESTEDDATE WHEN (((date_part('year'::varchar(4), SL.REQUESTEDDATE))::int < 2000) AND ((date_part('year'::varchar(4), SL.CONFIRMEDDATE))::int > 2000)) THEN SL.CONFIRMEDDATE WHEN (((date_part('year'::varchar(4), SL.REQUESTEDDATE))::int < 2000) AND ((date_part('year'::varchar(4), SL.CONFIRMEDDATE))::int < 2000) AND ((date_part('year'::varchar(4), SL.CONFIRMEDDATEEXTENDED))::int > 2000)) THEN SL.CONFIRMEDDATEEXTENDED ELSE NULL::timestamp END AS SHIPMENTDATE,
        SL.SALESQTY,
        SL.PENDINGQTY,
        SL.CURRENCYCODE,
        SL.AMOUNT,
        (SL.AMOUNT * SL.EXCHANGERATE_EUR) AS AMOUNT_EUR,
        (SL.AMOUNT * SL.EXCHANGERATE_USD) AS AMOUNT_USD,
        (((SL.AMOUNT / SL.SALESQTY) * SL.PENDINGQTY) * SL.EXCHANGERATE_EUR) AS AMOUNT_CORR
 FROM ((fersadv.SalesLines_ALL SL JOIN  Customers CF ON ((hash(SL.CUSTOMERID, upper(SL.SUBSIDIARYID)) = hash(CF.CUSTOMERID, upper(CF.SUBSIDIARYID))))) JOIN  Items IA ON ((hash(SL.ITEMID, upper(SL.SUBSIDIARYID)) = hash(IA.ITEMID, upper(IA.SUBSIDIARYID)))))
 WHERE ((((upper(SL.COMPANYID) = 'FER'::varchar(3)) AND (upper(SL.SUBSIDIARYID) = 'FBEA'::varchar(4))) AND (SL.PENDINGQTY > 0)) AND (SL.SALESQTY > 0)))
  SELECT SalesLines.SUBSIDIARYID,
        SalesLines.CUSTOMERID,
        SalesLines.NAME,
        SalesLines.INTERCO,
        SalesLines.SALESID,
        SalesLines.ITEMID,
        SalesLines.FAM,
        SalesLines.SHIPMENTDATE,
        SalesLines.SALESQTY,
        SalesLines.PENDINGQTY,
        SalesLines.CURRENCYCODE,
        SalesLines.AMOUNT,
        SalesLines.AMOUNT_EUR,
        SalesLines.AMOUNT_USD,
        SalesLines.AMOUNT_CORR
 FROM  SalesLines;

CREATE  VIEW fersadw.RF_SALESLINESFILTERED EXCLUDE SCHEMA PRIVILEGES AS
WITH  Rolling AS (SELECT RF_ROLLINGFORECAST_V2.RollingLocationId, RF_ROLLINGFORECAST_V2.CustomerId, RF_ROLLINGFORECAST_V2.ItemId, max(RF_ROLLINGFORECAST_V2.REQDATE) AS MAX FROM fersadw.RF_ROLLINGFORECAST_V2 GROUP BY RF_ROLLINGFORECAST_V2.RollingLocationId, RF_ROLLINGFORECAST_V2.CustomerId, RF_ROLLINGFORECAST_V2.ItemId),  SalesLines AS (SELECT SL.SUBSIDIARYID, SL.CUSTOMERID, SL.NAME, SL.INTERCO, SL.SALESID, SL.ITEMID, SL.FAM, CASE WHEN (SL.SHIPMENTDATE < date_trunc('MONTH'::varchar(5), now())) THEN last_day(add_months(now(), (-1))) WHEN (SL.SHIPMENTDATE >= add_months(date_trunc('MONTH'::varchar(5), now()), 12)) THEN last_day(add_months(now(), 11)) ELSE SL.SHIPMENTDATE END AS FINALDATE, SL.SALESQTY, SL.PENDINGQTY, SL.CURRENCYCODE, SL.AMOUNT, SL.AMOUNT_EUR, SL.AMOUNT_USD, SL.AMOUNT_CORR FROM (fersadw.RF_SALESLINES SL JOIN  Rolling RL ON ((hash(upper(SL.SUBSIDIARYID), SL.CUSTOMERID, SL.ITEMID) = hash(upper(RL.RollingLocationId), RL.CustomerId, RL.ItemId))))),  Final AS (SELECT SL.CUSTOMERID, SL.ITEMID, CASE WHEN ((((date_part('month'::varchar(5), SL.FINALDATE))::int - (date_part('month'::varchar(5), (now())::timestamp))::int) < 0) AND (((date_part('month'::varchar(5), SL.FINALDATE))::int - (date_part('month'::varchar(5), (now())::timestamp))::int) <> (-1))) THEN (((date_part('month'::varchar(5), SL.FINALDATE))::int - (date_part('month'::varchar(5), (now())::timestamp))::int) + 12) ELSE ((date_part('month'::varchar(5), SL.FINALDATE))::int - (date_part('month'::varchar(5), (now())::timestamp))::int) END AS MONTH_ID, sum(SL.PENDINGQTY) AS PENDINGQTY FROM  SalesLines SL GROUP BY SL.CUSTOMERID, SL.ITEMID, (date_part('month'::varchar(5), SL.FINALDATE))::int ORDER BY CASE WHEN ((((date_part('month'::varchar(5), SL.FINALDATE))::int - (date_part('month'::varchar(5), (now())::timestamp))::int) < 0) AND (((date_part('month'::varchar(5), SL.FINALDATE))::int - (date_part('month'::varchar(5), (now())::timestamp))::int) <> (-1))) THEN (((date_part('month'::varchar(5), SL.FINALDATE))::int - (date_part('month'::varchar(5), (now())::timestamp))::int) + 12) ELSE ((date_part('month'::varchar(5), SL.FINALDATE))::int - (date_part('month'::varchar(5), (now())::timestamp))::int) END) SELECT Final.CUSTOMERID, Final.ITEMID, Final.MONTH_ID, Final.PENDINGQTY FROM  Final;

CREATE  VIEW fersadw.VW_COUNTRY EXCLUDE SCHEMA PRIVILEGES AS
SELECT CLS.LOCATIONID, VW.INVENTLOCATIONID, hash(CLS.LOCATIONID, VW.INVENTLOCATIONID) AS ID_SUBSWH, CASE WHEN (VW.INVENTLOCATIONID = '105335'::varchar(6)) THEN 'Singapore'::varchar(9) ELSE CS.Name END AS COUNTRYNAME, CASE WHEN (VW.INVENTLOCATIONID = '105335'::varchar(6)) THEN 'SGP'::varchar(3) ELSE CLS.COUNTRY END AS COUNTRYISO FROM ((fersaParams.CompanyLocation_standalone CLS LEFT  JOIN fersadw.VW_WAREHOUSE VW ON ((CLS.LOCATIONID = upper(VW.DATAAREAID)))) JOIN fersaParams.Country_standalone CS ON ((CLS.COUNTRY = CS.ISO3)));

CREATE  VIEW fersadw.VW_FACT_SALES_FILLRATE_NEW EXCLUDE SCHEMA PRIVILEGES AS
WITH  InventOriginTransDimdates AS (SELECT sum(T.QTY) AS QTY, T.DATEPHYSICAL, T.INVENTTRANSID, T.SUBSIDIARYID FROM fersadv.InventOriginTransDim_ALL T WHERE ((T.REFERENCECATEGORY = 0) AND ((T.STATUSISSUE = 1) OR (T.STATUSISSUE = 2))) GROUP BY T.INVENTTRANSID, T.DATEPHYSICAL, T.SUBSIDIARYID),  SalesOrdersDates AS (SELECT SO.INVENTTRANSID, SO.RECID, SO.SUBSIDIARYID, SO.SALESID, SO.ERPSOURCE, SO.REQUESTEDDATE, SO.CONFIRMEDDATEEXTENDED, ITD.DATEPHYSICAL, SO.SALESQTY AS SalesQTY, SO.ITEMID AS Itemid, ITD.QTY, "datediff"('day'::varchar(3), ITD.DATEPHYSICAL, ((SO.REQUESTEDDATE)::date + 30)) AS DATEDIFFREQUESTEDLASTDAYMONTH, "datediff"('day'::varchar(3), ITD.DATEPHYSICAL, (SO.CONFIRMEDDATEEXTENDED + 30::float)) AS DATEDIFFPROMISEDDLASTDAYMONTH FROM (fersadv.SalesLines_ALL SO JOIN  InventOriginTransDimdates ITD ON (((SO.INVENTTRANSID = ITD.INVENTTRANSID) AND (SO.SUBSIDIARYID = ITD.SUBSIDIARYID))))) SELECT SO.INVENTTRANSID, SO.RECID, SO.SUBSIDIARYID, SO.SALESID, SO.ERPSOURCE, SO.DATEPHYSICAL, (SELECT ((-1)::numeric(18,0) * sum(CalcQty.QTY)) FROM  SalesOrdersDates CalcQty WHERE ((SO.INVENTTRANSID = CalcQty.INVENTTRANSID) AND (SO.SUBSIDIARYID = CalcQty.SUBSIDIARYID) AND (CalcQty.DATEDIFFPROMISEDDLASTDAYMONTH > 0) AND (SO.DATEPHYSICAL = CalcQty.DATEPHYSICAL))) AS QTY_CONFIRMED_MONTH, (SELECT ((-1)::numeric(18,0) * sum(CalcQty.QTY)) FROM  SalesOrdersDates CalcQty WHERE ((SO.INVENTTRANSID = CalcQty.INVENTTRANSID) AND (SO.SUBSIDIARYID = CalcQty.SUBSIDIARYID) AND (CalcQty.DATEDIFFREQUESTEDLASTDAYMONTH > 0) AND (SO.DATEPHYSICAL = CalcQty.DATEPHYSICAL))) AS QTY_REQUESTED_MONTH FROM  SalesOrdersDates SO;

CREATE  VIEW fersadw.VW_SATURATION EXCLUDE SCHEMA PRIVILEGES AS
WITH  totalLocs AS (SELECT count(DISTINCT VW.WMSLOCATIONID) AS locQty, VW.INVENTLOCATIONID FROM fersadw.VW_WHSLOCATION VW WHERE ((VW.ZONEGROUPNAME <> 'SESE'::varchar(4)) OR (VW.ZONEGROUPID IS NULL)) GROUP BY VW.INVENTLOCATIONID),  stockLocs AS (SELECT count(DISTINCT ISA.WMSLOCATIONID) AS stockLockQty, ISA.INVENTLOCATIONID FROM (fersadv.InventSum_ALL ISA JOIN fersadw.VW_WHSLOCATION VW ON (((VW.WMSLOCATIONID = ISA.WMSLOCATIONID) AND (ISA.INVENTLOCATIONID = VW.INVENTLOCATIONID)))) WHERE ((VW.ZONEGROUPNAME <> 'SESE'::varchar(4)) OR (VW.ZONEGROUPID IS NULL)) GROUP BY ISA.INVENTLOCATIONID) SELECT sum(SL.stockLockQty) AS StockQTY, sum(TL.locQty) AS MasterQTY, sum((SL.stockLockQty / TL.locQty)) AS sat, TL.INVENTLOCATIONID AS InventLocationId FROM ( stockLocs SL JOIN  totalLocs TL ON ((SL.INVENTLOCATIONID = TL.INVENTLOCATIONID))) GROUP BY TL.INVENTLOCATIONID;

CREATE  VIEW fersadw.VW_FACT_SALES_ROLLING EXCLUDE SCHEMA PRIVILEGES AS
SELECT CL.COMPANYID, rollingTable.RollingLocationId AS SUBSIDIARYID, rollingTable.CustomerId AS CUSTOMERID, hash(CL.COMPANYID, CL.LOCATIONID, rollingTable.CustomerId) AS ID_Customer, rollingTable.ItemId AS ITEMID, rollingTable.Quantity AS QUANTITY, ((concat((rollingTable.Year)::varchar, "right"(concat('00'::varchar(2), (rollingTable.Month)::varchar), 2)) || '01'::varchar(2)))::timestamp AS ROLLING_DATE, ((concat((rollingTable.Year)::varchar, "right"(concat('00'::varchar(2), (rollingTable.Month)::varchar), 2)) || '01'::varchar(2)))::timestamp AS TRANS_DATE, coalesce(CUSTBUDGET.CURRENCYCODE, CA.CURRENCYCODE) AS CURRENCYCODE, ((rollingTable.Quantity * CUSTBUDGET.UNITPRICE))::numeric(32,6) AS ROLLING_AMOUNT, (((rollingTable.Quantity * CUSTBUDGET.UNITPRICE) * CUSTBUDGET.EXCHANGERATE_EUR))::numeric(32,6) AS ROLLING_AMOUNT_EUR, (((rollingTable.Quantity * CUSTBUDGET.UNITPRICE) * CUSTBUDGET.EXCHANGERATE_USD))::numeric(32,6) AS ROLLING_AMOUNT_USD, ((rollingTable.Quantity * CUSTBUDGET.UNITCOST))::numeric(32,6) AS ROLLING_COST, (((rollingTable.Quantity * CUSTBUDGET.UNITCOST) * CUSTBUDGET.COSTEXCHANGERATE_EUR))::numeric(32,6) AS ROLLING_COST_EUR, (((rollingTable.Quantity * CUSTBUDGET.UNITCOST) * CUSTBUDGET.COSTEXCHANGERATE_USD))::numeric(32,6) AS ROLLING_COST_USD FROM (((fersads.ds_CustomerRollingForecast_EDC rollingTable LEFT  JOIN fersaParams.CompanyLocation_standalone CL ON ((rollingTable.RollingLocationId = CL.LOCATIONID))) LEFT  JOIN fersadv.SalesBudgetMonthly_ALL CUSTBUDGET ON (((rollingTable.CustomerId = CUSTBUDGET.CUSTOMERID) AND (rollingTable.ItemId = CUSTBUDGET.ITEMID) AND (rollingTable.Year = CUSTBUDGET.YEAR) AND (rollingTable.Month = CUSTBUDGET.MONTH)))) LEFT  JOIN fersadv.Customer_ALL CA ON (((rollingTable.CustomerId = CA.CUSTOMERID) AND (rollingTable.RollingLocationId = CA.SUBSIDIARYID)))) WHERE ((rollingTable.Year >= ((date_part('year'::varchar(4), ((now())::timetz(6))::timestamp))::int - 3)) AND (rollingTable.Quantity > 0::numeric(18,0)));

CREATE  VIEW fersadw.VW_PURCHASE_BO_ACTIONS EXCLUDE SCHEMA PRIVILEGES AS
SELECT raa.ITEMID, raa.REQDATE, raa.ACTIONDATE, raa.INVENTSTYLEID, raa.INVENTLOCATIONID, raa.REFID, raa.QTY, raa.SUBSIDIARYID, raa.OLDACTIONDATE, raa.NETQTY, raa.REFTYPE, raa.RECID, IT.CREATEDDATETIME, PL.PURCHASEQTY, PL.FIRSTREQUESTEDDATE, PL.CONFIRMEDDATE, PL.DELIVERYDATE, PL.FIRSTCONFIRMEDDATE, (PL.FIRSTCONFIRMEDDATE + (- ((PL.DELIVERYDATE - PL.SHIPPINGDATECONFIRMED)))) AS FIRSTSHIPPINGDATECONFIRMED, PL.SHIPPINGDATECONFIRMED, IT.INVENTTRANSID, sca.UNITPRICE, erda.EXCHANGERATE AS EXCHANGERATE_EUR FROM ((((((fersadw.ReqAction_ALL raa LEFT  JOIN fersadv.ReqTrans_ALL rta ON ((hash(raa.SUBSIDIARYID, raa.RECID) = hash(rta.SUBSIDIARYID, rta.RECID)))) LEFT  JOIN (SELECT iotda.SUBSIDIARYID, iotda.INVENTTRANSORIGIN, iotda.INVENTTRANSID, min(iotda.CREATEDDATETIME) AS CREATEDDATETIME FROM fersadv.InventOriginTransDim_ALL iotda GROUP BY iotda.SUBSIDIARYID, iotda.INVENTTRANSORIGIN, iotda.INVENTTRANSID) IT ON ((hash(rta.SUBSIDIARYID, rta.INVENTTRANSORIGIN) = hash(IT.SUBSIDIARYID, IT.INVENTTRANSORIGIN)))) LEFT  JOIN fersadv.PurchaseLines_ALL PL ON ((hash(IT.SUBSIDIARYID, IT.INVENTTRANSID) = hash(PL.SUBSIDIARYID, PL.INVENTTRANSID)))) LEFT  JOIN fersaParams.CompanyLocation_standalone cls ON ((cls.LOCATIONID = raa.SUBSIDIARYID))) LEFT  JOIN fersadv.StandardCosts_ALL sca ON ((hash(sca.ITEMID, sca.SUBSIDIARYID) = hash(raa.ITEMID, raa.SUBSIDIARYID)))) LEFT  JOIN fersadv.ExchangeRateDaily_ALL erda ON (((erda.TOCURRENCYCODE = 'EUR'::varchar(3)) AND (erda.ERPSOURCE = 'DEFAULT'::varchar(7)) AND (erda.VALIDFROM = (SELECT max(ExchangeRateDaily_ALL.VALIDFROM) AS MAX FROM fersadv.ExchangeRateDaily_ALL WHERE ((ExchangeRateDaily_ALL.VALIDFROM < (now())::date) AND (ExchangeRateDaily_ALL.TOCURRENCYCODE = 'EUR'::varchar(3)) AND (ExchangeRateDaily_ALL.ERPSOURCE = 'DEFAULT'::varchar(7))))) AND (erda.FROMCURRENCYCODE = cls.CURRENCYCODE))));

CREATE  VIEW fersadw.VW_FACT_SALES_FILLRATE_PBI EXCLUDE SCHEMA PRIVILEGES AS
SELECT T.QTY, T.DATEPHYSICAL, SO.REQUESTEDDATE, CASE WHEN (SO.FERFIRSTCONFIRMEDSHIPMENTDATE IS NULL) THEN SO.CONFIRMEDDATEEXTENDED ELSE SO.FERFIRSTCONFIRMEDSHIPMENTDATE END AS CONFIRMEDDATEEXTENDED, T.INVENTTRANSID, SO.SUBSIDIARYID, "datediff"('day'::varchar(3), T.DATEPHYSICAL, SO.REQUESTEDDATE) AS DIFFREQUEST, "datediff"('day'::varchar(3), T.DATEPHYSICAL, CASE WHEN (SO.FERFIRSTCONFIRMEDSHIPMENTDATE IS NULL) THEN SO.CONFIRMEDDATEEXTENDED ELSE SO.FERFIRSTCONFIRMEDSHIPMENTDATE END) AS DIFFPROMISED, "datediff"('month'::varchar(5), T.DATEPHYSICAL, SO.REQUESTEDDATE) AS REQUESTINMONTH, "datediff"('month'::varchar(5), T.DATEPHYSICAL, CASE WHEN (SO.FERFIRSTCONFIRMEDSHIPMENTDATE IS NULL) THEN SO.CONFIRMEDDATEEXTENDED ELSE SO.FERFIRSTCONFIRMEDSHIPMENTDATE END) AS PROMISEDINMONTH FROM (fersadv.InventOriginTransDim_ALL T JOIN fersadv.SalesLines_ALL SO ON (((T.INVENTTRANSID = SO.INVENTTRANSID) AND (T.SUBSIDIARYID = SO.SUBSIDIARYID)))) WHERE ((T.QTY <> 0::numeric(18,0)) AND ((date_part('year'::varchar(4), T.DATEPHYSICAL))::int <> 1900));

CREATE  VIEW fersadw.VW_FACT_PURCHASE_ORDER EXCLUDE SCHEMA PRIVILEGES AS
 SELECT PurchaseLines_ALL.PURCHASEID,
        PurchaseLines_ALL.PURCHASEQTY,
        PurchaseLines_ALL.SUBSIDIARYID,
        PurchaseLines_ALL.CURRENCYCODE,
        PurchaseLines_ALL.EXTERNALITEMID,
        PurchaseLines_ALL.DRAWINGNUMBER,
        PurchaseLines_ALL.DRAWINGVERSION,
        PurchaseLines_ALL.PAYMENTMETHOD,
        PurchaseLines_ALL.TRANSITQTY,
        PurchaseLines_ALL.CURRENCYCODE_LOCAL,
        PurchaseLines_ALL.EXCHANGERATE_EUR,
        PurchaseLines_ALL.ITEMID,
        PurchaseLines_ALL.DISCOUNTPERCENT,
        PurchaseLines_ALL.DISCOUNTAMOUNT,
        PurchaseLines_ALL.PURCHASEDATE,
        PurchaseLines_ALL.PURCHSTATUS,
        PurchaseLines_ALL.PENDINGQTY,
        PurchaseLines_ALL.CONFIRMEDDATE,
        CASE WHEN ((date_part('year'::varchar(4), PurchaseLines_ALL.CONFIRMEDDATE))::int < 2000) THEN PurchaseLines_ALL.DELIVERYDATE ELSE PurchaseLines_ALL.CONFIRMEDDATE END AS RECEPTIONDATE,
        PurchaseLines_ALL.REQUESTEDDATE,
        PurchaseLines_ALL.EXCHANGERATE_USD,
        PurchaseLines_ALL.EXCHANGERATE_LOCAL,
        PurchaseLines_ALL.UNITPRICE,
        PurchaseLines_ALL.PRICEUNIT,
        PurchaseLines_ALL.AMOUNT,
        PurchaseLines_ALL.SUPPLIERID,
        PurchaseLines_ALL.FIRSTCONFIRMEDDATE,
        PurchaseLines_ALL.FIRSTREQUESTEDDATE,
        PurchaseLines_ALL.EXTERNALPURCHASEID,
        PurchaseLines_ALL.EXTERNALPURCHASERECID,
        PurchaseLines_ALL.LINENUMBER,
        PurchaseLines_ALL.INVOICEACCOUNT,
        PurchaseLines_ALL.CREATEDDATETIME,
        PurchaseLines_ALL.INVENTTRANSID,
        PurchaseLines_ALL.COMPANYID,
        PurchaseLines_ALL.ERPSOURCE,
        PurchaseLines_ALL.RECID,
        PurchaseLines_ALL.PAYMENTTERMS,
        (PurchaseLines_ALL.PURCHASEQTY - (coalesce(PurchaseLines_ALL.PENDINGQTY, 0::numeric(18,0)) + coalesce(PurchaseLines_ALL.TRANSITQTY, 0::numeric(18,0)))) AS RECEIVEDQTY,
        (CASE WHEN (INTERCO.CUSTVENDACCOUNT IS NULL) THEN 0 ELSE 1 END)::boolean AS ISINTERCO
 FROM (fersadv.PurchaseLines_ALL LEFT  JOIN ( SELECT CustomerVendorInterCo_standalone.CUSTVENDACCOUNT
 FROM fersaParamsPublic.CustomerVendorInterCo_standalone
 GROUP BY CustomerVendorInterCo_standalone.CUSTVENDACCOUNT) INTERCO ON ((PurchaseLines_ALL.SUPPLIERID = INTERCO.CUSTVENDACCOUNT)));

CREATE  VIEW fersadw.VW_FACT_RECEIPT_RECEIVED EXCLUDE SCHEMA PRIVILEGES AS
SELECT row_number() OVER (PARTITION BY PURCH.INVENTTRANSID, PURCH.ITEMID) AS DOCUMENTID, PURCH.COMPANYID, PURCH.SUBSIDIARYID, PURCH.SUPPLIERID, PURCH.PURCHASEID, PURCH.INVENTTRANSID, PURCH.ITEMID, PURCH.CURRENCYCODE, PURCH.RECEPTIONDATE, PURCH.RECEIVEDQTY, PURCH.RECEIVEDAMOUNT, PURCH.RECEIVEDAMOUNT_EUR, PURCH.RECEIVEDAMOUNT_USD, (CASE WHEN (INTERCO.CUSTVENDACCOUNT IS NULL) THEN 0 ELSE 1 END)::boolean AS ISINTERCO FROM ((SELECT PL.COMPANYID, PL.SUBSIDIARYID, PL.SUPPLIERID, PL.PURCHASEID, IVT.FERPURCHINVENTREFTRANSID AS INVENTTRANSID, IVT.ITEMID, PL.CURRENCYCODE, (IVT.RECEIVEDATE)::timestamp AS RECEPTIONDATE, sum(IVT.QTYRECEIVED) AS RECEIVEDQTY, (sum((IVT.QTYRECEIVED * PL.UNITPRICE)))::numeric(18,2) AS RECEIVEDAMOUNT, (sum(((IVT.QTYRECEIVED * PL.UNITPRICE) * PL.EXCHANGERATE_EUR)))::numeric(18,2) AS RECEIVEDAMOUNT_EUR, (sum(((IVT.QTYRECEIVED * PL.UNITPRICE) * PL.EXCHANGERATE_USD)))::numeric(18,2) AS RECEIVEDAMOUNT_USD FROM (fersadv.InventTransferLine_FER IVT JOIN fersadv.PurchaseLines_ALL PL ON (((PL.INVENTTRANSID = IVT.FERPURCHINVENTREFTRANSID) AND (PL.SUBSIDIARYID = upper(IVT.SUBSIDIARYID))))) WHERE (((date_part('year'::varchar(4), (IVT.RECEIVEDATE)::timestamp))::int >= ((date_part('year'::varchar(4), ((now())::date)::timestamp))::int - 2)) AND (IVT.QTYREMAINRECEIVE = 0::numeric(18,0))) GROUP BY PL.COMPANYID, PL.SUBSIDIARYID, PL.PURCHASEID, IVT.FERPURCHINVENTREFTRANSID, IVT.ITEMID, PL.CURRENCYCODE, IVT.RECEIVEDATE, PL.SUPPLIERID) PURCH LEFT  JOIN (SELECT CustomerVendorInterCo_standalone.CUSTVENDACCOUNT FROM fersaParamsPublic.CustomerVendorInterCo_standalone GROUP BY CustomerVendorInterCo_standalone.CUSTVENDACCOUNT) INTERCO ON ((PURCH.SUPPLIERID = INTERCO.CUSTVENDACCOUNT))) UNION SELECT row_number() OVER (PARTITION BY PURCH.INVENTTRANSID, PURCH.ITEMID) AS DOCUMENTID, PURCH.COMPANYID, PURCH.SUBSIDIARYID, PURCH.SUPPLIERID, PURCH.PURCHASEID, PURCH.INVENTTRANSID, PURCH.ITEMID, PURCH.CURRENCYCODE, PURCH.RECEPTIONDATE, PURCH.RECEIVEDQTY, PURCH.RECEIVEDAMOUNT, PURCH.RECEIVEDAMOUNT_EUR, PURCH.RECEIVEDAMOUNT_USD, (CASE WHEN (INTERCO.CUSTVENDACCOUNT IS NULL) THEN 0 ELSE 1 END)::boolean AS ISINTERCO FROM ((SELECT PL.COMPANYID, IOT.SUBSIDIARYID, PL.SUPPLIERID, IOT.REFERENCEID AS PURCHASEID, IOT.INVENTTRANSID, IOT.ITEMID, PL.CURRENCYCODE, IOT.DATEPHYSICAL AS RECEPTIONDATE, sum(IOT.QTY) AS RECEIVEDQTY, (sum((IOT.COSTAMOUNTPOSTED + IOT.COSTAMOUNTPHYSICAL)))::numeric(18,2) AS RECEIVEDAMOUNT, (sum(((IOT.COSTAMOUNTPOSTED + IOT.COSTAMOUNTPHYSICAL) * PL.EXCHANGERATE_EUR)))::numeric(18,2) AS RECEIVEDAMOUNT_EUR, (sum(((IOT.COSTAMOUNTPOSTED + IOT.COSTAMOUNTPHYSICAL) * PL.EXCHANGERATE_USD)))::numeric(18,2) AS RECEIVEDAMOUNT_USD FROM (fersadv.InventOriginTransDim_ALL IOT JOIN fersadv.PurchaseLines_ALL PL ON (((IOT.REFERENCEID = PL.PURCHASEID) AND (IOT.INVENTTRANSID = PL.INVENTTRANSID)))) WHERE ((IOT.REFERENCECATEGORY = 3) AND ((date_part('year'::varchar(4), IOT.DATEPHYSICAL))::int >= ((date_part('year'::varchar(4), ((now())::timetz(6))::timestamp))::int - 2)) AND (concat(IOT.REFERENCEID, IOT.INVENTTRANSID) NOT IN (SELECT concat(PL.PURCHASEID, IVT.FERPURCHINVENTREFTRANSID) AS concat FROM (fersadv.InventTransferLine_FER IVT JOIN fersadv.PurchaseLines_ALL PL ON (((PL.INVENTTRANSID = IVT.FERPURCHINVENTREFTRANSID) AND (PL.SUBSIDIARYID = upper(IVT.SUBSIDIARYID)))))))) GROUP BY PL.COMPANYID, IOT.SUBSIDIARYID, IOT.REFERENCEID, IOT.INVENTTRANSID, IOT.ITEMID, PL.CURRENCYCODE, IOT.DATEPHYSICAL, PL.SUPPLIERID) PURCH LEFT  JOIN (SELECT CustomerVendorInterCo_standalone.CUSTVENDACCOUNT FROM fersaParamsPublic.CustomerVendorInterCo_standalone GROUP BY CustomerVendorInterCo_standalone.CUSTVENDACCOUNT) INTERCO ON ((PURCH.SUPPLIERID = INTERCO.CUSTVENDACCOUNT)));

CREATE  VIEW fersadw.VW_FACT_SALES_FILLRATE EXCLUDE SCHEMA PRIVILEGES AS
WITH  InventOriginTransDimdates AS (SELECT T.QTY, T.DATEPHYSICAL, SO.REQUESTEDDATE, CASE WHEN (SO.FERFIRSTCONFIRMEDSHIPMENTDATE IS NULL) THEN SO.CONFIRMEDDATEEXTENDED ELSE SO.FERFIRSTCONFIRMEDSHIPMENTDATE END AS CONFIRMEDDATEEXTENDED, T.INVENTTRANSID, SO.SUBSIDIARYID, "datediff"('day'::varchar(3), T.DATEPHYSICAL, SO.REQUESTEDDATE) AS DIFFREQUEST, "datediff"('day'::varchar(3), T.DATEPHYSICAL, CASE WHEN (SO.FERFIRSTCONFIRMEDSHIPMENTDATE IS NULL) THEN SO.CONFIRMEDDATEEXTENDED ELSE SO.FERFIRSTCONFIRMEDSHIPMENTDATE END) AS DIFFPROMISED, "datediff"('month'::varchar(5), T.DATEPHYSICAL, SO.REQUESTEDDATE) AS REQUESTINMONTH, "datediff"('month'::varchar(5), T.DATEPHYSICAL, CASE WHEN (SO.FERFIRSTCONFIRMEDSHIPMENTDATE IS NULL) THEN SO.CONFIRMEDDATEEXTENDED ELSE SO.FERFIRSTCONFIRMEDSHIPMENTDATE END) AS PROMISEDINMONTH, "datediff"('day'::varchar(3), T.DATEPHYSICAL, SO.REQUESTEDDATE) AS DATEDIFFREQUESTEDLASTDAYWEEK, "datediff"('day'::varchar(3), T.DATEPHYSICAL, CASE WHEN (SO.FERFIRSTCONFIRMEDSHIPMENTDATE IS NULL) THEN SO.CONFIRMEDDATEEXTENDED ELSE SO.FERFIRSTCONFIRMEDSHIPMENTDATE END) AS DATEDIFFPROMISEDDLASTDAYWEEK FROM (fersadv.InventOriginTransDim_ALL T JOIN fersadv.SalesLines_ALL SO ON (((T.INVENTTRANSID = SO.INVENTTRANSID) AND (T.SUBSIDIARYID = SO.SUBSIDIARYID)))) WHERE ((T.QTY <> 0::numeric(18,0)) AND ((date_part('year'::varchar(4), T.DATEPHYSICAL))::int <> 1900))) SELECT SO.INVENTTRANSID AS InventTransId, SO.RECID AS SalesLineRecId, SO.SUBSIDIARYID AS SalesSubsidiaryId, SO.SALESID AS salesid, SO.ERPSOURCE AS erpsource, SO.REQUESTEDDATE, CASE WHEN (SO.FERFIRSTCONFIRMEDSHIPMENTDATE IS NULL) THEN SO.CONFIRMEDDATEEXTENDED ELSE SO.FERFIRSTCONFIRMEDSHIPMENTDATE END AS CONFIRMEDDATEEXTENDED, CASE WHEN (SO.FERFIRSTCONFIRMEDSHIPMENTDATE IS NULL) THEN SO.CONFIRMEDDATEEXTENDED ELSE SO.FERFIRSTCONFIRMEDSHIPMENTDATE END AS CONFIRMEDDATE, "datediff"('day'::varchar(3), SO.FERFIRSTCONFIRMEDSHIPMENTDATE, SO.CONFIRMEDDATEEXTENDED) AS "datediff", (SELECT ((-1)::numeric(18,0) * sum(ITO.QTY)) FROM  InventOriginTransDimdates ITO WHERE ((ITO.INVENTTRANSID = SO.INVENTTRANSID) AND (ITO.SUBSIDIARYID = SO.SUBSIDIARYID) AND (ITO.REQUESTINMONTH >= 0))) AS QTY_DELIVERED_CALENDARMONTH, (SELECT ((-1)::numeric(18,0) * sum(ITO.QTY)) FROM  InventOriginTransDimdates ITO WHERE ((ITO.INVENTTRANSID = SO.INVENTTRANSID) AND (ITO.SUBSIDIARYID = SO.SUBSIDIARYID) AND (ITO.PROMISEDINMONTH >= 0))) AS QTY_PROMISED_CALENDARMONTH, (SELECT ((-1)::numeric(18,0) * sum(ITO.QTY)) FROM  InventOriginTransDimdates ITO WHERE ((ITO.INVENTTRANSID = SO.INVENTTRANSID) AND (ITO.SUBSIDIARYID = SO.SUBSIDIARYID) AND (ITO.DIFFREQUEST >= (-30)))) AS QTY_DELIVERED_MONTH, (SELECT ((-1)::numeric(18,0) * sum(ITO.QTY)) FROM  InventOriginTransDimdates ITO WHERE ((ITO.INVENTTRANSID = SO.INVENTTRANSID) AND (ITO.SUBSIDIARYID = SO.SUBSIDIARYID) AND (ITO.DIFFPROMISED >= (-30)))) AS QTY_PROMISED_MONTH, (SELECT ((-1)::numeric(18,0) * sum(ITO.QTY)) FROM  InventOriginTransDimdates ITO WHERE ((ITO.INVENTTRANSID = SO.INVENTTRANSID) AND (ITO.SUBSIDIARYID = SO.SUBSIDIARYID) AND (ITO.DIFFREQUEST >= (-15)) AND (ITO.DIFFREQUEST <= 15))) AS QTY_DELIVERED_WEEK, (SELECT ((-1)::numeric(18,0) * sum(ITO.QTY)) FROM  InventOriginTransDimdates ITO WHERE ((ITO.INVENTTRANSID = SO.INVENTTRANSID) AND (ITO.SUBSIDIARYID = SO.SUBSIDIARYID) AND (ITO.DIFFPROMISED >= (-15)) AND (ITO.DIFFPROMISED <= 15))) AS QTY_PROMISED_WEEK, (SELECT ((-1)::numeric(18,0) * sum(ITO.QTY)) FROM  InventOriginTransDimdates ITO WHERE ((ITO.INVENTTRANSID = SO.INVENTTRANSID) AND (ITO.SUBSIDIARYID = SO.SUBSIDIARYID) AND (ITO.DIFFREQUEST >= (-2)))) AS QTY_DELIVERED_48, (SELECT ((-1)::numeric(18,0) * sum(ITO.QTY)) FROM  InventOriginTransDimdates ITO WHERE ((ITO.INVENTTRANSID = SO.INVENTTRANSID) AND (ITO.SUBSIDIARYID = SO.SUBSIDIARYID) AND (ITO.DIFFREQUEST >= (-3)))) AS QTY_DELIVERED_72, (SELECT ((-1)::numeric(18,0) * sum(ITO.QTY)) FROM  InventOriginTransDimdates ITO WHERE ((ITO.INVENTTRANSID = SO.INVENTTRANSID) AND (ITO.SUBSIDIARYID = SO.SUBSIDIARYID) AND (ITO.DIFFREQUEST >= (-5)))) AS QTY_DELIVERED_120 FROM fersadv.SalesLines_ALL SO;

CREATE  VIEW fersadw.VW_CUSTOMERS EXCLUDE SCHEMA PRIVILEGES AS
 SELECT CA.COMPANYID,
        CASE WHEN (CDS.INVENTLOCATION = 'NLD'::varchar(3)) THEN 'PROT'::varchar(4) ELSE CA.SUBSIDIARYID END AS SUBSIDIARYID,
        hash(CA.COMPANYID, CA.SUBSIDIARYID, CA.CUSTOMERID) AS ID_Customer,
        CA.CUSTOMERID,
        CA.CURRENCYCODE,
        coalesce(CA.SECTOR, 'UNSET'::varchar(5)) AS SECTOR,
        CA.CATEGORY,
        CA.ACTIVITY,
        CA.COUNTRY,
        coalesce(CA.CUSTOMERGROUPNAME, CA.NAME) AS CUSTOMERGROUPNAME,
