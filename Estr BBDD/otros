        BomTree.currencycode AS CURRENCYCODE,
        BomTree.unitprice AS PURCHCOSTS,
        NULL AS INTERCOCOST,
        NULL AS COSTNAME,
        NULL AS SUBVENDORNAME,
        BomTree.subsidiaryid AS SUBSIDIARYID_SUBVENDOR,
        BomTree.currencycode_local AS SUBVENDOR_CURRENCYCODE,
        NULL AS SUBVENDORCOSTS
 FROM ( BomTree JOIN fersaParams.CompanyLocation_standalone CL ON ((BomTree.groupSubsidiaryId = CL.LOCATIONID)));

CREATE  VIEW fersadw.VW_FACT_SALES_CUSTTRANS EXCLUDE SCHEMA PRIVILEGES AS
 SELECT CTA.COMPANYID,
        CTA.SUBSIDIARYID,
        CTA.ACCOUNTNUM AS CUSTOMERID,
        CVI.TODATAAREAID AS CUSTOMERINTERCOSUBSIDIARY,
        CTA.ORDERACCOUNT,
        hash(CTA.COMPANYID, CTA.SUBSIDIARYID, CTA.ACCOUNTNUM) AS ID_Customer,
        CTA.AMOUNT,
        (CTA.AMOUNT * CTA.EXCHANGERATE_EUR) AS AMOUNT_EUR,
        (CTA.AMOUNT * CTA.EXCHANGERATE_USD) AS AMOUNT_USD,
        CTA.SETTLEAMOUNT,
        (CTA.SETTLEAMOUNT * CTA.EXCHANGERATE_EUR) AS SETTLEAMOUNT_EUR,
        (CTA.SETTLEAMOUNT * CTA.EXCHANGERATE_USD) AS SETTLEAMOUNT_USD,
        round(CTA.DUEAMOUNT, 1) AS DUEAMOUNT,
        round((CTA.DUEAMOUNT * CTA.EXCHANGERATE_EUR), 2) AS DUEAMOUNT_EUR,
        round((CTA.DUEAMOUNT * CTA.EXCHANGERATE_USD), 2) AS DUEAMOUNT_USD,
        CLS.FINANCIALCOSTPERCENTAGE AS FINANCIALCOSTSUBSIDIARY,
        CTA.CURRENCYCODE,
        CTA.TRANSDATE,
        CTA.DUEDATE,
        CTA.CLOSEDDATE,
        CASE WHEN (CTA.CONFIRMEDCLOSE IS TRUE) THEN "datediff"('day'::varchar(3), CTA.TRANSDATE, CTA.CLOSEDDATE) ELSE "datediff"('day'::varchar(3), CTA.TRANSDATE, (now())::date) END AS COLLECTIONDAYS,
        CTA.DUEDAYS,
        CTA.CONFIRMEDCLOSE,
        CTA.INVOICEID,
        CTA.PAYMENTMODE,
        CTA.PAYMENTTERMID,
        CASE WHEN (CTA.COFACE > 0::numeric(18,0)) THEN 1 ELSE 0 END AS COFACEAUX,
        round(CTA.COFACE, 1) AS COFACEAMOUNT,
        round((CTA.COFACE * CTA.EXCHANGERATE_EUR), 2) AS COFACEAMOUNT_EUR,
        round((CTA.COFACE * CTA.EXCHANGERATE_USD), 2) AS COFACEAMOUNT_USD,
        CASE WHEN (CTA.DUEDAYS < 0) THEN '<0 days'::varchar(7) WHEN ((CTA.DUEDAYS > 0) AND (CTA.DUEDAYS <= 30)) THEN '0-30 days'::varchar(9) WHEN ((CTA.DUEDAYS > 30) AND (CTA.DUEDAYS <= 90)) THEN '31-90 days'::varchar(10) ELSE '90 days or more'::varchar(15) END AS DUEPERIOD,
        CASE WHEN ((CTA.AMOUNT < 0::numeric(18,0)) OR (CTA.DUEAMOUNT < 0::numeric(18,0))) THEN '2'::varchar(1) ELSE '1'::varchar(1) END AS TRANSTYPE,
        CASE WHEN (UC.CUSTOMERID = CTA.ACCOUNTNUM) THEN 'Uncollectible'::varchar(13) ELSE 'Collectible'::varchar(11) END AS UNCOLLECTIBLE
 FROM (((fersadv.CustomerTransaction_ALL CTA LEFT  JOIN fersaParams.UncollectibleCustomers UC ON ((CTA.ACCOUNTNUM = UC.CUSTOMERID))) JOIN fersaParams.CompanyLocation_standalone CLS ON ((CTA.SUBSIDIARYID = CLS.LOCATIONID))) LEFT  JOIN fersaParamsPublic.CustomerVendorInterCo_standalone CVI ON (((CTA.SUBSIDIARYID = CVI.FROMDATAAREAID) AND (CTA.ACCOUNTNUM = CVI.CUSTVENDACCOUNT) AND (CVI.TYPE = 2))))
 WHERE (("datediff"('day'::varchar(3), CTA.CLOSEDDATE, (now())::date) < 365) OR ((CTA.CLOSEDDATE IS NULL) AND (CTA.COMPANYID <> 'DLX'::varchar(3))));

CREATE  VIEW fersadw.VW_ITEM_MASTER EXCLUDE SCHEMA PRIVILEGES AS
 SELECT ilsa.COMPANYID,
        ilsa.SUBSIDIARYID,
        ilsa.ITEMID,
        ilsa.CATALOG,
        ilsa.NAME,
        ilsa.DESCRIPTION,
        ilsa.BEARINGTYPE,
        ilsa.BEARINGSUBTYPE,
        ilsa.ANGLE,
        ilsa.HEIGHT,
        ilsa.WIDTH,
        ilsa.INNERDIAMETER,
        ilsa.OUTERDIAMETER,
        ilsa.OUTERDIAMETER2,
        ilsa.RADIUS,
        ilsa.UNITID,
        ilsa.NETWEIGHT,
        ilsa.TARAWEIGHT,
        ilsa.GROSSWEIGHT,
        ilsa.ITEMTYPE,
        ilsa.SBU,
        ilsa.FAMILYNAME,
        ilsa.GLOBALCATALOG,
        ilsa.GLOBALPRODUCTTYPE,
        ilsa.MOQ,
        ilsa.ITEMCATEGORYCODE,
        ilsa.NAMEALIAS,
        ilsa.DEFAULTORDERTYPE,
        ilsa.ITEMGROUP,
        ilsa.ABC,
        ilsa.PLANNERGROUP,
        ilsa.MODELGROUPID,
        ilsa.INTRASTATCOMMODITY,
        ilsa.SALESBLOCKED,
        ilsa.PURCHBLOCKED,
        ilsa.INVENTORYBLOCKED,
        ilsa.COSTGROUP,
        ilsa.FINNACIALDIMENSIONS,
        ilsa.BRAND,
        ilsa.FERPRODUCTTYPE,
        ilsa.PRIMARYVENDORID,
        ilsa.PATH,
        ilsa.ORIGIN,
        ilsa.REQGROUPID AS ReqGroupID,
        SS.SUPPLIERNAME AS PRIMARYVENDORNAME,
        LINE.LINEROUTEID
 FROM ((fersadv.Item_ALL ilsa LEFT  JOIN ( SELECT A.SUBSIDIARYID,
        A.ITEMID,
        A.LINEROUTEID
 FROM ( SELECT Routes_ALL.SUBSIDIARYID,
        Routes_ALL.ITEMID,
        first_value(Routes_ALL.LINEROUTEID, false) OVER (PARTITION BY Routes_ALL.SUBSIDIARYID, Routes_ALL.ITEMID ORDER BY Routes_ALL.FROMQTY) AS LINEROUTEID
 FROM fersadv.Routes_ALL
 WHERE (Routes_ALL.ACTIVE AND Routes_ALL.APPROVED)) A
 GROUP BY A.SUBSIDIARYID,
          A.ITEMID,
          A.LINEROUTEID) LINE ON ((hash(LINE.ITEMID, LINE.SUBSIDIARYID) = hash(ilsa.ITEMID, ilsa.SUBSIDIARYID)))) LEFT  JOIN fersadw.Supplier_FACT SS ON ((hash(SS.SUPPLIERID, SS.SUBSIDIARYID) = hash(ilsa.PRIMARYVENDORID, ilsa.SUBSIDIARYID))));

CREATE  VIEW fersadw.VW_MONTHLYSALES_PBI EXCLUDE SCHEMA PRIVILEGES AS
WITH  sales_agg AS ( SELECT sib.INVOICEDATE AS date_day,
        sib.FERITEMCATEGORIZATION AS feritemcategorization,
        sib.SALESMANAGER AS salesmanager,
        sib.BRAND,
        sib.ITEMTYPE AS itemtype,
        sib.CUSTOMERTYPE AS customertype,
        sib.SUBSIDIARYID AS subsidiaryid,
        sum(sib.INVOICEQTY) AS sales_QTY,
        sum(sib.AMOUNT_EUR) AS sales_amount_eur,
        sum(sib.AMOUNT_USD) AS sales_amount_usd,
        sum(sib.AMOUNT) AS sales_amount
 FROM fersadw.SalesInvoice_BI sib
 WHERE (sib.INVOICEDATE >= '2023-01-01 00:00:00'::timestamp)
 GROUP BY sib.INVOICEDATE,
          sib.FERITEMCATEGORIZATION,
          sib.SALESMANAGER,
          sib.BRAND,
          sib.ITEMTYPE,
          sib.CUSTOMERTYPE,
          sib.SUBSIDIARYID),  budget_agg AS ( SELECT sblf.BUDGETDATE AS date_day,
        sblf.FERITEMCATEGORIZATION AS feritemcategorization,
        sblf.SALESMANAGER AS salesmanager,
        sblf.BRAND,
        sblf.ITEMTYPE AS itemtype,
        sblf.CUSTOMERTYPE AS customertype,
        sblf.SUBSIDIARYID AS subsidiaryid,
        sum(sblf.QUANTITY) AS budget_QTY,
        sum(sblf.AMOUNT_EUR) AS budget_amount_eur,
        sum(sblf.AMOUNT_USD) AS budget_amount_usd,
        sum(sblf.AMOUNT) AS budget_amount
 FROM fersadw.SalesBudgetLines_FACT sblf
 WHERE (sblf.BUDGETYEAR >= 2023)
 GROUP BY sblf.BUDGETDATE,
          sblf.FERITEMCATEGORIZATION,
          sblf.SALESMANAGER,
          sblf.BRAND,
          sblf.ITEMTYPE,
          sblf.CUSTOMERTYPE,
          sblf.SUBSIDIARYID),  target_agg AS ( SELECT sblf.BUDGETDATE AS date_day,
        sblf.FERITEMCATEGORIZATION AS feritemcategorization,
        sblf.SALESMANAGER AS salesmanager,
        sblf.BRAND,
        sblf.ITEMTYPE AS itemtype,
        sblf.CUSTOMERTYPE AS customertype,
        sblf.SUBSIDIARYID AS subsidiaryid,
        sum(sblf.QUANTITY) AS target_QTY,
        sum(sblf.AMOUNT_EUR) AS target_amount_eur,
        sum(sblf.AMOUNT_USD) AS target_amount_usd,
        sum(sblf.AMOUNT) AS target_amount
 FROM fersadw.SalesTargetLines_FACT sblf
 WHERE (sblf.BUDGETYEAR >= 2023)
 GROUP BY sblf.BUDGETDATE,
          sblf.FERITEMCATEGORIZATION,
          sblf.SALESMANAGER,
          sblf.BRAND,
          sblf.ITEMTYPE,
          sblf.CUSTOMERTYPE,
          sblf.SUBSIDIARYID)
  SELECT coalesce(s.date_day, b.date_day, t.date_day) AS date_day,
        coalesce(s.feritemcategorization, b.feritemcategorization, t.feritemcategorization) AS feritemcategorization,
        coalesce(s.salesmanager, b.salesmanager, t.salesmanager) AS salesmanager,
        coalesce(s.BRAND, b.BRAND, t.BRAND) AS brand,
        coalesce(s.itemtype, b.itemtype, t.itemtype) AS itemtype,
        coalesce(s.customertype, b.customertype, t.customertype) AS customertype,
        coalesce(s.subsidiaryid, b.subsidiaryid, t.subsidiaryid) AS subsidiaryid,
        coalesce(s.sales_QTY, 0::numeric(18,0)) AS sales_qty,
        coalesce(s.sales_amount_eur, 0::numeric(18,0)) AS sales_amount_eur,
        coalesce(s.sales_amount_usd, 0::numeric(18,0)) AS sales_amount_usd,
        coalesce(s.sales_amount, 0::numeric(18,0)) AS sales_amount,
        coalesce(b.budget_QTY, 0::numeric(18,0)) AS budget_qty,
        coalesce(b.budget_amount_eur, 0::numeric(18,0)) AS budget_amount_eur,
        coalesce(b.budget_amount_usd, 0::numeric(18,0)) AS budget_amount_usd,
        coalesce(b.budget_amount, 0::numeric(18,0)) AS budget_amount,
        coalesce(t.target_QTY, 0::numeric(18,0)) AS target_qty,
        coalesce(t.target_amount_eur, 0::numeric(18,0)) AS target_amount_eur,
        coalesce(t.target_amount_usd, 0::numeric(18,0)) AS target_amount_usd,
        coalesce(t.target_amount, 0::numeric(18,0)) AS target_amount
 FROM (( sales_agg s FULL  JOIN  budget_agg b ON (((s.date_day = b.date_day) AND (s.feritemcategorization = b.feritemcategorization) AND (s.salesmanager = b.salesmanager) AND (s.BRAND = b.BRAND) AND (s.itemtype = b.itemtype) AND (s.customertype = b.customertype) AND (s.subsidiaryid = b.subsidiaryid)))) FULL  JOIN  target_agg t ON (((s.date_day = t.date_day) AND (s.feritemcategorization = t.feritemcategorization) AND (s.salesmanager = t.salesmanager) AND (s.BRAND = t.BRAND) AND (s.itemtype = t.itemtype) AND (s.customertype = t.customertype) AND (s.subsidiaryid = t.subsidiaryid))));

CREATE  VIEW fersadw.VW_FACT_RECEIPT_PLANNED EXCLUDE SCHEMA PRIVILEGES AS
 SELECT row_number() OVER (PARTITION BY IL.PRIMARYVENDORID, RT.ITEMID) AS DOCUMENTID,
        IL.COMPANYID,
        RT.SUBSIDIARYID,
        RT.ITEMID,
        IL.PRIMARYVENDORID AS SUPPLIERID,
        sum(RT.QTY) AS PLANNEDQTY,
        RT.REQDATE AS RECEPTIONDATE,
        vpp.CURRENCYCODE,
        (sum((RT.QTY * vpp.unitprice)))::numeric(18,2) AS PLANNEDAMOUNT,
        sum(((RT.QTY * vpp.unitprice) * vpp.exchangerate_eur)) AS PLANNEDAMOUNT_EUR,
        sum(((RT.QTY * vpp.unitprice) * vpp.exchangerate_usd)) AS PLANNEDAMOUNT_USD
 FROM ((fersadv.ReqTrans_ALL RT JOIN fersadv.Item_ALL IL ON (((RT.ITEMID = IL.ITEMID) AND (RT.SUBSIDIARYID = IL.SUBSIDIARYID)))) LEFT  JOIN ( SELECT vpp.SUPPLIERID AS supplierid,
        vpp.ITEMID AS itemid,
        vpp.SUBSIDIARYID AS subsidiaryid,
        max(vpp.UNITPRICE) AS unitprice,
        vpp.CURRENCYCODE,
        vpp.EXCHANGERATE_EUR AS exchangerate_eur,
        vpp.EXCHANGERATE_USD AS exchangerate_usd
 FROM fersadw.VW_PURCHASE_PRICES vpp
 GROUP BY vpp.SUPPLIERID,
          vpp.ITEMID,
          vpp.SUBSIDIARYID,
          vpp.EXCHANGERATE_EUR,
          vpp.CURRENCYCODE,
          vpp.EXCHANGERATE_USD) vpp ON (((IL.PRIMARYVENDORID = vpp.supplierid) AND (IL.ITEMID = vpp.itemid) AND (RT.SUBSIDIARYID = vpp.subsidiaryid))))
 WHERE ((RT.REFTYPE = 33) AND (RT.SUBSIDIARYID = ANY (ARRAY['FBEA'::varchar(4), 'FJXN'::varchar(4)])))
 GROUP BY IL.COMPANYID,
          RT.SUBSIDIARYID,
          RT.ITEMID,
          IL.PRIMARYVENDORID,
          RT.REQDATE,
          vpp.CURRENCYCODE;

CREATE  VIEW fersadw.VW_FACT_PURCHASE_YEARLY_PRICE EXCLUDE SCHEMA PRIVILEGES AS
 SELECT VV2.ITEMID,
        VV2.SUPPLIERID,
        VV2.YEAR,
        VV2.COMPANYID,
        VV2.SUBSIDIARYID,
        CASE WHEN (((VV2.AveragePrevious - VV2.Average) * VV2.QTYPOR) = 0::numeric(1,0)) THEN NULL::numeric(1,0) ELSE ((VV2.AveragePrevious - VV2.Average) * VV2.QTYPOR) END AS YearlySavings,
        CASE WHEN (((VV2.AverageBudget - VV2.Average) * VV2.QTYPOR) = 0::numeric(1,0)) THEN NULL::numeric(1,0) ELSE ((VV2.AverageBudget - VV2.Average) * VV2.QTYPOR) END AS BudgetSavings
 FROM ( SELECT VV.ITEMID,
        VV.SUPPLIERID,
        VV.YEAR,
        VV.COMPANYID,
        VV.SUBSIDIARYID,
        CASE WHEN (VV.sumqtyyear = 0::numeric(18,0)) THEN 0::numeric(18,0) ELSE ((VV.sumamount_eur + VV.sumadditionalchages_EUR) / CASE WHEN (VV.sumqtyyear = 0::numeric(1,0)) THEN NULL::numeric(1,0) ELSE VV.sumqtyyear END) END AS Average,
        CASE WHEN (VV.sumqtyyearprevious = 0::numeric(18,0)) THEN 0::numeric(18,0) ELSE ((VV.sumamountprevious_eur + VV.sumadditionalchagesprevious_EUR) / CASE WHEN (VV.sumqtyyearprevious = 0::numeric(1,0)) THEN NULL::numeric(1,0) ELSE VV.sumqtyyearprevious END) END AS AveragePrevious,
        CASE WHEN (VV.QTY = 0::numeric(18,0)) THEN 0::numeric(18,0) ELSE (VV.sumBdgYear_EUR / CASE WHEN (VV.QTY = 0::numeric(1,0)) THEN NULL::numeric(1,0) ELSE VV.QTY END) END AS AverageBudget,
        least(VV.QTY, VV.sumqtyyear) AS QTYPOR
 FROM ( SELECT PurchaseBudgetYearly_ALL.SUBSIDIARYID,
        PurchaseBudgetYearly_ALL.ITEMID,
        PurchaseBudgetYearly_ALL.SUPPLIERID,
        PurchaseBudgetYearly_ALL.YEAR,
        PurchaseBudgetYearly_ALL.QTY,
        COMP.COMPANYID,
        (((((PurchaseBudgetYearly_ALL.UNITPRICE * PurchaseBudgetYearly_ALL.EXCHANGERATE_EUR) + PurchaseBudgetYearly_ALL.CUSTOMCOST) + PurchaseBudgetYearly_ALL.TRANSPORTCOST) * PurchaseBudgetYearly_ALL.CORRECTIONFACTOR) * PurchaseBudgetYearly_ALL.QTY) AS sumBdgYear_EUR,
        coalesce(( SELECT sum(pia.INVOICEQTY) AS sum
 FROM fersadv.PurchaseInvoices_ALL pia
 WHERE ((pia.ITEMID = PurchaseBudgetYearly_ALL.ITEMID) AND (pia.SUPPLIERID = PurchaseBudgetYearly_ALL.SUPPLIERID) AND ((date_part('year'::varchar(4), pia.INVOICEDATE))::int = PurchaseBudgetYearly_ALL.YEAR) AND (pia.SUBSIDIARYID = PurchaseBudgetYearly_ALL.SUBSIDIARYID))), 0::numeric(18,0)) AS sumqtyyear,
        coalesce(( SELECT sum(pia.INVOICEQTY) AS sum
 FROM fersadv.PurchaseInvoices_ALL pia
 WHERE ((pia.ITEMID = PurchaseBudgetYearly_ALL.ITEMID) AND (pia.SUPPLIERID = PurchaseBudgetYearly_ALL.SUPPLIERID) AND ((date_part('year'::varchar(4), pia.INVOICEDATE))::int = (PurchaseBudgetYearly_ALL.YEAR - 1)) AND (pia.SUBSIDIARYID = PurchaseBudgetYearly_ALL.SUBSIDIARYID))), NULL::numeric(1,0)) AS sumqtyyearprevious,
        coalesce(( SELECT sum((pia.AMOUNT * pia.EXCHANGERATE_EUR)) AS sum
 FROM fersadv.PurchaseInvoices_ALL pia
 WHERE ((pia.ITEMID = PurchaseBudgetYearly_ALL.ITEMID) AND (pia.SUPPLIERID = PurchaseBudgetYearly_ALL.SUPPLIERID) AND ((date_part('year'::varchar(4), pia.INVOICEDATE))::int = PurchaseBudgetYearly_ALL.YEAR) AND (pia.SUBSIDIARYID = PurchaseBudgetYearly_ALL.SUBSIDIARYID))), 0::numeric(18,0)) AS sumamount_eur,
        coalesce(( SELECT sum((pia.AMOUNT * pia.EXCHANGERATE_EUR)) AS sum
 FROM fersadv.PurchaseInvoices_ALL pia
 WHERE ((pia.ITEMID = PurchaseBudgetYearly_ALL.ITEMID) AND (pia.SUPPLIERID = PurchaseBudgetYearly_ALL.SUPPLIERID) AND ((date_part('year'::varchar(4), pia.INVOICEDATE))::int = (PurchaseBudgetYearly_ALL.YEAR - 1)) AND (pia.SUBSIDIARYID = PurchaseBudgetYearly_ALL.SUBSIDIARYID))), 0::numeric(18,0)) AS sumamountprevious_eur,
        coalesce(CASE WHEN (COMP.CURRENCYCODE = 'EUR'::varchar(3)) THEN ( SELECT sum(pia.ADDITIONALCHARGES) AS sum
 FROM fersadv.PurchaseInvoices_ALL pia
 WHERE ((pia.ITEMID = PurchaseBudgetYearly_ALL.ITEMID) AND (pia.SUPPLIERID = PurchaseBudgetYearly_ALL.SUPPLIERID) AND ((date_part('year'::varchar(4), pia.INVOICEDATE))::int = PurchaseBudgetYearly_ALL.YEAR) AND (pia.SUBSIDIARYID = PurchaseBudgetYearly_ALL.SUBSIDIARYID))) ELSE ( SELECT sum((pia.ADDITIONALCHARGES * pia.EXCHANGERATE_EUR)) AS sum
 FROM fersadv.PurchaseInvoices_ALL pia
 WHERE ((pia.ITEMID = PurchaseBudgetYearly_ALL.ITEMID) AND (pia.SUPPLIERID = PurchaseBudgetYearly_ALL.SUPPLIERID) AND ((date_part('year'::varchar(4), pia.INVOICEDATE))::int = PurchaseBudgetYearly_ALL.YEAR) AND (pia.SUBSIDIARYID = PurchaseBudgetYearly_ALL.SUBSIDIARYID))) END, 0::numeric(18,0)) AS sumadditionalchages_EUR,
        coalesce(CASE WHEN (COMP.CURRENCYCODE = 'EUR'::varchar(3)) THEN ( SELECT sum(pia.ADDITIONALCHARGES) AS sum
 FROM fersadv.PurchaseInvoices_ALL pia
 WHERE ((pia.ITEMID = PurchaseBudgetYearly_ALL.ITEMID) AND (pia.SUPPLIERID = PurchaseBudgetYearly_ALL.SUPPLIERID) AND ((date_part('year'::varchar(4), pia.INVOICEDATE))::int = (PurchaseBudgetYearly_ALL.YEAR - 1)) AND (pia.SUBSIDIARYID = PurchaseBudgetYearly_ALL.SUBSIDIARYID))) ELSE ( SELECT sum((pia.ADDITIONALCHARGES * pia.EXCHANGERATE_EUR)) AS sum
 FROM fersadv.PurchaseInvoices_ALL pia
 WHERE ((pia.ITEMID = PurchaseBudgetYearly_ALL.ITEMID) AND (pia.SUPPLIERID = PurchaseBudgetYearly_ALL.SUPPLIERID) AND ((date_part('year'::varchar(4), pia.INVOICEDATE))::int = (PurchaseBudgetYearly_ALL.YEAR - 1)) AND (pia.SUBSIDIARYID = PurchaseBudgetYearly_ALL.SUBSIDIARYID))) END, 0::numeric(18,0)) AS sumadditionalchagesprevious_EUR
 FROM (fersadv.PurchaseBudgetYearly_ALL PurchaseBudgetYearly_ALL LEFT  JOIN fersaParams.CompanyLocation_standalone COMP ON ((COMP.LOCATIONID = upper(PurchaseBudgetYearly_ALL.SUBSIDIARYID))))) VV
 WHERE (VV.QTY > 0::numeric(18,0))) VV2;

CREATE  VIEW fersadw.VW_WAREHOUSE EXCLUDE SCHEMA PRIVILEGES AS
(((SELECT ILF.DEFAULTSTATUSID, ILF.INVENTLOCATIONID, CASE WHEN ("substring"(ILF.INVENTLOCATIONID, 1, 1) = 'P'::varchar(1)) THEN 'SUPPLIER'::varchar(8) WHEN (("substring"(ILF.INVENTLOCATIONID, 1, 2) = 'T_'::varchar(2)) AND (SA.SUPPLIERTYPE = 'External'::varchar(8))) THEN 'TRANSIT EXTERNAL'::varchar(16) WHEN (("substring"(ILF.INVENTLOCATIONID, 1, 2) = 'T_'::varchar(2)) AND (SA.SUPPLIERTYPE = 'Internal'::varchar(8))) THEN 'TRANSIT INTERCO'::varchar(15) ELSE 'STOCK'::varchar(5) END AS STOCKTYPE, ILF.INVENTLOCATIONIDREQMAIN, ILF.INVENTLOCATIONIDTRANSIT, ILF.INVENTLOCATIONLEVEL, ILF.INVENTLOCATIONTYPE, ILF.INVENTSITEID, ILF.NAME, CASE WHEN ("substring"(ILF.INVENTLOCATIONID, 1, 3) = 'T_P'::varchar(3)) THEN concat('T_'::varchar(2), SA.NAME) ELSE ILF.INVENTLOCATIONID END AS WAREHOUSENAME, ILF.REQCALENDARID, ILF.VENDACCOUNT, ILF.WHSENABLED, ILF.WMSLOCATIONIDDEFAULTISSUE, ILF.WMSLOCATIONIDDEFAULTRECEIPT, ILF.DEFAULTPRODUCTIONINPUTLOCATION, ILF.DATAAREAID, ILF.INVENTVENDORACCOUNT, ILF.ENTITYDEFAULTINVENTLOCATION, ILF.RELEASETOWAREHOUSERULE, CASE WHEN ("substring"(ILF.INVENTLOCATIONID, 1, 2) = 'T_'::varchar(2)) THEN 1 ELSE 0 END AS AUXTRANSIT, CL.COMPANYID FROM ((fersads.ds_InventLocation_FER ILF JOIN fersaParams.CompanyLocation_standalone CL ON ((upper(ILF.DATAAREAID) = CL.LOCATIONID))) LEFT  JOIN fersadv.Supplier_ALL SA ON (((SA.SUBSIDIARYID = CL.LOCATIONID) AND (SA.SUPPLIERID = "substring"(ILF.INVENTLOCATIONID, 3, 8))))) UNION ALL SELECT ISD.INVENTSTATUSID AS DEFAULTSTATUSID, ISD.INVENTLOCATIONID, 'STOCK'::varchar(5) AS STOCKTYPE, NULL AS INVENTLOCATIONIDREQMAIN, NULL AS INVENTLOCATIONIDTRANSIT, NULL AS INVENTLOCATIONLEVEL, NULL AS INVENTLOCATIONTYPE, NULL AS INVENTSITEID, ISD.INVENTLOCATIONID AS NAME, ISD.INVENTLOCATIONID AS WAREHOUSENAME, NULL AS REQCALENDARID, NULL AS VENDACCOUNT, NULL AS WHSENABLED, NULL AS WMSLOCATIONIDDEFAULTISSUE, NULL AS WMSLOCATIONIDDEFAULTRECEIPT, NULL AS DEFAULTPRODUCTIONINPUTLOCATION, ISD.SUBSIDIARYID AS DATAAREAID, NULL AS INVENTVENDORACCOUNT, NULL AS ENTITYDEFAULTINVENTLOCATION, NULL AS RELEASETOWAREHOUSERULE, 0 AS AUXTRANSIT, ISD.COMPANYID FROM fersadv.InventSum_DLX ISD GROUP BY ISD.INVENTLOCATIONID, ISD.SUBSIDIARYID, ISD.INVENTSTATUSID, ISD.COMPANYID) UNION ALL SELECT ISP.INVENTSTATUSID AS DEFAULTSTATUSID, ISP.INVENTLOCATIONID, 'STOCK'::varchar(5) AS STOCKTYPE, NULL AS INVENTLOCATIONIDREQMAIN, NULL AS INVENTLOCATIONIDTRANSIT, NULL AS INVENTLOCATIONLEVEL, NULL AS INVENTLOCATIONTYPE, NULL AS INVENTSITEID, ISP.INVENTLOCATIONID AS NAME, ISP.INVENTLOCATIONID AS WAREHOUSENAME, NULL AS REQCALENDARID, NULL AS VENDACCOUNT, NULL AS WHSENABLED, NULL AS WMSLOCATIONIDDEFAULTISSUE, NULL AS WMSLOCATIONIDDEFAULTRECEIPT, NULL AS DEFAULTPRODUCTIONINPUTLOCATION, ISP.SUBSIDIARYID AS DATAAREAID, NULL AS INVENTVENDORACCOUNT, NULL AS ENTITYDEFAULTINVENTLOCATION, NULL AS RELEASETOWAREHOUSERULE, 0 AS AUXTRANSIT, ISP.COMPANYID FROM fersadv.InventSum_PFI ISP GROUP BY ISP.INVENTLOCATIONID, ISP.SUBSIDIARYID, ISP.INVENTSTATUSID, ISP.COMPANYID) UNION ALL SELECT ISN.INVENTSTATUSID AS DEFAULTSTATUSID, ISN.INVENTLOCATIONID, 'STOCK'::varchar(5) AS STOCKTYPE, NULL AS INVENTLOCATIONIDREQMAIN, NULL AS INVENTLOCATIONIDTRANSIT, NULL AS INVENTLOCATIONLEVEL, NULL AS INVENTLOCATIONTYPE, NULL AS INVENTSITEID, ISN.INVENTLOCATIONID AS NAME, ISN.INVENTLOCATIONID AS WAREHOUSENAME, NULL AS REQCALENDARID, NULL AS VENDACCOUNT, NULL AS WHSENABLED, NULL AS WMSLOCATIONIDDEFAULTISSUE, NULL AS WMSLOCATIONIDDEFAULTRECEIPT, NULL AS DEFAULTPRODUCTIONINPUTLOCATION, ISN.SUBSIDIARYID AS DATAAREAID, NULL AS INVENTVENDORACCOUNT, NULL AS ENTITYDEFAULTINVENTLOCATION, NULL AS RELEASETOWAREHOUSERULE, 0 AS AUXTRANSIT, ISN.COMPANYID FROM fersadv.InventSum_NKE ISN GROUP BY ISN.INVENTLOCATIONID, ISN.SUBSIDIARYID, ISN.INVENTSTATUSID, ISN.COMPANYID) UNION ALL SELECT ISC.INVENTSTATUSID AS DEFAULTSTATUSID, ISC.INVENTLOCATIONID, 'STOCK'::varchar(5) AS STOCKTYPE, NULL AS INVENTLOCATIONIDREQMAIN, NULL AS INVENTLOCATIONIDTRANSIT, NULL AS INVENTLOCATIONLEVEL, NULL AS INVENTLOCATIONTYPE, NULL AS INVENTSITEID, ISC.INVENTLOCATIONID AS NAME, ISC.INVENTLOCATIONID AS WAREHOUSENAME, NULL AS REQCALENDARID, NULL AS VENDACCOUNT, NULL AS WHSENABLED, NULL AS WMSLOCATIONIDDEFAULTISSUE, NULL AS WMSLOCATIONIDDEFAULTRECEIPT, NULL AS DEFAULTPRODUCTIONINPUTLOCATION, ISC.SUBSIDIARYID AS DATAAREAID, NULL AS INVENTVENDORACCOUNT, NULL AS ENTITYDEFAULTINVENTLOCATION, NULL AS RELEASETOWAREHOUSERULE, 0 AS AUXTRANSIT, ISC.COMPANYID FROM fersadv.InventSum_CHN ISC GROUP BY ISC.INVENTLOCATIONID, ISC.SUBSIDIARYID, ISC.INVENTSTATUSID, ISC.COMPANYID;

CREATE  VIEW fersadw.VW_WHSLOCATION EXCLUDE SCHEMA PRIVILEGES AS
SELECT WLF.AISLEID, WLF.DEPTH, WLF.HEIGHT, WLF.INPUTLOCATION, WLF.INVENTLOCATIONID, WLF.LEVEL_, WLF.LOCATIONTYPE, WLF.LOCPROFILEID, WLF."POSITION", WLF.RACK, WLF.SORTCODE, WLF.WMSLOCATIONID, WLF.ZONEID, WLF.DATAAREAID, WZG.ZONEGROUPID, WZG.ZONEGROUPNAME, WZF.ZONENAME, concat(WLF.WMSLOCATIONID, WLF.INVENTLOCATIONID) AS LOCATION_WH FROM ((fersads.ds_WMSLocation_FER WLF LEFT  JOIN fersads.ds_WHSZone_FER WZF ON (((WLF.ZONEID = WZF.ZONEID) AND (WLF.DATAAREAID = WZF.DATAAREAID)))) LEFT  JOIN fersads.ds_WHSZoneGroup_FER WZG ON (((WZF.ZONEGROUPID = WZG.ZONEGROUPID) AND (WZF.DATAAREAID = WZG.DATAAREAID)))) WHERE ("substring"(WLF.WMSLOCATIONID, 1, 2) <> '08'::varchar(2));

CREATE  VIEW fersadw.VW_MAXIBOSALES EXCLUDE SCHEMA PRIVILEGES AS
 SELECT row_number() OVER (ORDER BY MO.LEVEL) AS INTINDEX,
        NULL AS REQGROUPID,
        MO.SLRECID AS REFRECIDEXTENDED,
        MO.GROUPPARENT AS FINISHEDITEMID,
        MO.GROUPPARENTREFID AS PARENTREFID,
        MO.REFID,
        CASE WHEN ("timestampdiff"('day'::varchar(3), MO.REQDATE, MO.FUTURESDATE) > 0) THEN "timestampdiff"('day'::varchar(3), MO.REQDATE, MO.FUTURESDATE) ELSE 0 END AS FUTURESDAYS,
        CASE WHEN (MO.SLPENDINGQTY IS NULL) THEN 0::numeric(18,0) ELSE MO.SLPENDINGQTY END AS SLPENDINGQTY,
        CASE WHEN ((MO.SLPENDINGQTY * MO.SALESUNITPRICE) IS NULL) THEN 0::numeric(18,0) ELSE (MO.SLPENDINGQTY * MO.SALESUNITPRICE) END AS SLPENDINGAMT,
        abs(MO.GROUPPARENTQTY) AS SLQTY,
        MO.LEVEL,
        MO.ITEMID,
        I.CATALOG AS CATALOGNUMBER,
        MO.REFTYPE,
        abs(MO.QTY) AS QTY,
        MO.FUTURESDATE,
        MO.REQDATE,
        abs(MO.REALQTY) AS COVQTY,
        CASE WHEN (MO.CUSTOMERID IS NULL) THEN MO.SUPPLIERID ELSE MO.CUSTOMERID END AS CUSTVENDACCOUNT,
        CASE WHEN (MO.RESERVED IS NULL) THEN 0::numeric(18,0) ELSE abs(MO.RESERVED) END AS SLRESERVEDQTY,
        CASE WHEN (MO.SHIPMENTQTY IS NULL) THEN 'No'::varchar(2) ELSE 'Yes'::varchar(3) END AS SLINSHIPPINGDOC,
        CASE WHEN ((MO.RESERVEDSAMESTYLE - MO.SHIPMENTQTYSTYLE) IS NULL) THEN 0::numeric(18,0) ELSE (abs(MO.RESERVEDSAMESTYLE) - MO.SHIPMENTQTYSTYLE) END AS SLRESERVEDSTOCKWITHOUTSHIPMENT,
        CASE WHEN (MO.AVAILABLE IS NULL) THEN 0::numeric(18,0) ELSE MO.AVAILABLE END AS SLSTOCKAVAIL,
        CASE WHEN (MO.AVAILABLEALLSTYLES IS NULL) THEN 0::numeric(18,0) ELSE (MO.AVAILABLEALLSTYLES - MO.AVAILABLE) END AS SLSTOCKOTHERSTYLES,
        MO.CONFIRMEDDATE,
        MO.INVENTSTYLEID,
        MO.INVENTLOCATIONID,
        MO.SLCURRENCYCODE
 FROM (fersadw.MaxiBOTree_ALL MO JOIN fersadv.Item_ALL I ON ((hash(I.ITEMID, I.SUBSIDIARYID) = hash(MO.ITEMID, MO.SUBSIDIARYID))))
 WHERE (((MO.LEVEL = 0) OR (MO.LEVEL = 1) OR (MO.LEVEL = 2) OR (MO.LEVEL = 3)) AND (MO.GROUPPARENTREFTYPE = 10) AND (MO.SUBSIDIARYID = 'FBEA'::varchar(4)));

CREATE  VIEW fersadw.VW_FACT_SALES_LOSTREFERENCES EXCLUDE SCHEMA PRIVILEGES AS
