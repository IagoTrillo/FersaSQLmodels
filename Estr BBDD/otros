CREATE  VIEW fersadw.VW_MAXIBOTREE EXCLUDE SCHEMA PRIVILEGES AS
SELECT ORIGIN.GROUPID, ORIGIN.ITEMID, ORIGIN.REFTYPE, ORIGIN.REFDESCR, ORIGIN.SUBSIDIARYID, ORIGIN.QTY, ORIGIN.FUTURESDATE, ORIGIN.REQDATE, ORIGIN.REFID, ORIGIN.INVENTDIMID, ORIGIN.CUSTOMERID, ORIGIN.SUPPLIERID, ORIGIN.LEVEL, ORIGIN.PARENTITEMID, ORIGIN.PATH, ORIGIN.GROUPPARENTREFID, ORIGIN.GROUPPARENTQTY, ORIGIN.GROUPPARENTCUSTOMERID, ORIGIN.GROUPPARENT, ORIGIN.GROUPPARENTREQDATE, ORIGIN.GROUPPARENTFUTURESDATE, ORIGIN.BOMQTY, ORIGIN.REQUESTEDQTY, ORIGIN.REALQTY, round(ORIGIN.GLOBALREQ, 2) AS GLOBALREQ, COUNTREFTYPES.REFCOUNT, CASE WHEN (concat(ORIGIN.PATH, '_'::varchar(1)) IN (SELECT substr(MaxiBOTree_SP_ALL.PATH, 1, instr(MaxiBOTree_SP_ALL.PATH, '_'::varchar(1), (-1), 1)) AS "LEFT" FROM fersadw.MaxiBOTree_SP_ALL)) THEN 0 ELSE 1 END AS ISMAXLEVEL, round((ORIGIN.STDUNITCOST * ORIGIN.COSTEXCHANGERATE_EUR), 2) AS STDUNITCOST_EUR, round((ORIGIN.SALESUNITPRICE * ORIGIN.SALESEXCHANGERATE_EUR), 2) AS SALESUNITPRICE_EUR, round((ORIGIN.INFERREDSALESUNITPRICE * ORIGIN.INFSALESUNITPRICEEXCHANGERATE_EUR), 2) AS INFSALESUNITPRICE_EUR, round((ORIGIN.GROUPPARENTSTDUNITCOST * ORIGIN.GROUPPARENTCOSTEXCHANGERATE_EUR), 2) AS GROUPPARENT_STDUNITCOST_EUR, round((ORIGIN.GROUPPARENTSALESUNITPRICE * ORIGIN.GROUPPARENTSALESEXCHANGERATE_EUR), 2) AS GROUPPARENT_SALESUNITPRICE_EUR, round((ORIGIN.GROUPPARENTINFERREDSALESUNITPRICE * ORIGIN.GROUPPARENTINFERREDPRICEEXCHANGERATE_EUR), 2) AS GROUPPARENT_INFSALESUNITPRICE_EUR FROM (fersadw.MaxiBOTree_SP_ALL ORIGIN LEFT  JOIN (SELECT MaxiBOTree_SP_ALL.GROUPID, MaxiBOTree_SP_ALL.REFTYPE, count(*) AS REFCOUNT FROM fersadw.MaxiBOTree_SP_ALL GROUP BY MaxiBOTree_SP_ALL.GROUPID, MaxiBOTree_SP_ALL.REFTYPE) COUNTREFTYPES ON (((ORIGIN.GROUPID = COUNTREFTYPES.GROUPID) AND (ORIGIN.REFTYPE = COUNTREFTYPES.REFTYPE))));

CREATE  VIEW fersadw.VW_FACT_PURCHASE_BUDGET EXCLUDE SCHEMA PRIVILEGES AS
SELECT PurchaseBudgetYearly_ALL.SUBSIDIARYID, PurchaseBudgetYearly_ALL.UNITPRICE, PurchaseBudgetYearly_ALL.ITEMID, PurchaseBudgetYearly_ALL.QTY, PurchaseBudgetYearly_ALL.YEAR AS BUDGET_YEAR, PurchaseBudgetYearly_ALL.CURRENCYCODE, PurchaseBudgetYearly_ALL.SUPPLIERID, PurchaseBudgetYearly_ALL.CUSTOMCOST, PurchaseBudgetYearly_ALL.OTHERCOST, PurchaseBudgetYearly_ALL.TRANSPORTCOST, PurchaseBudgetYearly_ALL.CORRECTIONFACTOR, PurchaseBudgetYearly_ALL.COMPANYID, PurchaseBudgetYearly_ALL.CURRENCYCODE_LOCAL, PurchaseBudgetYearly_ALL.EXCHANGERATE_EUR, PurchaseBudgetYearly_ALL.EXCHANGERATE_USD, PurchaseBudgetYearly_ALL.EXCHANGERATE_LOCAL, (CASE WHEN (INTERCO.CUSTVENDACCOUNT IS NULL) THEN 0 ELSE 1 END)::boolean AS ISINTERCO FROM (fersadv.PurchaseBudgetYearly_ALL LEFT  JOIN (SELECT CustomerVendorInterCo_standalone.CUSTVENDACCOUNT FROM fersaParams.CustomerVendorInterCo_standalone GROUP BY CustomerVendorInterCo_standalone.CUSTVENDACCOUNT) INTERCO ON ((PurchaseBudgetYearly_ALL.SUPPLIERID = INTERCO.CUSTVENDACCOUNT))) WHERE (PurchaseBudgetYearly_ALL.YEAR >= ((date_part('year'::varchar(4), ((now())::date)::timestamp))::int - 2));

CREATE  VIEW fersadw.RF_ROLLINGFORECAST EXCLUDE SCHEMA PRIVILEGES AS
WITH  CustomersAll AS (SELECT CA.SUBSIDIARYID, CA.CUSTOMERID, CF.FERECORESSTYLENAME AS STYLENAME, CA.LINEOFBUSINESS, CA.PRICEGROUP FROM (fersadv.Customer_ALL CA JOIN fersads.ds_Customer_BYOD CF ON ((hash(CA.CUSTOMERID, upper(CA.SUBSIDIARYID)) = hash(CF.ACCOUNTNUM, upper(CF.DATAAREAID)))))),  Items AS (SELECT Item_ALL.CATALOG AS REFCATALOG, Item_ALL.ITEMID, Item_ALL.SUBSIDIARYID FROM fersadv.Item_ALL),  Budget AS (SELECT ds_SalesBudgetHeader_EDC.CustomerId, ds_SalesBudgetHeader_EDC.ItemId, ds_SalesBudgetHeader_EDC.UnitPrice, ds_SalesBudgetHeader_EDC.CurrencyCode, ds_SalesBudgetHeader_EDC.Year AS YEARNUM, ds_SalesBudgetHeader_EDC.LocationId FROM fersads.ds_SalesBudgetHeader_EDC),  SalesFees AS (SELECT SalesPrices_ALL.SUBSIDIARYID, SalesPrices_ALL.CUSTOMERID, SalesPrices_ALL.ITEMID, SalesPrices_ALL.UNITPRICE, SalesPrices_ALL.CURRENCYCODE FROM fersadv.SalesPrices_ALL WHERE ((SalesPrices_ALL.FROMDATE < (now())::timestamptz(6)) AND ((now())::timestamptz(6) < SalesPrices_ALL.TODATE))),  SalesBills AS (SELECT SIA.SUBSIDIARYID, IA.REFCATALOG, CA.LINEOFBUSINESS, avg((SIA.UNITPRICE * SIA.EXCHANGERATE_EUR)) AS UNITPRICE_EUR FROM ((fersadv.SalesInvoices_ALL SIA JOIN  Items IA ON ((hash(SIA.ITEMID, upper(SIA.SUBSIDIARYID)) = hash(IA.ITEMID, upper(IA.SUBSIDIARYID))))) JOIN  CustomersAll CA ON ((hash(SIA.CUSTOMERID, upper(SIA.SUBSIDIARYID)) = hash(CA.CUSTOMERID, upper(CA.SUBSIDIARYID))))) GROUP BY SIA.SUBSIDIARYID, CA.LINEOFBUSINESS, IA.REFCATALOG),  PartNumber AS (SELECT RF.RollingLocationId, RF.CustomerId, RF.ItemId, to_date((concat((RF.Year)::varchar, to_char(RF.Month, '09'::varchar(2))) || '01'::varchar(2)), 'YYYYMMDD'::varchar(8)) AS REQDATE, RF.Year, RF.Quantity, CA.STYLENAME, IA.REFCATALOG, CA.PRICEGROUP, CA.LINEOFBUSINESS AS CUSTOMERGROUP FROM ((fersads.ds_CustomerRollingForecast_EDC RF JOIN  Items IA ON ((hash(RF.ItemId, upper(RF.RollingLocationId)) = hash(IA.ITEMID, upper(IA.SUBSIDIARYID))))) LEFT  JOIN  CustomersAll CA ON ((hash(upper(RF.RollingLocationId), RF.CustomerId) = hash(upper(CA.SUBSIDIARYID), CA.CUSTOMERID)))) WHERE ((upper(RF.RollingLocationId) = 'FBEA'::varchar(4)) AND (RF.Quantity > 0))),  PNBudget AS (SELECT PN.RollingLocationId, PN.CustomerId, PN.CUSTOMERGROUP, PN.ItemId, PN.REQDATE, PN.Quantity, PN.STYLENAME, PN.REFCATALOG, PN.PRICEGROUP, BG.UnitPrice AS UNITPRICE, BG.CurrencyCode AS CURRENCYCODE FROM ( PartNumber PN LEFT  JOIN  Budget BG ON ((hash(PN.CustomerId, PN.ItemId, PN.Year, upper(PN.RollingLocationId)) = hash(BG.CustomerId, BG.ItemId, BG.YEARNUM, upper(BG.LocationId)))))),  PNFeesCustomer AS (SELECT PNB.RollingLocationId, PNB.CustomerId, PNB.CUSTOMERGROUP, PNB.ItemId, PNB.REQDATE, PNB.Quantity, PNB.STYLENAME, PNB.REFCATALOG, PNB.PRICEGROUP, SF.UNITPRICE, SF.CURRENCYCODE FROM ( PNBudget PNB LEFT  JOIN  SalesFees SF ON ((hash(upper(PNB.RollingLocationId), PNB.ItemId, PNB.CustomerId) = hash(upper(SF.SUBSIDIARYID), SF.ITEMID, SF.CUSTOMERID)))) WHERE (PNB.UNITPRICE IS NULL)),  PNFeesPricegroup AS (SELECT PNFC.RollingLocationId, PNFC.CustomerId, PNFC.CUSTOMERGROUP, PNFC.ItemId, PNFC.REQDATE, PNFC.Quantity, PNFC.STYLENAME, PNFC.REFCATALOG, PNFC.PRICEGROUP, SF.UNITPRICE, SF.CURRENCYCODE FROM ( PNFeesCustomer PNFC LEFT  JOIN  SalesFees SF ON ((hash(upper(PNFC.RollingLocationId), PNFC.ItemId, PNFC.PRICEGROUP) = hash(upper(SF.SUBSIDIARYID), SF.ITEMID, SF.CUSTOMERID)))) WHERE (PNFC.UNITPRICE IS NULL)),  PNBills AS (SELECT PNFP.RollingLocationId, PNFP.CustomerId, PNFP.CUSTOMERGROUP, PNFP.ItemId, PNFP.REQDATE, PNFP.Quantity, PNFP.STYLENAME, PNFP.REFCATALOG, PNFP.PRICEGROUP, SB.UNITPRICE_EUR AS UNITPRICE, 'EUR'::varchar(3) AS CURRENCYCODE FROM ( PNFeesPricegroup PNFP LEFT  JOIN  SalesBills SB ON ((hash(upper(PNFP.RollingLocationId), PNFP.CUSTOMERGROUP, PNFP.REFCATALOG) = hash(upper(SB.SUBSIDIARYID), SB.LINEOFBUSINESS, SB.REFCATALOG)))) WHERE (PNFP.UNITPRICE IS NULL)),  PNBudgetFiltered AS (SELECT PNBudget.RollingLocationId, PNBudget.CustomerId, PNBudget.CUSTOMERGROUP, PNBudget.ItemId, PNBudget.REQDATE, PNBudget.Quantity, PNBudget.STYLENAME, PNBudget.REFCATALOG, PNBudget.PRICEGROUP, PNBudget.UNITPRICE, PNBudget.CURRENCYCODE FROM  PNBudget WHERE (PNBudget.UNITPRICE IS NOT NULL)),  PNFeesCustomerFiltered AS (SELECT PNFeesCustomer.RollingLocationId, PNFeesCustomer.CustomerId, PNFeesCustomer.CUSTOMERGROUP, PNFeesCustomer.ItemId, PNFeesCustomer.REQDATE, PNFeesCustomer.Quantity, PNFeesCustomer.STYLENAME, PNFeesCustomer.REFCATALOG, PNFeesCustomer.PRICEGROUP, PNFeesCustomer.UNITPRICE, PNFeesCustomer.CURRENCYCODE FROM  PNFeesCustomer WHERE (PNFeesCustomer.UNITPRICE IS NOT NULL)),  PNFeesPricegroupFiltered AS (SELECT PNFeesPricegroup.RollingLocationId, PNFeesPricegroup.CustomerId, PNFeesPricegroup.CUSTOMERGROUP, PNFeesPricegroup.ItemId, PNFeesPricegroup.REQDATE, PNFeesPricegroup.Quantity, PNFeesPricegroup.STYLENAME, PNFeesPricegroup.REFCATALOG, PNFeesPricegroup.PRICEGROUP, PNFeesPricegroup.UNITPRICE, PNFeesPricegroup.CURRENCYCODE FROM  PNFeesPricegroup),  TableUnion AS (((SELECT PNBudgetFiltered.RollingLocationId, PNBudgetFiltered.CustomerId, PNBudgetFiltered.ItemId, PNBudgetFiltered.REFCATALOG, PNBudgetFiltered.REQDATE, PNBudgetFiltered.Quantity, PNBudgetFiltered.UNITPRICE, (PNBudgetFiltered.Quantity * PNBudgetFiltered.UNITPRICE) AS Amount, PNBudgetFiltered.CURRENCYCODE, PNBudgetFiltered.STYLENAME FROM  PNBudgetFiltered UNION ALL SELECT PNFeesCustomerFiltered.RollingLocationId, PNFeesCustomerFiltered.CustomerId, PNFeesCustomerFiltered.ItemId, PNFeesCustomerFiltered.REFCATALOG, PNFeesCustomerFiltered.REQDATE, PNFeesCustomerFiltered.Quantity, PNFeesCustomerFiltered.UNITPRICE, (PNFeesCustomerFiltered.Quantity * PNFeesCustomerFiltered.UNITPRICE) AS Amount, PNFeesCustomerFiltered.CURRENCYCODE, PNFeesCustomerFiltered.STYLENAME FROM  PNFeesCustomerFiltered) UNION ALL SELECT PNFeesPricegroupFiltered.RollingLocationId, PNFeesPricegroupFiltered.CustomerId, PNFeesPricegroupFiltered.ItemId, PNFeesPricegroupFiltered.REFCATALOG, PNFeesPricegroupFiltered.REQDATE, PNFeesPricegroupFiltered.Quantity, PNFeesPricegroupFiltered.UNITPRICE, (PNFeesPricegroupFiltered.Quantity * PNFeesPricegroupFiltered.UNITPRICE) AS Amount, PNFeesPricegroupFiltered.CURRENCYCODE, PNFeesPricegroupFiltered.STYLENAME FROM  PNFeesPricegroupFiltered) UNION ALL SELECT PNBills.RollingLocationId, PNBills.CustomerId, PNBills.ItemId, PNBills.REFCATALOG, PNBills.REQDATE, PNBills.Quantity, PNBills.UNITPRICE, (PNBills.Quantity * PNBills.UNITPRICE) AS Amount, PNBills.CURRENCYCODE, PNBills.STYLENAME FROM  PNBills),  Final AS (SELECT TableUnion.RollingLocationId, TableUnion.CustomerId, TableUnion.ItemId, TableUnion.REFCATALOG, TableUnion.REQDATE, TableUnion.Quantity, TableUnion.UNITPRICE, TableUnion.Amount, TableUnion.CURRENCYCODE, TableUnion.STYLENAME FROM  TableUnion WHERE ((date_trunc('MONTH'::varchar(5), (now())::timestamptz(6)) <= TableUnion.REQDATE) AND (TableUnion.REQDATE < date_trunc('MONTH'::varchar(5), add_months((now())::timestamptz(6), 12))))) SELECT Final.RollingLocationId, Final.CustomerId, Final.ItemId, Final.REFCATALOG, Final.REQDATE, Final.Quantity, Final.UNITPRICE, Final.Amount, Final.CURRENCYCODE, Final.STYLENAME FROM  Final;

