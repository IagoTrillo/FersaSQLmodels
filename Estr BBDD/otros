se_PY_ALL.EXCHANGERATE_LOCAL, 0 AS PURCHCOSTS, 0 AS INTERCOCOSTS, 0 AS SUBVENDORCOSTS FROM fersadv.BOMCostsPurchase_PY_ALL WHERE (BOMCostsPurchase_PY_ALL.COSTNAME IS NULL)) SELECT BC1.COMPANYID, BC1.SUBSIDIARYID, BC1.BOMITEMIDORDERTYPE, BC1.LEVEL, BC1.ITEMID, BC1.BOMITEMID, BC1.BOMQTY, BC1.UNITID, BC1.SUPPLIERID, BC1.SUPPLIERNAME, BC1.CURRENCYCODE, BC1.PURCHCOSTS, BC1.INTERCOCOSTS, BC1.COSTNAME, BC2.SUBVENDORID, BC2.SUBVENDORNAME, BC2.SUBSIDIARYID_SUBVENDOR, BC2.CURRENCYCODE AS SUBVENDOR_CURRENCYCODE, CASE WHEN (BC1.LEVEL = 0) THEN BC1.SUBVENDORCOSTS ELSE BC2.SUBVENDORCOSTS END AS SUBVENDORCOSTS FROM ( Q BC1 LEFT  JOIN (SELECT Q.ITEMID, Q.BOMTYPE, Q.BOMQTY, Q.UNITID, Q.PMFPLANGROUPID, Q.PRIORITY, Q.SUBSIDIARYID, Q.ACTIVE, Q.APPROVED, Q.BOMITEMID, Q.COMPANYID, Q.LEVEL, Q.PATH, Q.PARENTBOMITEMID, Q.BOMITEMIDORDERTYPE AS ORDERTYPE, Q.SUPPLIERID, Q.CURRENCYCODE, Q.ISPRIMARYSUPPLIER, Q.COSTNAME, Q.SUPPLIERNAME, Q.SUBVENDORID, Q.SUBVENDORNAME, Q.SUBSIDIARYID_SUBVENDOR, Q.ISPRIMARYSUBVENDOR, Q.PURCHCOSTS, Q.INTERCOCOSTS, Q.SUBVENDORCOSTS FROM  Q WHERE ((Q.SUBVENDORID IS NOT NULL) AND (Q.ISPRIMARYSUBVENDOR = true))) BC2 ON (((BC2.SUBSIDIARYID = BC1.SUBSIDIARYID) AND (BC2.PARENTBOMITEMID = BC1.PARENTBOMITEMID) AND (BC2.PATH = BC1.PATH)))) WHERE (((coalesce(BC1.COSTNAME, ''::varchar) <> 'SUBVENDOR_UNITPRICE'::varchar(19)) AND (BC1.BOMITEMIDORDERTYPE = 0)) OR (BC1.LEVEL = 0)) ORDER BY BC1.COMPANYID, BC1.SUBSIDIARYID, BC1.PARENTBOMITEMID, BC1.BOMITEMID, BC1.LEVEL;

CREATE  VIEW fersadw.VW_REQ_SALES EXCLUDE SCHEMA PRIVILEGES AS
WITH  REQ AS ( SELECT rtsa.SUBSIDIARYID,
        bpssa.BOMITEMID,
        bpssa.ITEMID,
        rtsa.CUSTVENDACCOUNT,
        (sum(rtsa.QTY) * sum(bpssa.BOMREALQTY)) AS REQQTY,
        sum(ISUM.PHYSICALINVENT) AS PHYSICALINVENT
 FROM ((fersadv.BOMTreeSust_ALL bpssa JOIN ( SELECT InventSum_ALL.SUBSIDIARYID,
        InventSum_ALL.ITEMID,
        sum(InventSum_ALL.PHYSICALINVENT) AS PHYSICALINVENT
 FROM fersadv.InventSum_ALL
 WHERE ((InventSum_ALL.INVENTLOCATIONID !~~ 'T_P%'::varchar(4)) AND (InventSum_ALL.PHYSICALINVENT > 0::numeric(18,0)))
 GROUP BY InventSum_ALL.SUBSIDIARYID,
          InventSum_ALL.ITEMID) ISUM ON ((hash(bpssa.SUBSIDIARYID, bpssa.BOMITEMID) = hash(ISUM.SUBSIDIARYID, ISUM.ITEMID)))) JOIN fersadv.ReqTrans_ALL rtsa ON ((hash(bpssa.SUBSIDIARYID, bpssa.ITEMID) = hash(rtsa.SUBSIDIARYID, rtsa.ITEMID))))
 WHERE (rtsa.REFTYPE = 10)
 GROUP BY rtsa.SUBSIDIARYID,
          bpssa.BOMITEMID,
          bpssa.ITEMID,
          rtsa.CUSTVENDACCOUNT)
  SELECT REQ.SUBSIDIARYID,
        REQ.BOMITEMID,
        REQ.ITEMID,
        REQ.CUSTVENDACCOUNT,
        REQ.REQQTY,
        TOT.REQQTY_TOT,
        ((REQ.REQQTY * STDCOSTS.UNITPRICE) * exRateD365_EUR.EXCHANGERATE) AS REQQTY_EUR,
        ((TOT.REQQTY_TOT * STDCOSTS.UNITPRICE) * exRateD365_EUR.EXCHANGERATE) AS REQQTY_TOT_EUR,
        ((REQ.PHYSICALINVENT * STDCOSTS.UNITPRICE) * exRateD365_EUR.EXCHANGERATE) AS PHYSICALINVENT_EUR
 FROM (((( REQ LEFT  JOIN ( SELECT REQ.SUBSIDIARYID,
        REQ.BOMITEMID,
        sum(REQ.REQQTY) AS REQQTY_TOT,
        sum(REQ.PHYSICALINVENT) AS sum
 FROM  REQ
 GROUP BY REQ.SUBSIDIARYID,
          REQ.BOMITEMID) TOT ON ((hash(REQ.SUBSIDIARYID, REQ.BOMITEMID) = hash(TOT.SUBSIDIARYID, TOT.BOMITEMID)))) LEFT  JOIN ( SELECT StandardCosts_ALL.ITEMID,
        StandardCosts_ALL.SUBSIDIARYID,
        StandardCosts_ALL.UNITPRICE
 FROM fersadv.StandardCosts_ALL) STDCOSTS ON (((STDCOSTS.ITEMID = REQ.ITEMID) AND (STDCOSTS.SUBSIDIARYID = REQ.SUBSIDIARYID)))) LEFT  JOIN fersaParams.CompanyLocation_standalone LOCS ON ((REQ.SUBSIDIARYID = LOCS.LOCATIONID))) LEFT  JOIN fersadv.ExchangeRateDaily_ALL exRateD365_EUR ON (((exRateD365_EUR.FROMCURRENCYCODE = LOCS.CURRENCYCODE) AND (exRateD365_EUR.ERPSOURCE = 'D365'::varchar(4)) AND (exRateD365_EUR.TOCURRENCYCODE = 'EUR'::varchar(3)) AND (exRateD365_EUR.VALIDFROM = last_day(add_months(now(), (-1)))))));

