 FROM fersadw.PurchasingFillRate_SP FR
 WHERE ((FR.SHIPDATE >= "timestampadd"('day'::varchar(3), (-7), FR.EXPECTEDSHIPDATE)) AND (FR.SHIPDATE <= "timestampadd"('day'::varchar(3), 7, FR.EXPECTEDSHIPDATE)) AND ((date_part('year'::varchar(4), FR.EXPECTEDSHIPDATE))::int <> 1900) AND (FR.REFERENCE = 'DISPATCH'::varchar(8)))
 GROUP BY FR.COMPANYID,
