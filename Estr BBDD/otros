CREATE  VIEW fersadw.VW_FACT_RECEIPT_PENDING EXCLUDE SCHEMA PRIVILEGES AS
 SELECT row_number() OVER (PARTITION BY PURCHLINES.INVENTTRANSID, PURCHLINES.ITEMID) AS DOCUMENTID,
        PURCHLINES.COMPANYID,
        PURCHLINES.SUBSIDIARYID,
        PURCHLINES.SUPPLIERID,
        PURCHLINES.PURCHASEID,
        PURCHLINES.INVENTTRANSID,
        PURCHLINES.ITEMID,
        PURCHLINES.CURRENCYCODE,
        PURCHLINES.RECEPTIONDATE,
        PURCHLINES.STATUS,
        PURCHLINES.PENDINGQTY,
        PURCHLINES.PENDINGAMOUNT,
        PURCHLINES.PENDINGAMOUNT_EUR,
        PURCHLINES.PENDINGAMOUNT_USD,
        (CASE WHEN (INTERCO.CUSTVENDACCOUNT IS NULL) THEN 0 ELSE 1 END)::boolean AS ISINTERCO
 FROM (( SELECT PL.COMPANYID,
        PL.SUBSIDIARYID,
        PL.SUPPLIERID,
        PL.PURCHASEID,
        PL.INVENTTRANSID,
        PL.ITEMID,
        PL.CURRENCYCODE,
        CASE WHEN ((date_part('year'::varchar(4), PL.CONFIRMEDDATE))::int < 2000) THEN PL.DELIVERYDATE ELSE PL.CONFIRMEDDATE END AS RECEPTIONDATE,
        CASE WHEN ((date_part('year'::varchar(4), PL.CONFIRMEDDATE))::int < 2000) THEN 'PENDING'::varchar(7) ELSE 'CONFIRMED'::varchar(9) END AS STATUS,
        sum(PL.PENDINGQTY) AS PENDINGQTY,
        (sum((PL.PENDINGQTY * (PL.UNITPRICE / CASE WHEN (PL.PRICEUNIT = 0::numeric(18,0)) THEN 1::numeric(18,0) WHEN (PL.PRICEUNIT IS NULL) THEN 1::numeric(18,0) ELSE PL.PRICEUNIT END))))::numeric(18,2) AS PENDINGAMOUNT,
        (sum(((PL.PENDINGQTY * (PL.UNITPRICE / CASE WHEN (PL.PRICEUNIT = 0::numeric(18,0)) THEN 1::numeric(18,0) WHEN (PL.PRICEUNIT IS NULL) THEN 1::numeric(18,0) ELSE PL.PRICEUNIT END)) * PL.EXCHANGERATE_EUR)))::numeric(18,2) AS PENDINGAMOUNT_EUR,
        (sum(((PL.PENDINGQTY * (PL.UNITPRICE / CASE WHEN (PL.PRICEUNIT = 0::numeric(18,0)) THEN 1::numeric(18,0) WHEN (PL.PRICEUNIT IS NULL) THEN 1::numeric(18,0) ELSE PL.PRICEUNIT END)) * PL.EXCHANGERATE_USD)))::numeric(18,2) AS PENDINGAMOUNT_USD
 FROM fersadv.PurchaseLines_ALL PL
 WHERE (PL.PENDINGQTY > 0::numeric(18,0))
 GROUP BY PL.SUBSIDIARYID,
          PL.PURCHASEID,
          PL.INVENTTRANSID,
          PL.ITEMID,
          PL.CURRENCYCODE,
          PL.CONFIRMEDDATE,
          PL.DELIVERYDATE,
          PL.COMPANYID,
          PL.SUPPLIERID) PURCHLINES LEFT  JOIN ( SELECT CustomerVendorInterCo_standalone.CUSTVENDACCOUNT
 FROM fersaParamsPublic.CustomerVendorInterCo_standalone
 GROUP BY CustomerVendorInterCo_standalone.CUSTVENDACCOUNT) INTERCO ON ((PURCHLINES.SUPPLIERID = INTERCO.CUSTVENDACCOUNT)));

CREATE  VIEW fersadw.VW_FACT_RECEIPT_TRANSIT EXCLUDE SCHEMA PRIVILEGES AS
 SELECT row_number() OVER (PARTITION BY PURCH.INVENTTRANSID, PURCH.ITEMID) AS DOCUMENTID,
        PURCH.COMPANYID,
        PURCH.SUBSIDIARYID,
        PURCH.PURCHASEID,
        PURCH.SUPPLIERID,
        PURCH.INVENTTRANSID,
        PURCH.ITEMID,
        PURCH.CURRENCYCODE,
        PURCH.RECEPTIONDATE,
        PURCH.UNITPRICE,
        PURCH.PRICEUNIT,
        PURCH.TRANSITQTY,
        PURCH.TRANSITAMOUNT,
        PURCH.TRANSITAMOUNT_EUR,
        PURCH.TRANSITAMOUNT_USD,
        (CASE WHEN (INTERCO.CUSTVENDACCOUNT IS NULL) THEN 0 ELSE 1 END)::boolean AS ISINTERCO
 FROM (( SELECT PL.COMPANYID,
        PL.SUBSIDIARYID,
        PL.PURCHASEID,
        PL.SUPPLIERID,
        IVT.FERPURCHINVENTREFTRANSID AS INVENTTRANSID,
        IVT.ITEMID,
        PL.CURRENCYCODE,
        (IVT.RECEIVEDATE)::timestamp AS RECEPTIONDATE,
        PL.UNITPRICE,
        PL.PRICEUNIT,
        sum(IVT.QTYREMAINRECEIVE) AS TRANSITQTY,
        (sum((IVT.QTYREMAINRECEIVE * (PL.UNITPRICE / CASE WHEN (PL.PRICEUNIT = 0::numeric(18,0)) THEN 1::numeric(18,0) WHEN (PL.PRICEUNIT IS NULL) THEN 1::numeric(18,0) ELSE PL.PRICEUNIT END))))::numeric(18,2) AS TRANSITAMOUNT,
        (sum(((IVT.QTYREMAINRECEIVE * (PL.UNITPRICE / CASE WHEN (PL.PRICEUNIT = 0::numeric(18,0)) THEN 1::numeric(18,0) WHEN (PL.PRICEUNIT IS NULL) THEN 1::numeric(18,0) ELSE PL.PRICEUNIT END)) * PL.EXCHANGERATE_EUR)))::numeric(18,2) AS TRANSITAMOUNT_EUR,
        (sum(((IVT.QTYREMAINRECEIVE * (PL.UNITPRICE / CASE WHEN (PL.PRICEUNIT = 0::numeric(18,0)) THEN 1::numeric(18,0) WHEN (PL.PRICEUNIT IS NULL) THEN 1::numeric(18,0) ELSE PL.PRICEUNIT END)) * PL.EXCHANGERATE_USD)))::numeric(18,2) AS TRANSITAMOUNT_USD
 FROM (fersadv.InventTransferLine_FER IVT JOIN fersadv.PurchaseLines_ALL PL ON (((PL.INVENTTRANSID = IVT.FERPURCHINVENTREFTRANSID) AND (PL.SUBSIDIARYID = IVT.SUBSIDIARYID))))
 WHERE (((date_part('year'::varchar(4), (IVT.RECEIVEDATE)::timestamp))::int > ((date_part('year'::varchar(4), ((now())::date)::timestamp))::int - 3)) AND (IVT.QTYREMAINRECEIVE > 0::numeric(18,0)))
 GROUP BY PL.SUBSIDIARYID,
          PL.PURCHASEID,
          IVT.FERPURCHINVENTREFTRANSID,
          IVT.ITEMID,
          PL.CURRENCYCODE,
          IVT.RECEIVEDATE,
          PL.COMPANYID,
          PL.SUPPLIERID,
          PL.UNITPRICE,
          PL.PRICEUNIT) PURCH LEFT  JOIN ( SELECT CustomerVendorInterCo_standalone.CUSTVENDACCOUNT
 FROM fersaParamsPublic.CustomerVendorInterCo_standalone
 GROUP BY CustomerVendorInterCo_standalone.CUSTVENDACCOUNT) INTERCO ON ((PURCH.SUPPLIERID = INTERCO.CUSTVENDACCOUNT)));

CREATE  VIEW fersadw.VW_FACT_SALES_ORDERS EXCLUDE SCHEMA PRIVILEGES AS
WITH  Q AS ( SELECT VV.COMPANYID,
        VV.SUBSIDIARYID,
        VV.INVENTTRANSID,
        VV.RECID,
        hash(VV.COMPANYID, VV.SUBSIDIARYID, VV.CUSTOMERID) AS ID_Customer,
        VV.CUSTOMERID,
        VV.SALESID,
        VV.SALESQTY,
        VV.PENDINGQTY,
        VV.CURRENCYCODE,
        VV.UNITPRICE,
        VV.ITEMID,
        CASE WHEN ((date_part('year'::varchar(4), VV.CONFIRMEDDATE))::int < 2000) THEN VV.REQUESTEDDATE ELSE VV.CONFIRMEDDATE END AS CONFIRMEDDATE,
        coalesce(VV.REQUESTEDDATE, VV.SALESDATE) AS REQUESTEDDATE,
        date_trunc('DAY'::varchar(3), VV.SALESDATE) AS SALESDATE,
        VV.SALES_AMOUNT,
        VV.SALES_AMOUNT_EUR,
        VV.SALES_AMOUNT_USD,
        VV.PENDING_AMOUNT,
        VV.PENDING_AMOUNT_EUR,
        VV.PENDING_AMOUNT_USD
 FROM ( SELECT SL.COMPANYID,
        SL.SUBSIDIARYID,
        SL.INVENTTRANSID,
        SL.RECID,
        SL.CUSTOMERID,
        SL.SALESID,
        SL.SALESQTY,
        SL.PENDINGQTY,
        SL.CURRENCYCODE,
        SL.UNITPRICE,
        SL.ITEMID,
        CASE WHEN ((date_part('year'::varchar(4), SL.CONFIRMEDDATE))::int < 2000) THEN SL.CONFIRMEDDATEEXTENDED ELSE SL.CONFIRMEDDATE END AS CONFIRMEDDATE,
        CASE WHEN ((date_part('year'::varchar(4), SL.REQUESTEDDATE))::int < 2000) THEN SL.SALESDATE ELSE SL.REQUESTEDDATE END AS REQUESTEDDATE,
        SL.SALESDATE,
        SL.AMOUNT AS SALES_AMOUNT,
        (SL.AMOUNT * SL.EXCHANGERATE_EUR) AS SALES_AMOUNT_EUR,
        (SL.AMOUNT * SL.EXCHANGERATE_USD) AS SALES_AMOUNT_USD,
        CASE WHEN ((SL.PENDINGQTY > 0::numeric(18,0)) AND (SL.SALESQTY > 0::numeric(18,0))) THEN ((SL.AMOUNT / SL.SALESQTY) * SL.PENDINGQTY) ELSE 0::numeric(18,0) END AS PENDING_AMOUNT,
        CASE WHEN ((SL.PENDINGQTY > 0::numeric(18,0)) AND (SL.SALESQTY > 0::numeric(18,0))) THEN (((SL.AMOUNT / SL.SALESQTY) * SL.PENDINGQTY) * SL.EXCHANGERATE_EUR) ELSE 0::numeric(18,0) END AS PENDING_AMOUNT_EUR,
        CASE WHEN ((SL.PENDINGQTY > 0::numeric(18,0)) AND (SL.SALESQTY > 0::numeric(18,0))) THEN (((SL.AMOUNT / SL.SALESQTY) * SL.PENDINGQTY) * SL.EXCHANGERATE_USD) ELSE 0::numeric(18,0) END AS PENDING_AMOUNT_USD
 FROM ((fersadv.SalesLines_ALL SL LEFT  JOIN fersadv.Customer_ALL csa ON ((((csa.CUSTOMERID = SL.CUSTOMERID) AND (csa.COMPANYID = SL.COMPANYID)) AND (csa.SUBSIDIARYID = SL.SUBSIDIARYID)))) LEFT  JOIN fersadv.Item_ALL isa ON ((((isa.COMPANYID = SL.COMPANYID) AND (isa.ITEMID = SL.ITEMID)) AND (isa.SUBSIDIARYID = SL.SUBSIDIARYID))))
 WHERE (((SL.SALESSTATUS <> 'Canceled'::varchar(8)) AND ((SL.SALESTYPE <> 6) OR (SL.SALESTYPE IS NULL))) AND ((date_part('year'::varchar(4), SL.SALESDATE))::int >= ((date_part('year'::varchar(4), ((now())::date)::timestamp))::int - 3)))) VV)
  SELECT Q.COMPANYID,
        Q.SUBSIDIARYID,
        Q.INVENTTRANSID,
        Q.RECID,
        Q.ID_Customer,
        Q.CUSTOMERID,
        Q.SALESID,
        Q.SALESQTY,
        Q.PENDINGQTY,
        Q.CURRENCYCODE,
        Q.UNITPRICE,
        Q.ITEMID,
        Q.CONFIRMEDDATE,
        Q.REQUESTEDDATE,
        Q.SALESDATE,
        Q.SALES_AMOUNT,
        Q.SALES_AMOUNT_EUR,
        Q.SALES_AMOUNT_USD,
        Q.PENDING_AMOUNT,
        Q.PENDING_AMOUNT_EUR,
        Q.PENDING_AMOUNT_USD,
        Q.CONFIRMEDDATE AS TRANS_DATE
 FROM  Q
 WHERE (Q.CONFIRMEDDATE >= Q.SALESDATE);

CREATE  VIEW fersadw.VW_FACT_SALES_CUSTOMER_ABC EXCLUDE SCHEMA PRIVILEGES AS
WITH  CustTable AS ( SELECT CA.COMPANYID,
        CA.CUSTOMERID,
        upper(CA.CUSTOMERGROUPNAME) AS CUSTOMERGROUPNAME,
        row_number() OVER (PARTITION BY CA.COMPANYID, CA.CUSTOMERID) AS CG_ROWNUM
 FROM fersadv.Customer_ALL CA
 WHERE (CA.CUSTOMERTYPE = 'EXTERNAL'::varchar(8))
 GROUP BY CA.COMPANYID,
          CA.CUSTOMERID,
          upper(CA.CUSTOMERGROUPNAME)),  CustomerSector AS ( SELECT upper(CA2.CUSTOMERGROUPNAME) AS CUSTOMERGROUPNAME,
        CA2.SECTOR AS CUSTOMERGROUPSECTOR,
        (date_part('year'::varchar(4), SIA.INVOICEDATE))::int AS INVOICEYEAR,
        (date_part('month'::varchar(5), SIA.INVOICEDATE))::int AS INVOICEMONTH,
        sum((SIA.AMOUNT * SIA.EXCHANGERATE_EUR)) AS CGAMOUNT_EUR
 FROM ((fersadv.SalesInvoices_ALL SIA LEFT  JOIN fersadv.Customer_ALL CA2 ON (((SIA.CUSTOMERID = CA2.CUSTOMERID) AND (SIA.COMPANYID = CA2.COMPANYID)))) LEFT  JOIN fersaParamsPublic.CustomerVendorInterCo_standalone CVIS ON (((CVIS.CUSTVENDACCOUNT = SIA.INVOICEACCOUNT) AND (CVIS.FROMDATAAREAID = SIA.SUBSIDIARYID))))
 WHERE ((CVIS.CUSTVENDACCOUNT IS NULL) AND (CA2.CUSTOMERTYPE = 'EXTERNAL'::varchar(8)))
 GROUP BY CA2.CUSTOMERGROUPNAME,
          CA2.SECTOR,
          (date_part('year'::varchar(4), SIA.INVOICEDATE))::int,
          (date_part('month'::varchar(5), SIA.INVOICEDATE))::int),  CustomerLOB AS ( SELECT upper(CA2.CUSTOMERGROUPNAME) AS CUSTOMERGROUPNAME,
        CA2.LINEOFBUSINESS AS CUSTOMERGROUPLOB,
        (date_part('year'::varchar(4), SIA.INVOICEDATE))::int AS INVOICEYEAR,
        (date_part('month'::varchar(5), SIA.INVOICEDATE))::int AS INVOICEMONTH,
        sum((SIA.AMOUNT * SIA.EXCHANGERATE_EUR)) AS CGAMOUNT_EUR
 FROM ((fersadv.SalesInvoices_ALL SIA LEFT  JOIN fersadv.Customer_ALL CA2 ON (((SIA.CUSTOMERID = CA2.CUSTOMERID) AND (SIA.COMPANYID = CA2.COMPANYID)))) LEFT  JOIN fersaParamsPublic.CustomerVendorInterCo_standalone CVIS ON (((CVIS.CUSTVENDACCOUNT = SIA.INVOICEACCOUNT) AND (CVIS.FROMDATAAREAID = SIA.SUBSIDIARYID))))
 WHERE ((CVIS.CUSTVENDACCOUNT IS NULL) AND (CA2.CUSTOMERTYPE = 'EXTERNAL'::varchar(8)))
 GROUP BY CA2.CUSTOMERGROUPNAME,
          CA2.LINEOFBUSINESS,
          (date_part('year'::varchar(4), SIA.INVOICEDATE))::int,
          (date_part('month'::varchar(5), SIA.INVOICEDATE))::int),  SalesInvoicesCustomer AS ( SELECT CA.CUSTOMERGROUPNAME,
        CS.CUSTOMERGROUPSECTOR,
        CS.ROWNUM,
        CL.CUSTOMERGROUPLOB,
        (date_part('year'::varchar(4), SIA.INVOICEDATE))::int AS INVOICEYEAR,
        (date_part('month'::varchar(5), SIA.INVOICEDATE))::int AS INVOICEMONTH,
        sum((SIA.AMOUNT * SIA.EXCHANGERATE_EUR)) AS AMOUNT_EUR,
        sum((SIA.AMOUNT * SIA.EXCHANGERATE_USD)) AS AMOUNT_USD,
        sum(((SIA.INVOICEQTY * SIA.UNITCOST) * SIA.COSTEXCHANGERATE_EUR)) AS COSTAMOUNT_EUR,
        sum(((SIA.INVOICEQTY * SIA.UNITCOST) * SIA.COSTEXCHANGERATE_USD)) AS COSTAMOUNT_USD
 FROM (((((fersadv.SalesInvoices_ALL SIA LEFT  JOIN fersaParamsPublic.CustomerVendorInterCo_standalone CVIS ON (((CVIS.CUSTVENDACCOUNT = SIA.INVOICEACCOUNT) AND (CVIS.FROMDATAAREAID = SIA.SUBSIDIARYID)))) LEFT  JOIN ( SELECT CT.CUSTOMERGROUPNAME,
        CT.CUSTOMERID,
        CT.COMPANYID
 FROM  CustTable CT
 WHERE (CT.CG_ROWNUM = 1)
 GROUP BY CT.CUSTOMERGROUPNAME,
          CT.CUSTOMERID,
          CT.COMPANYID) CA ON (((SIA.CUSTOMERID = CA.CUSTOMERID) AND (SIA.COMPANYID = CA.COMPANYID)))) LEFT  JOIN ( SELECT CS.CUSTOMERGROUPNAME,
        CS.CUSTOMERGROUPSECTOR,
        CS.INVOICEYEAR,
        CS.INVOICEMONTH,
        row_number() OVER (PARTITION BY CS.CUSTOMERGROUPNAME, CS.INVOICEYEAR, CS.INVOICEMONTH ORDER BY CS.CGAMOUNT_EUR DESC) AS ROWNUM
 FROM  CustomerSector CS) CS ON (((((CS.CUSTOMERGROUPNAME = CA.CUSTOMERGROUPNAME) AND (CS.ROWNUM = 1)) AND (CS.INVOICEYEAR = (date_part('year'::varchar(4), SIA.INVOICEDATE))::int)) AND (CS.INVOICEMONTH = (date_part('month'::varchar(5), SIA.INVOICEDATE))::int)))) LEFT  JOIN ( SELECT CL.CUSTOMERGROUPNAME,
        CL.CUSTOMERGROUPLOB,
        CL.INVOICEYEAR,
        CL.INVOICEMONTH,
        row_number() OVER (PARTITION BY CL.CUSTOMERGROUPNAME, CL.INVOICEYEAR, CL.INVOICEMONTH ORDER BY CL.CGAMOUNT_EUR DESC) AS ROWNUMLOB
 FROM  CustomerLOB CL) CL ON (((((CL.CUSTOMERGROUPNAME = CA.CUSTOMERGROUPNAME) AND (CL.ROWNUMLOB = 1)) AND (CL.INVOICEYEAR = (date_part('year'::varchar(4), SIA.INVOICEDATE))::int)) AND (CL.INVOICEMONTH = (date_part('month'::varchar(5), SIA.INVOICEDATE))::int)))) JOIN fersadv.Item_ALL IA ON ((((((IA.SUBSIDIARYID = SIA.SUBSIDIARYID) AND (IA.ITEMID = SIA.ITEMID)) AND (IA.ITEMTYPE = 0)) AND ((IA.SBU <> 'INCREMENTOS'::varchar(11)) OR (IA.SBU IS NULL))) AND (IA.ITEMID !~~ '000Tt%'::varchar(6)))))
 WHERE (CVIS.CUSTVENDACCOUNT IS NULL)
 GROUP BY CA.CUSTOMERGROUPNAME,
          CS.CUSTOMERGROUPSECTOR,
          CS.ROWNUM,
          CL.CUSTOMERGROUPLOB,
          (date_part('year'::varchar(4), SIA.INVOICEDATE))::int,
          (date_part('month'::varchar(5), SIA.INVOICEDATE))::int),  SalesBudgetCustomer AS ( SELECT CA.CUSTOMERGROUPNAME,
        SBMA.YEAR AS BUDGETYEAR,
        SBMA.MONTH AS BUDGETMONTH,
        sum(((SBMA.QTY * SBMA.UNITPRICE) * SBMA.EXCHANGERATE_EUR)) AS BUDGETAMOUNT_EUR,
        sum(((SBMA.QTY * SBMA.UNITPRICE) * SBMA.EXCHANGERATE_USD)) AS BUDGETAMOUNT_USD,
        sum(((SBMA.QTY * SBMA.UNITCOST) * SBMA.COSTEXCHANGERATE_EUR)) AS BUDGETCOSTAMOUNT_EUR,
        sum(((SBMA.QTY * SBMA.UNITCOST) * SBMA.COSTEXCHANGERATE_USD)) AS BUDGETCOSTAMOUNT_USD
 FROM (fersadv.SalesBudgetMonthly_ALL SBMA LEFT  JOIN ( SELECT CT.CUSTOMERGROUPNAME,
        CT.CUSTOMERID,
        CT.COMPANYID
 FROM  CustTable CT
 WHERE (CT.CG_ROWNUM = 1)
 GROUP BY CT.CUSTOMERGROUPNAME,
          CT.CUSTOMERID,
          CT.COMPANYID) CA ON (((SBMA.CUSTOMERID = CA.CUSTOMERID) AND (SBMA.COMPANYID = CA.COMPANYID))))
 GROUP BY CA.CUSTOMERGROUPNAME,
          SBMA.YEAR,
          SBMA.MONTH),  InvoicesBudgetTable AS ( SELECT SIC.CUSTOMERGROUPNAME,
        SIC.CUSTOMERGROUPSECTOR,
        SIC.CUSTOMERGROUPLOB,
        SIC.INVOICEYEAR,
        SIC.INVOICEMONTH,
        SIC.AMOUNT_EUR AS AMOUNTCUSTOMERMONTH_EUR,
        SIC.COSTAMOUNT_EUR AS COSTAMOUNTCUSTOMERMONTH_EUR,
        SBC.BUDGETAMOUNT_EUR AS BUDGETAMOUNTCUSTOMER_EUR,
        SBC.BUDGETCOSTAMOUNT_EUR AS BUDGETCOSTAMOUNTCUSTOMER_EUR,
        sum(SIC.AMOUNT_EUR) OVER (PARTITION BY SIC.INVOICEYEAR, SIC.INVOICEMONTH) AS TOTALAMOUNTMONTH_EUR,
        sum(SIC.COSTAMOUNT_EUR) OVER (PARTITION BY SIC.INVOICEYEAR, SIC.INVOICEMONTH) AS TOTALCOSTAMOUNTMONTH_EUR
 FROM ( SalesInvoicesCustomer SIC LEFT  JOIN  SalesBudgetCustomer SBC ON (((SIC.CUSTOMERGROUPNAME = SBC.CUSTOMERGROUPNAME) AND (SIC.INVOICEYEAR = SBC.BUDGETYEAR) AND (SIC.INVOICEMONTH = SBC.BUDGETMONTH))))
 GROUP BY SIC.CUSTOMERGROUPNAME,
          SIC.CUSTOMERGROUPSECTOR,
          SIC.CUSTOMERGROUPLOB,
          SIC.INVOICEYEAR,
          SIC.INVOICEMONTH,
          SIC.AMOUNT_EUR,
          SIC.COSTAMOUNT_EUR,
          SBC.BUDGETAMOUNT_EUR,
          SBC.BUDGETCOSTAMOUNT_EUR
 ORDER BY SIC.AMOUNT_EUR DESC)
  SELECT IBT.CUSTOMERGROUPNAME,
        IBT.CUSTOMERGROUPSECTOR,
        IBT.CUSTOMERGROUPLOB,
        IBT.INVOICEYEAR AS YEAR,
        IBT.INVOICEMONTH AS MONTHNUM,
        to_char(to_date(concat('1900'::varchar(20), (IBT.INVOICEMONTH)::varchar), 'YYYYMM'::varchar(6)), 'Mon'::varchar(3)) AS MONTH,
        IBT.AMOUNTCUSTOMERMONTH_EUR AS AMOUNT_EUR,
        IBT2.AMOUNTCUSTOMERMONTH_EUR AS AMOUNT_PREVYEAR_EUR,
        sum(IBT.AMOUNTCUSTOMERMONTH_EUR) OVER (PARTITION BY IBT.INVOICEYEAR, IBT.INVOICEMONTH ORDER BY IBT.AMOUNTCUSTOMERMONTH_EUR DESC) AS CUMMAMOUNT_EUR,
        CASE WHEN (IBT.TOTALAMOUNTMONTH_EUR <> 0::numeric(18,0)) THEN (IBT.AMOUNTCUSTOMERMONTH_EUR / IBT.TOTALAMOUNTMONTH_EUR) ELSE NULL::numeric(1,0) END AS PERCENTAGE_EUR,
        CASE WHEN ((IBT.TOTALAMOUNTMONTH_EUR <> 0::numeric(18,0)) AND (IBT.TOTALAMOUNTMONTH_EUR IS NOT NULL)) THEN sum((IBT.AMOUNTCUSTOMERMONTH_EUR / IBT.TOTALAMOUNTMONTH_EUR)) OVER (PARTITION BY IBT.INVOICEYEAR, IBT.INVOICEMONTH ORDER BY IBT.AMOUNTCUSTOMERMONTH_EUR DESC) ELSE NULL::numeric(1,0) END AS CUMMPERCENTAGE_EUR,
        IBT.BUDGETAMOUNTCUSTOMER_EUR AS BUDGET_EUR,
        CASE WHEN (IBT.BUDGETAMOUNTCUSTOMER_EUR <> 0::numeric(18,0)) THEN ((IBT.AMOUNTCUSTOMERMONTH_EUR - IBT.BUDGETAMOUNTCUSTOMER_EUR) / IBT.BUDGETAMOUNTCUSTOMER_EUR) ELSE NULL::numeric(1,0) END AS SALESVSBUDGET_PERC,
        IBT.COSTAMOUNTCUSTOMERMONTH_EUR AS COST_EUR,
        (IBT.AMOUNTCUSTOMERMONTH_EUR - IBT.COSTAMOUNTCUSTOMERMONTH_EUR) AS MARGIN_EUR,
        CASE WHEN (IBT.AMOUNTCUSTOMERMONTH_EUR <> 0::numeric(18,0)) THEN ((IBT.AMOUNTCUSTOMERMONTH_EUR - IBT.COSTAMOUNTCUSTOMERMONTH_EUR) / IBT.AMOUNTCUSTOMERMONTH_EUR) ELSE NULL::numeric(1,0) END AS MARGIN_PERC,
        CASE WHEN (IBT2.AMOUNTCUSTOMERMONTH_EUR <> 0::numeric(18,0)) THEN ((IBT2.AMOUNTCUSTOMERMONTH_EUR - IBT2.COSTAMOUNTCUSTOMERMONTH_EUR) / IBT2.AMOUNTCUSTOMERMONTH_EUR) ELSE NULL::numeric(1,0) END AS MARGIN_PREVYEAR_PERC,
        (IBT.BUDGETAMOUNTCUSTOMER_EUR - IBT.BUDGETCOSTAMOUNTCUSTOMER_EUR) AS BUDGETMARGIN_EUR,
        CASE WHEN (IBT.BUDGETAMOUNTCUSTOMER_EUR <> 0::numeric(18,0)) THEN ((IBT.BUDGETAMOUNTCUSTOMER_EUR - IBT.BUDGETCOSTAMOUNTCUSTOMER_EUR) / IBT.BUDGETAMOUNTCUSTOMER_EUR) ELSE NULL::numeric(1,0) END AS BUDGETMARGIN_PERC,
        CASE WHEN ((IBT.AMOUNTCUSTOMERMONTH_EUR <> 0::numeric(18,0)) AND (IBT.BUDGETAMOUNTCUSTOMER_EUR <> 0::numeric(18,0))) THEN (((IBT.AMOUNTCUSTOMERMONTH_EUR - IBT.COSTAMOUNTCUSTOMERMONTH_EUR) / IBT.AMOUNTCUSTOMERMONTH_EUR) - ((IBT.BUDGETAMOUNTCUSTOMER_EUR - IBT.BUDGETCOSTAMOUNTCUSTOMER_EUR) / IBT.BUDGETAMOUNTCUSTOMER_EUR)) ELSE NULL::numeric(1,0) END AS MARGINDIFREALVSBUDGET_PERC
 FROM ( InvoicesBudgetTable IBT LEFT  JOIN  InvoicesBudgetTable IBT2 ON (((IBT.CUSTOMERGROUPNAME = IBT2.CUSTOMERGROUPNAME) AND (IBT.INVOICEMONTH = IBT2.INVOICEMONTH) AND ((IBT.INVOICEYEAR - 1) = IBT2.INVOICEYEAR))))
 WHERE ((IBT.INVOICEYEAR > ((date_part('year'::varchar(4), ((now())::date)::timestamp))::int - 6)) AND (IBT.AMOUNTCUSTOMERMONTH_EUR IS NOT NULL))
 ORDER BY IBT.INVOICEMONTH;

CREATE  VIEW fersadw.VW_FACT_BOMTREE EXCLUDE SCHEMA PRIVILEGES AS
WITH  BomTree AS ( SELECT FlowProcessTree_ALL.GROUPSUBSIDIARYID AS groupSubsidiaryId,
        FlowProcessTree_ALL.GROUPITEMID AS groupitemid,
        FlowProcessTree_ALL.GROUPLEVEL AS grouplevel,
        FlowProcessTree_ALL.SUBSIDIARYID AS subsidiaryid,
        FlowProcessTree_ALL.BOMREALQTY AS bomrealqty,
        FlowProcessTree_ALL.BOMLEVEL AS bomlevel,
        FlowProcessTree_ALL.BOMITEMID AS bomitemid,
        FlowProcessTree_ALL.SUPPLIERID AS supplierid,
        FlowProcessTree_ALL.UNITPRICE AS unitprice,
        FlowProcessTree_ALL.CURRENCYCODE AS currencycode,
        FlowProcessTree_ALL.CURRENCYCODE_LOCAL AS currencycode_local,
