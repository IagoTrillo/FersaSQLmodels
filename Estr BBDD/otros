        CA.VATNUM,
        CA.CUSTOMERTYPE,
        CA.NAME AS CUSTOMERANAME,
        ((CA.CUSTOMERID || ' - '::varchar(3)) || CA.NAME) AS CUSTOMER,
        CA.SALESMANAGER,
        CA.ADMINMANAGER,
        CA.COMMISSIONGROUP,
        CA.DIVISION,
        CL.SUBSIDIARYGROUP,
        ( SELECT Cont.Name AS NAME
 FROM (fersaParams.Country_standalone Cty JOIN fersaParams.Continent_standalone Cont ON ((Cont.ContinentId = Cty.ContinentId)))
 WHERE (Cty.CountryId = CA.COUNTRY)) AS CONTINENT,
