 FROM fersadw.FlowProcessTree_ALL
 GROUP BY FlowProcessTree_ALL.GROUPSUBSIDIARYID,
          FlowProcessTree_ALL.GROUPITEMID,
          FlowProcessTree_ALL.GROUPLEVEL,
          FlowProcessTree_ALL.SUBSIDIARYID,
          FlowProcessTree_ALL.BOMREALQTY,
          FlowProcessTree_ALL.BOMLEVEL,
          FlowProcessTree_ALL.BOMITEMID,
          FlowProcessTree_ALL.SUPPLIERID,
          FlowProcessTree_ALL.UNITPRICE,
          FlowProcessTree_ALL.CURRENCYCODE,
          FlowProcessTree_ALL.CURRENCYCODE_LOCAL,
          FlowProcessTree_ALL.EXCHANGERATE_EUR,
          FlowProcessTree_ALL.EXCHANGERATE_USD,
          FlowProcessTree_ALL.EXCHANGERATE_LOCAL,
          FlowProcessTree_ALL.UNITID
 ORDER BY FlowProcessTree_ALL.GROUPITEMID,
          FlowProcessTree_ALL.GROUPLEVEL)
  SELECT CL.COMPANYID,
        BomTree.groupSubsidiaryId AS SUBSIDIARYID,
        NULL AS BOMITEMIDORDERTYPE,
