 WHERE ((FR.RECEPTIONDATE >= "timestampadd"('day'::varchar(3), (-7), FR.EXPECTEDRECEPTIONDATE)) AND (FR.RECEPTIONDATE <= "timestampadd"('day'::varchar(3), 7, FR.EXPECTEDRECEPTIONDATE)) AND ((date_part('year'::varchar(4), FR.EXPECTEDRECEPTIONDATE))::int <> 1900) AND (FR.REFERENCE = 'ARRIVAL'::varchar(7)))
 GROUP BY FR.COMPANYID,
