 WHERE ((FR.SHIPDATE >= "timestampadd"('day'::varchar(3), (-14), FR.EXPECTEDSHIPDATE)) AND (FR.SHIPDATE <= "timestampadd"('day'::varchar(3), 14, FR.EXPECTEDSHIPDATE)) AND ((date_part('year'::varchar(4), FR.EXPECTEDSHIPDATE))::int <> 1900) AND ((FR.REFERENCE = 'DISPATCH'::varchar(8)) OR (FR.REFERENCE = 'RETURN'::varchar(6))))
 GROUP BY FR.COMPANYID,
