        SalesBudgetMonthly_ALL.CURRENCYCODE,
        SalesBudgetMonthly_ALL.UNITPRICE,
        SalesBudgetMonthly_ALL.EXCHANGERATE_EUR,
        SalesBudgetMonthly_ALL.EXCHANGERATE_USD,
        ((concat((SalesBudgetMonthly_ALL.YEAR)::varchar, "right"(concat('00'::varchar(2), (SalesBudgetMonthly_ALL.MONTH)::varchar), 2)) || '01'::varchar(2)))::timestamp AS BUDGET_DATE,
        ((concat((SalesBudgetMonthly_ALL.YEAR)::varchar, "right"(concat('00'::varchar(2), (SalesBudgetMonthly_ALL.MONTH)::varchar), 2)) || '01'::varchar(2)))::timestamp AS TRANS_DATE,
        SalesBudgetMonthly_ALL.QTY AS BUDGETQTY,
        ((SalesBudgetMonthly_ALL.QTY * SalesBudgetMonthly_ALL.UNITPRICE))::numeric(32,6) AS BUDGET_AMOUNT,
        (((SalesBudgetMonthly_ALL.QTY * SalesBudgetMonthly_ALL.UNITPRICE) * SalesBudgetMonthly_ALL.EXCHANGERATE_EUR))::numeric(32,6) AS BUDGET_AMOUNT_EUR,
        (((SalesBudgetMonthly_ALL.QTY * SalesBudgetMonthly_ALL.UNITPRICE) * SalesBudgetMonthly_ALL.EXCHANGERATE_USD))::numeric(32,6) AS BUDGET_AMOUNT_USD,
        ((SalesBudgetMonthly_ALL.QTY * SalesBudgetMonthly_ALL.UNITCOST))::numeric(32,6) AS BUDGET_COST,
        (((SalesBudgetMonthly_ALL.QTY * SalesBudgetMonthly_ALL.UNITCOST) * SalesBudgetMonthly_ALL.COSTEXCHANGERATE_EUR))::numeric(32,6) AS BUDGET_COST_EUR,
        (((SalesBudgetMonthly_ALL.QTY * SalesBudgetMonthly_ALL.UNITCOST) * SalesBudgetMonthly_ALL.COSTEXCHANGERATE_USD))::numeric(32,6) AS BUDGET_COST_USD
 FROM fersadv.SalesBudgetMonthly_ALL
 WHERE ((SalesBudgetMonthly_ALL.YEAR >= ((date_part('year'::varchar(4), ((now())::timetz(6))::timestamp))::int - 3)) AND (SalesBudgetMonthly_ALL.QTY > 0::numeric(18,0)));

CREATE  VIEW fersadw.VW_FACT_SALES_AVGPRICES EXCLUDE SCHEMA PRIVILEGES AS
WITH  AverageItem AS (SELECT IT.CATALOG AS Catalog, CT.LINEOFBUSINESS, (sum(SI.INVOICE_AMOUNT_EUR) / sum(SI.INVOICEQTY)) AS ItemAvg_EUR, (sum(SI.INVOICE_AMOUNT_USD) / sum(SI.INVOICEQTY)) AS ItemAvg_USD, (sum(SI.INVOICE_AMOUNT) / sum(SI.INVOICEQTY)) AS ItemAvg_MST, (sum(SI.INVOICE_COST_EUR) / sum(SI.INVOICEQTY)) AS ItemAvgCost_EUR, (sum(SI.INVOICE_COST_USD) / sum(SI.INVOICEQTY)) AS ItemAvgCost_USD, (sum(SI.INVOICE_COST) / sum(SI.INVOICEQTY)) AS ItemAvgCost_MST, (date_part('year'::varchar(4), SI.INVOICEDATE))::int AS Year, SI.SUBSIDIARYID AS SubsidiaryId FROM ((fersadw.VW_FACT_SALES_INVOICES SI JOIN fersadw.VW_CUSTOMERS CT ON (((SI.CUSTOMERID = CT.CUSTOMERID) AND (SI.SUBSIDIARYID = CT.SUBSIDIARYID)))) JOIN fersadw.VW_ITEM IT ON (((SI.ITEMID = IT.ITEMID) AND (SI.SUBSIDIARYID = IT.SUBSIDIARYID)))) WHERE (((IT.ITEMTYPE = 'Product'::varchar(7)) AND (CT.CUSTOMERTYPE = 'EXTERNAL'::varchar(8))) AND (SI.INVOICEQTY > 0)) GROUP BY IT.CATALOG, CT.LINEOFBUSINESS, (date_part('year'::varchar(4), SI.INVOICEDATE))::int, SI.SUBSIDIARYID),  AverageCustomerItem AS (SELECT SI.CUSTOMERID AS CustomerId, SI.ITEMID, IT.CATALOG AS Catalog, CT.LINEOFBUSINESS, (sum(SI.INVOICE_AMOUNT_EUR) / sum(SI.INVOICEQTY)) AS CustomerAvg_EUR, (sum(SI.INVOICE_AMOUNT_USD) / sum(SI.INVOICEQTY)) AS CustomerAvg_USD, (sum(SI.INVOICE_AMOUNT) / sum(SI.INVOICEQTY)) AS CustomerAvg_MST, (sum(SI.INVOICE_COST_EUR) / sum(SI.INVOICEQTY)) AS CustomerAvgCost_EUR, (sum(SI.INVOICE_COST_USD) / sum(SI.INVOICEQTY)) AS CustomerAvgCost_USD, (sum(SI.INVOICE_COST) / sum(SI.INVOICEQTY)) AS CustomerAvgCost_MST, (date_part('year'::varchar(4), SI.INVOICEDATE))::int AS Year, CT.CONTINENT AS Continent, SI.SUBSIDIARYID AS SubsidiaryId, SI.COMPANYID AS CompanyId FROM ((fersadw.VW_FACT_SALES_INVOICES SI JOIN fersadw.VW_CUSTOMERS CT ON (((SI.CUSTOMERID = CT.CUSTOMERID) AND (SI.SUBSIDIARYID = CT.SUBSIDIARYID)))) JOIN fersadw.VW_ITEM IT ON (((SI.ITEMID = IT.ITEMID) AND (SI.SUBSIDIARYID = IT.SUBSIDIARYID)))) WHERE (((IT.ITEMTYPE = 'Product'::varchar(7)) AND (CT.CUSTOMERTYPE = 'EXTERNAL'::varchar(8))) AND (SI.INVOICEQTY > 0)) GROUP BY SI.CUSTOMERID, SI.ITEMID, IT.CATALOG, CT.LINEOFBUSINESS, (date_part('year'::varchar(4), SI.INVOICEDATE))::int, CT.CONTINENT, SI.SUBSIDIARYID, SI.COMPANYID),  AverageItemContinent AS (SELECT IT.CATALOG AS Catalog, CT.LINEOFBUSINESS, CT.CONTINENT AS Continent, (sum(SI.INVOICE_AMOUNT_EUR) / sum(SI.INVOICEQTY)) AS ContinentAvg_EUR, (sum(SI.INVOICE_AMOUNT_USD) / sum(SI.INVOICEQTY)) AS ContinentAvg_USD, (sum(SI.INVOICE_AMOUNT) / sum(SI.INVOICEQTY)) AS ContinentAvg_MST, (sum(SI.INVOICE_COST_EUR) / sum(SI.INVOICEQTY)) AS ContinentAvgCost_EUR, (sum(SI.INVOICE_COST_USD) / sum(SI.INVOICEQTY)) AS ContinentAvgCost_USD, (sum(SI.INVOICE_COST) / sum(SI.INVOICEQTY)) AS ContinentAvgCost_MST, (date_part('year'::varchar(4), SI.INVOICEDATE))::int AS Year, SI.SUBSIDIARYID AS SubsidiaryId FROM ((fersadw.VW_FACT_SALES_INVOICES SI JOIN fersadw.VW_CUSTOMERS CT ON (((SI.CUSTOMERID = CT.CUSTOMERID) AND (SI.SUBSIDIARYID = CT.SUBSIDIARYID)))) JOIN fersadw.VW_ITEM IT ON (((SI.ITEMID = IT.ITEMID) AND (SI.SUBSIDIARYID = IT.SUBSIDIARYID)))) WHERE (((IT.ITEMTYPE = 'Product'::varchar(7)) AND (CT.CUSTOMERTYPE = 'EXTERNAL'::varchar(8))) AND (SI.INVOICEQTY > 0)) GROUP BY IT.CATALOG, CT.LINEOFBUSINESS, (date_part('year'::varchar(4), SI.INVOICEDATE))::int, CT.CONTINENT, SI.SUBSIDIARYID) SELECT AverageCustomerItem.CustomerId, hash(AverageCustomerItem.CompanyId, AverageCustomerItem.SubsidiaryId, AverageCustomerItem.CustomerId) AS ID_Customer, AverageCustomerItem.ITEMID AS ItemId, AverageCustomerItem.Year, (AverageCustomerItem.CustomerAvg_EUR)::numeric(18,2) AS CustomerAvg_EUR, (AverageCustomerItem.CustomerAvg_USD)::numeric(18,2) AS CustomerAvg_USD, (AverageCustomerItem.CustomerAvg_MST)::numeric(18,2) AS CustomerAvg_MST, (AverageItem.ItemAvg_EUR)::numeric(18,2) AS ItemAvg_EUR, (AverageItem.ItemAvg_USD)::numeric(18,2) AS ItemAvg_USD, (AverageItem.ItemAvg_MST)::numeric(18,2) AS ItemAvg_MST, (AverageItemContinent.ContinentAvg_EUR)::numeric(18,2) AS ContinentAvg_EUR, (AverageItemContinent.ContinentAvg_USD)::numeric(18,2) AS ContinentAvg_USD, (AverageItemContinent.ContinentAvg_MST)::numeric(18,2) AS ContinentAvg_MST, (AverageItem.ItemAvgCost_EUR)::numeric(18,2) AS ItemAvgCost_EUR, (AverageItem.ItemAvgCost_USD)::numeric(18,2) AS ItemAvgCost_USD, (AverageItem.ItemAvgCost_MST)::numeric(18,2) AS ItemAvgCost_MST, (AverageCustomerItem.CustomerAvgCost_EUR)::numeric(18,2) AS CustomerAvgCost_EUR, (AverageCustomerItem.CustomerAvgCost_USD)::numeric(18,2) AS CustomerAvgCost_USD, (AverageCustomerItem.CustomerAvgCost_MST)::numeric(18,2) AS CustomerAvgCost_MST, (AverageItemContinent.ContinentAvgCost_EUR)::numeric(18,2) AS ContinentAvgCost_EUR, (AverageItemContinent.ContinentAvgCost_USD)::numeric(18,2) AS ContinentAvgCost_USD, (AverageItemContinent.ContinentAvgCost_MST)::numeric(18,2) AS ContinentAvgCost_MST, AverageCustomerItem.SubsidiaryId, AverageCustomerItem.CompanyId FROM (( AverageCustomerItem JOIN  AverageItem ON (((AverageCustomerItem.Catalog = AverageItem.Catalog) AND (AverageItem.Year = AverageCustomerItem.Year) AND (AverageItem.LINEOFBUSINESS = AverageCustomerItem.LINEOFBUSINESS) AND (AverageItem.SubsidiaryId = AverageCustomerItem.SubsidiaryId)))) JOIN  AverageItemContinent ON (((AverageItemContinent.Catalog = AverageCustomerItem.Catalog) AND (AverageItemContinent.Year = AverageCustomerItem.Year) AND (AverageItemContinent.LINEOFBUSINESS = AverageCustomerItem.LINEOFBUSINESS) AND (AverageItemContinent.SubsidiaryId = AverageCustomerItem.SubsidiaryId) AND (AverageItemContinent.Continent = AverageCustomerItem.Continent))));

