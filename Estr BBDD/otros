CREATE  VIEW fersadw.VW_PURCH_FILLRATE_QLIK EXCLUDE SCHEMA PRIVILEGES AS
 SELECT PurchasingFillRate_SP.PURCHASEID,
        avg(PurchasingFillRate_SP.PURCHASEQTY) AS PURCHASEQTY,
        CASE WHEN (PurchasingFillRate_SP.REFERENCE = 'ARRIVAL'::varchar(7)) THEN PurchasingFillRate_SP.EXPECTEDRECEPTIONDATE ELSE PurchasingFillRate_SP.EXPECTEDSHIPDATE END AS EXPECTEDDATE,
        PurchasingFillRate_SP.INVENTTRANSID,
        CASE WHEN (PurchasingFillRate_SP.REFERENCE = 'ARRIVAL'::varchar(7)) THEN sum(PurchasingFillRate_SP.ONTIMEDELIVEREDQTY_FORNT) ELSE sum(PurchasingFillRate_SP.ONTIMESHIPPEDQTY_FORNT) END AS ONTIMEQTY,
        PurchasingFillRate_SP.REFERENCE,
        PurchasingFillRate_SP.SUBSIDIARYID,
        PurchasingFillRate_SP.COMPANYID
 FROM fersadw.VW_PURCH_FILLRATE PurchasingFillRate_SP
 WHERE (PurchasingFillRate_SP.REFERENCE <> 'RETURN'::varchar(6))
 GROUP BY PurchasingFillRate_SP.PURCHASEID,
          PurchasingFillRate_SP.INVENTTRANSID,
          PurchasingFillRate_SP.REFERENCE,
          PurchasingFillRate_SP.SUBSIDIARYID,
          PurchasingFillRate_SP.COMPANYID,
          PurchasingFillRate_SP.EXPECTEDRECEPTIONDATE,
          PurchasingFillRate_SP.EXPECTEDSHIPDATE;

CREATE  VIEW fersadw.VW_PURCH_FILLRATE EXCLUDE SCHEMA PRIVILEGES AS
 SELECT FR.COMPANYID,
        FR.SUBSIDIARYID,
        FR.PURCHASEID,
        FR.INVENTTRANSID,
        FR.SUPPLIERID,
        FR.ITEMID,
        FR.EXPECTEDRECEPTIONDATE,
        FR.EXPECTEDSHIPDATE,
        FR.PURCHASEQTY,
        FR.PURCHASEAMOUNT,
        coalesce(ONTIME_DEL.ONTIMEDELIVEREDQTY, 0::numeric(18,0)) AS ONTIMEDELIVEREDQTY_FORNT,
        coalesce(ONTIME_DEL.ONTIMEDELIVEREDAMOUNT, 0::numeric(18,0)) AS ONTIMEDELIVEREDAMOUNT_FORNT,
        coalesce(ONTIME_SHIP.ONTIMESHIPPEDQTY, 0::numeric(18,0)) AS ONTIMESHIPPEDQTY_FORNT,
        coalesce(ONTIME_SHIP.ONTIMESHIPPEDAMOUNT, 0::numeric(18,0)) AS ONTIMESHIPPEDAMOUNT_FORNT,
        coalesce(ONTIME_DEL_WEEK.ONTIMEDELIVEREDQTY, 0::numeric(18,0)) AS ONTIMEDELIVEREDQTY_WEEK,
        coalesce(ONTIME_DEL_WEEK.ONTIMEDELIVEREDAMOUNT, 0::numeric(18,0)) AS ONTIMEDELIVEREDAMOUNT_WEEK,
        coalesce(ONTIME_SHIP_WEEK.ONTIMESHIPPEDQTY, 0::numeric(18,0)) AS ONTIMESHIPPEDQTY_WEEK,
        FR.ISINTERCO,
        FR.REFERENCE
 FROM ((((fersadw.PurchasingFillRate_SP FR LEFT  JOIN ( SELECT FR.COMPANYID,
        FR.SUBSIDIARYID,
        FR.PURCHASEID,
        FR.INVENTTRANSID,
        FR.SUPPLIERID,
        FR.ITEMID,
        FR.EXPECTEDRECEPTIONDATE,
        FR.EXPECTEDSHIPDATE,
        sum(FR.RECEIVEDQTY) AS ONTIMEDELIVEREDQTY,
        sum(FR.RECEIVEDAMOUNT) AS ONTIMEDELIVEREDAMOUNT
 FROM fersadw.PurchasingFillRate_SP FR
 WHERE ((FR.RECEPTIONDATE >= "timestampadd"('day'::varchar(3), (-14), FR.EXPECTEDRECEPTIONDATE)) AND (FR.RECEPTIONDATE <= "timestampadd"('day'::varchar(3), 14, FR.EXPECTEDRECEPTIONDATE)) AND ((date_part('year'::varchar(4), FR.EXPECTEDRECEPTIONDATE))::int <> 1900) AND ((FR.REFERENCE = 'ARRIVAL'::varchar(7)) OR (FR.REFERENCE = 'RETURN'::varchar(6))))
 GROUP BY FR.COMPANYID,
          FR.SUBSIDIARYID,
          FR.PURCHASEID,
          FR.INVENTTRANSID,
          FR.SUPPLIERID,
          FR.ITEMID,
          FR.EXPECTEDRECEPTIONDATE,
