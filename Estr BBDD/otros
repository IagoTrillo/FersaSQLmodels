 FROM fersaParams.Country_standalone Cty
 WHERE (Cty.CountryId = CA.COUNTRY)) AS COUNTRYNAME
 FROM ((fersadv.Customer_ALL CA JOIN fersaParams.CompanyLocation_standalone CL ON ((CA.SUBSIDIARYID = CL.LOCATIONID))) LEFT  JOIN fersadw.Customer_FACT CDS ON (((CA.SUBSIDIARYID = CDS.SUBSIDIARYID) AND (CA.CUSTOMERID = CDS.CUSTOMERID))));

