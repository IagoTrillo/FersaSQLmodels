CREATE  VIEW fersadw.vw_global_stock_pbi EXCLUDE SCHEMA PRIVILEGES AS
WITH  INVENTSUM AS ( SELECT INVENT.INVENTLOCATIONID,
        INVENT.INVENTBATCHID,
        INVENT.INVENTSTATUSID,
        INVENT.UNITCOST,
        CASE WHEN (WAREHOUSE.INVENTLOCATIONTYPE IS NOT NULL) THEN WAREHOUSE.INVENTLOCATIONTYPE WHEN ((WAREHOUSE.INVENTLOCATIONTYPE IS NULL) AND (INVENT.INVENTLOCATIONID = INVENT.SUBSIDIARYID)) THEN 'ONSITE'::varchar(6) WHEN ((WAREHOUSE.INVENTLOCATIONTYPE IS NULL) AND (substr(INVENT.INVENTLOCATIONID, 1, 2) = 'T_'::varchar(2))) THEN 'TRANSIT'::varchar(7) ELSE NULL END AS INVENTLOCATIONTYPE,
        WAREHOUSE.INVENTVENDORACCOUNT,
        supplier.SUPPLIERTYPE,
        INVENT.PHYSICALINVENT AS PhysicalInvent,
        INVENT.EXCHANGERATE_EUR,
        INVENT.EXCHANGERATE_USD,
        INVENT.RESERVPHYSICAL AS ReservPhysical,
        INVENT.PICKED,
        INVENT.ITEMID,
        INVENT.SUBSIDIARYID
 FROM ((fersadw.InventSum_FACT INVENT LEFT  JOIN ( SELECT WarehouseLocation_FACT.INVENTLOCATIONID,
        WarehouseLocation_FACT.INVENTLOCATIONTYPE,
        WarehouseLocation_FACT.SUBSIDIARYID,
        WarehouseLocation_FACT.INVENTVENDORACCOUNT
 FROM fersadw.WarehouseLocation_FACT
 GROUP BY WarehouseLocation_FACT.INVENTLOCATIONID,
          WarehouseLocation_FACT.INVENTLOCATIONTYPE,
          WarehouseLocation_FACT.SUBSIDIARYID,
          WarehouseLocation_FACT.INVENTVENDORACCOUNT) WAREHOUSE ON (((INVENT.INVENTLOCATIONID = WAREHOUSE.INVENTLOCATIONID) AND (INVENT.SUBSIDIARYID = WAREHOUSE.SUBSIDIARYID)))) LEFT  JOIN ( SELECT Supplier_FACT.SUBSIDIARYID,
        Supplier_FACT.SUPPLIERID,
        Supplier_FACT.SUPPLIERTYPE
 FROM fersadw.Supplier_FACT
 GROUP BY Supplier_FACT.SUBSIDIARYID,
          Supplier_FACT.SUPPLIERID,
          Supplier_FACT.SUPPLIERTYPE) supplier ON ((((supplier.SUBSIDIARYID = WAREHOUSE.SUBSIDIARYID) AND (supplier.SUPPLIERID = WAREHOUSE.INVENTVENDORACCOUNT)) AND (WAREHOUSE.INVENTVENDORACCOUNT IS NOT NULL)))))
  SELECT ITEM.ITEMID,
        ITEM.CATALOG,
        ITEM.BRAND,
        ITEM.SUBSIDIARYID,
        ITEM.COMPANYID,
        ITEM.BEARINGTYPE,
        ITEM.BEARINGSUBTYPE,
        ITEM.FAMILYNAME,
        ITEM.SBU,
        sum(SUM.ReservPhysical) AS ReservPhysical,
        sum(SUM.PICKED) AS PICKED,
        SUM.INVENTLOCATIONID,
        SUM.SUPPLIERTYPE,
        SUM.UNITCOST,
        SUM.INVENTBATCHID,
        SUM.INVENTLOCATIONTYPE,
        SUM.INVENTSTATUSID,
        sum(SUM.PhysicalInvent) AS PhysicalInvent,
        SUM.EXCHANGERATE_EUR,
        SUM.EXCHANGERATE_USD
 FROM (fersadw.Item_FACT ITEM LEFT  JOIN  INVENTSUM SUM ON (((ITEM.ITEMID = SUM.ITEMID) AND (ITEM.SUBSIDIARYID = SUM.SUBSIDIARYID))))
 GROUP BY ITEM.ITEMID,
          ITEM.CATALOG,
          ITEM.BRAND,
          ITEM.SUBSIDIARYID,
          ITEM.COMPANYID,
          ITEM.BEARINGTYPE,
          ITEM.BEARINGSUBTYPE,
          ITEM.FAMILYNAME,
          ITEM.SBU,
          SUM.INVENTLOCATIONID,
          SUM.SUPPLIERTYPE,
          SUM.UNITCOST,
          SUM.INVENTBATCHID,
          SUM.INVENTLOCATIONTYPE,
          SUM.INVENTSTATUSID,
          SUM.EXCHANGERATE_EUR,
          SUM.EXCHANGERATE_USD;

