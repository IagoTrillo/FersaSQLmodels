        md.ITEMIDTO,
        md.FLAG,
        md.GROUPITEM,
        md.FLAGITEM,
        md.PRIORITY,
        count(*) AS ROWS,
        sum(md.QTY) AS QTY,
        max(md.CREATEDAT) AS LAST_CREATEDAT
 FROM ((fersaSS.Movement_Demand md LEFT  JOIN fersadv.Item_ALL ia_from ON ((hash(ia_from.SUBSIDIARYID, ia_from.ITEMID) = hash(md.SUBSIDIARYID, md.ITEMIDFROM)))) LEFT  JOIN fersadv.Item_ALL ia_to ON ((hash(ia_to.ITEMID) = hash(md.ITEMIDTO))))
 WHERE ((ia_from.ITEMID IS NULL) OR (ia_to.ITEMID IS NULL))
 GROUP BY md.SCENARIO,
          md.DEMAND_SOURCE,
          md.SUBSIDIARYID,
          md.INVENTLOCATIONID,
          md.ITEMIDFROM,
          md.ITEMIDTO,
          md.FLAG,
          md.GROUPITEM,
          md.FLAGITEM,
          md.PRIORITY;

CREATE  VIEW fersaSS.vw_Demand_Consumption2Y_MovDB EXCLUDE SCHEMA PRIVILEGES AS
WITH  SUBSIDIARY AS ( SELECT upper(IT.DATAAREAID) AS SUBSIDIARYID
 FROM (fersads.ds_InventTrans_FER IT LEFT  JOIN fersaParams.CompanyLocation_standalone cls ON ((cls.LOCATIONID = upper(IT.DATAAREAID))))
 WHERE (cls.COMPANYID <> 'PFI'::varchar(3))
 GROUP BY upper(IT.DATAAREAID) UNION  SELECT upper(ds_InventTrans_CHN_HIST.DATAAREAID) AS SUBSIDIARYID
 FROM fersads.ds_InventTrans_CHN_HIST
 GROUP BY upper(ds_InventTrans_CHN_HIST.DATAAREAID)),  TRANSACTIONS AS (( SELECT upper(IT.DATAAREAID) AS SUBSIDIARYID,
        IT.ITEMID,
        sum(IT.QTY) AS QTY
 FROM ((((fersads.ds_InventTransOrigin_FER IO JOIN fersads.ds_InventTrans_FER IT ON (((IO.RECID = IT.INVENTTRANSORIGIN) AND (IO.DATAAREAID = IT.DATAAREAID)))) JOIN fersads.ds_InventDim_FER ID ON (((IT.INVENTDIMID = ID.INVENTDIMID) AND (IT.DATAAREAID = ID.DATAAREAID)))) JOIN ( SELECT sl.INVENTTRANSID
 FROM (fersadv.SalesLines_ALL sl JOIN fersadv.Customer_ALL ca ON ((hash(sl.SUBSIDIARYID, sl.CUSTOMERID) = hash(ca.SUBSIDIARYID, ca.CUSTOMERID))))
 WHERE (ca.CUSTOMERTYPE <> 'INTERNAL'::varchar(8))) C ON ((C.INVENTTRANSID = IO.INVENTTRANSID))) JOIN  SUBSIDIARY SUB ON ((hash(SUB.SUBSIDIARYID) = hash(upper(IT.DATAAREAID)))))
 WHERE ((((IT.STATUSISSUE = 1) OR (IT.STATUSISSUE = 2)) AND (IO.REFERENCECATEGORY = 0)) AND (IT.DATEPHYSICAL > ((now())::date - (365 * 2))))
 GROUP BY upper(IT.DATAAREAID),
          IT.ITEMID UNION ALL  SELECT upper(IT.DATAAREAID) AS SUBSIDIARYID,
        IT.ITEMID,
        sum(IT.QTY) AS QTY
 FROM ((((fersads.ds_InventTransOrigin_CHN_HIST IO JOIN fersads.ds_InventTrans_CHN_HIST IT ON (((IO.RECID = IT.INVENTTRANSORIGIN) AND (IO.DATAAREAID = IT.DATAAREAID)))) JOIN fersads.ds_InventDim_CHN_HIST ID ON (((IT.INVENTDIMID = ID.INVENTDIMID) AND (IT.DATAAREAID = ID.DATAAREAID)))) JOIN ( SELECT sl.INVENTTRANSID
 FROM (fersadv.SalesLines_ALL sl JOIN fersadv.Customer_ALL ca ON ((hash(sl.SUBSIDIARYID, sl.CUSTOMERID) = hash(ca.SUBSIDIARYID, ca.CUSTOMERID))))
 WHERE (ca.CUSTOMERTYPE <> 'INTERNAL'::varchar(8))) C ON ((C.INVENTTRANSID = IO.INVENTTRANSID))) JOIN  SUBSIDIARY SUB ON ((hash(SUB.SUBSIDIARYID) = hash(upper(IT.DATAAREAID)))))
 WHERE ((((IT.STATUSISSUE = 1) OR (IT.STATUSISSUE = 2)) AND (IO.REFERENCECATEGORY = 0)) AND (IT.DATEPHYSICAL > ((now())::date - (365 * 2))))
 GROUP BY upper(IT.DATAAREAID),
          IT.ITEMID) UNION ALL  SELECT sia.SUBSIDIARYID,
        sia.ITEMID,
        (- sum(sia.INVOICEQTY)) AS QTY
 FROM (fersadv.SalesInvoices_ALL sia JOIN ( SELECT Customer_ALL.SUBSIDIARYID,
        Customer_ALL.CUSTOMERID
 FROM fersadv.Customer_ALL
 WHERE (Customer_ALL.CUSTOMERTYPE <> 'INTERNAL'::varchar(8))
 GROUP BY Customer_ALL.SUBSIDIARYID,
          Customer_ALL.CUSTOMERID) C ON ((hash(C.SUBSIDIARYID, C.CUSTOMERID) = hash(sia.SUBSIDIARYID, sia.CUSTOMERID))))
 WHERE ((sia.INVOICEDATE > ((now())::date - (365 * 2))) AND (sia.SUBSIDIARYID NOT IN ( SELECT SUBSIDIARY.SUBSIDIARYID
 FROM  SUBSIDIARY)))
 GROUP BY sia.SUBSIDIARYID,
          sia.ITEMID),  LAST2YEARS AS ( SELECT TRANSACTIONS.SUBSIDIARYID,
        TRANSACTIONS.ITEMID,
        (- sum(TRANSACTIONS.QTY)) AS CONSUMQTY
 FROM  TRANSACTIONS
 GROUP BY TRANSACTIONS.SUBSIDIARYID,
          TRANSACTIONS.ITEMID
 HAVING (sum(TRANSACTIONS.QTY) < 0)),  NEGATIVE AS ( SELECT CASE WHEN (F.FLAG ~~ 'DAILY%'::varchar(6)) THEN 'DAILY'::varchar(5) ELSE F.FLAG END AS FLAG,
        LY.SUBSIDIARYID,
        LY.ITEMID AS ITEMIDTO,
        LY.CONSUMQTY AS QTY
 FROM ( LAST2YEARS LY CROSS  JOIN ( SELECT ObsoleteBeat_ALL.FLAG
 FROM fersadv.ObsoleteBeat_ALL
 GROUP BY ObsoleteBeat_ALL.FLAG) F)
 WHERE (LY.CONSUMQTY > 0))
  SELECT N.FLAG,
        coalesce(MAP.GROUPITEM, (hash(N.ITEMIDTO))::varchar(200)) AS GROUPITEM,
        N.SUBSIDIARYID,
        (coalesce(MAP.ITEMIDFROM, N.ITEMIDTO))::varchar(50) AS ITEMIDFROM,
        (N.ITEMIDTO)::varchar(50) AS ITEMIDTO,
        N.QTY,
        coalesce(MAP.FLAGITEM, 'EQUALREF'::varchar(8)) AS FLAGITEM,
        coalesce(MAP.PRIORITY, 0) AS PRIORITY
 FROM ( NEGATIVE N LEFT  JOIN fersaSS.vw_Movement_ItemMapping MAP ON ((hash(MAP.ITEMIDTO) = hash(N.ITEMIDTO))))
 WHERE (N.QTY > 0::numeric(18,0));

CREATE FUNCTION public.isOrContains(map Long Varchar, val Varchar)
RETURN boolean AS
BEGIN
RETURN CASE WHEN (public.MapSize(map) <> (-1)) THEN public.MapContainsValue(map, val) ELSE (map = (val)) END;
END;

