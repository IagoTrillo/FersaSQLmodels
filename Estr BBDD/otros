CREATE  VIEW fersadw.VW_StockProjection_BOpBI EXCLUDE SCHEMA PRIVILEGES AS
 SELECT CL.COMPANYID,
        SPA.SUBSIDIARYID,
        SPA.ITEMID,
        SPA.REFTYPE,
        SPA.INVENTLOCATIONID,
        CASE WHEN (SPA.REFTYPE = 1) THEN date((now())::date) ELSE SPA.FUTURESDATE END AS FUTURESDATE,
        CASE WHEN (SPA.REFTYPE = 1) THEN sum(SPA.QTY) ELSE 0::numeric(18,0) END AS QTY_ONHAND,
        CASE WHEN (SPA.REFTYPE = 17) THEN sum(SPA.QTY) ELSE 0::numeric(18,0) END AS QTY_ONTRANSIT,
        CASE WHEN (SPA.REFTYPE = 1) THEN sum((SPA.QTY * SPA.UNITCOST)) ELSE 0::numeric(18,0) END AS AMOUNT_ONHAND,
        CASE WHEN (SPA.REFTYPE = 17) THEN sum((SPA.QTY * SPA.UNITCOST)) ELSE 0::numeric(18,0) END AS AMOUNT_ONTRANSIT,
        CASE WHEN (SPA.REFTYPE = 1) THEN sum((SPA.QTY * SPA.UNITCOST_EUR)) ELSE 0::numeric(18,0) END AS AMOUNT_EUR_ONHAND,
        CASE WHEN (SPA.REFTYPE = 17) THEN sum((SPA.QTY * SPA.UNITCOST_EUR)) ELSE 0::numeric(18,0) END AS AMOUNT_EUR_ONTRANSIT,
        CASE WHEN (SPA.REFTYPE = 1) THEN sum((SPA.QTY * SPA.UNITCOST_USD)) ELSE 0::numeric(18,0) END AS AMOUNT_USD_ONHAND,
        CASE WHEN (SPA.REFTYPE = 17) THEN sum((SPA.QTY * SPA.UNITCOST_USD)) ELSE 0::numeric(18,0) END AS AMOUNT_USD_ONTRANSIT
 FROM ((fersadv.Stock_Projection_ALL SPA JOIN fersaParams.CompanyLocation_standalone CL ON ((SPA.SUBSIDIARYID = CL.LOCATIONID))) JOIN fersads.ds_EnumValues_FER EVF ON (((SPA.REFTYPE = EVF.ENUMITEMVALUE) AND (EVF.ENUMNAME = 'ReqRefType'::varchar(10)))))
 WHERE ((SPA.REFTYPE = 1) OR (SPA.REFTYPE = 17))
 GROUP BY CL.COMPANYID,
          SPA.SUBSIDIARYID,
          SPA.ITEMID,
          SPA.REFTYPE,
          SPA.INVENTLOCATIONID,
          SPA.FUTURESDATE,
          SPA.CURRENCYCODE;

